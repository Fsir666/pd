/** app.wxss **/
page {
  --primary-color: #FF6B00;
  --secondary-color: #4CAF50;
  --bg-color: #F8F9FA;
  --text-main: #333333;
  --text-sub: #999999;
  --card-bg: #FFFFFF;

  /* 悠米设计体系 · 奶油手作 S1 —— 全站逐步接入 */
  --ym-bg: #FBF7F2;
  --ym-bg-sunk: #F5EDE6;
  --ym-surface: #FFFDFB;
  --ym-surface-pure: #FFFFFF;
  --ym-primary: #D4607A;
  --ym-primary-deep: #A8455C;
  --ym-primary-wash: #F6E9E4;
  --ym-mint: #7A9E7E;
  --ym-mint-wash: #E9F0E8;
  --ym-mint-deep: #4C6B4E;
  --ym-honey: #D89A5C;
  --ym-honey-wash: #F7EEDF;
  --ym-text: #4A3A3E;
  --ym-text-sub: #9B8A8C;
  --ym-text-faint: #C2B4B4;
  --ym-line: #F0E4DC;
  --ym-line-strong: #E4D5CB;
  --ym-r-xl: 32rpx;
  --ym-r-lg: 26rpx;
  --ym-r-md: 20rpx;
  --ym-r-sm: 12rpx;
  --ym-shadow: 0 6rpx 20rpx rgba(176, 138, 128, 0.10);
  --ym-shadow-lift: 0 10rpx 30rpx rgba(176, 138, 128, 0.16);

  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  box-sizing: border-box;

  /* 页面进入淡入：让 tab 切换 / 二级页跳转更丝滑，不再硬切白闪（纯透明度，不影响 fixed 浮层） */
  animation: pageEnter 0.3s ease both;
}

@keyframes pageEnter {
  from { opacity: 0; }
  to { opacity: 1; }
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.card {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.text-truncate {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
