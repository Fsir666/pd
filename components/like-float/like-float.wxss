.particle-layer {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9998;
  pointer-events: none;
  overflow: hidden;
}

.particle {
  position: absolute;
  font-size: 48rpx;
  animation: gravity var(--duration, 1s) ease-out forwards;
  pointer-events: none;
  will-change: transform, opacity;
}

/* 软萌飘心：冒出来 → 缓缓往上飘 → 慢慢淡出（不再像石头一样砸下去） */
@keyframes gravity {
  0% {
    transform: translate(0, 0) scale(0.4) rotate(0deg);
    opacity: 0;
  }
  14% {
    transform: translate(calc(var(--tx, 0) * 0.18), calc(var(--ty, -180rpx) * 0.2)) scale(1.18) rotate(calc(var(--rot) * 0.4));
    opacity: 1;
  }
  55% {
    transform: translate(calc(var(--tx, 0) * 0.68), calc(var(--ty, -180rpx) * 0.72)) scale(1.02) rotate(var(--rot));
    opacity: 1;
  }
  100% {
    transform: translate(var(--tx, 0), var(--ty, -180rpx)) scale(0.82) rotate(calc(var(--rot) * 1.15));
    opacity: 0;
  }
}

.like-btn {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 18rpx 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.62);
  box-shadow: 0 14rpx 40rpx rgba(0, 0, 0, 0.10);
  transform: translateZ(0);
}

.like-btn:active {
  transform: translateZ(0) scale(0.96);
}

.like-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.like-icon {
  font-size: 30rpx;
  line-height: 1;
}

.like-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.4px;
}

.like-count-badge {
  margin-left: 14rpx;
  padding: 0 12rpx;
  height: 46rpx;
  min-width: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 0, 0.28);
  letter-spacing: -0.4px;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

.like-count-badge.bump {
  animation: bump 260ms cubic-bezier(0.2, 0.9, 0.2, 1);
}

@keyframes bump {
  0% { transform: scale(1); }
  40% { transform: scale(1.15); }
  100% { transform: scale(1); }
}
