.intro-container {
  min-height: 100vh;
  background-color: #F2F4F8;
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
}

/* 顶部 Header */
.intro-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
}

.icon-bg {
  width: 160rpx;
  height: 160rpx;
  background: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 40rpx rgba(84, 160, 255, 0.15);
  margin-bottom: 30rpx;
}

.header-icon {
  font-size: 80rpx;
}

.app-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #333;
  margin-bottom: 10rpx;
}

.app-subtitle {
  font-size: 28rpx;
  color: #888;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* 功能列表 */
.feature-list {
  flex: 1;
  padding: 0 40rpx;
}

.glass-card {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.05);
  border-radius: 32rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.feature-icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.feature-icon {
  font-size: 48rpx;
}

.feature-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feature-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* 底部按钮 */
.bottom-action {
  padding: 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.enter-btn {
  background: linear-gradient(135deg, #54A0FF, #2E86DE);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  padding: 0;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(84, 160, 255, 0.3);
  transition: all 0.3s;
}

.enter-btn:active {
  transform: scale(0.98);
  box-shadow: 0 5rpx 15rpx rgba(84, 160, 255, 0.2);
}

.testpay-btn {
  background: rgba(255, 255, 255, 0.8);
  color: #2E86DE;
  font-size: 32rpx;
  font-weight: 600;
  padding: 0;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  border: 1px solid rgba(46, 134, 222, 0.25);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
}

.testpay-btn:active {
  transform: scale(0.98);
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.04);
}
