.page-root {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
  background: #F3F0EA;
}

.paper-bg {
  position: fixed;
  inset: 0;
  background: radial-gradient(920rpx 640rpx at 18% 10%, rgba(255, 210, 140, 0.35), transparent 56%),
    radial-gradient(820rpx 560rpx at 86% 18%, rgba(130, 210, 255, 0.28), transparent 58%),
    radial-gradient(980rpx 760rpx at 55% 95%, rgba(255, 160, 190, 0.18), transparent 62%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(243, 240, 234, 0.92));
  filter: saturate(115%);
  z-index: 0;
}

.glass-card {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.05);
}

.header {
  padding: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.header-title {
  font-size: 34rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
}

.header-sub {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(29, 29, 31, 0.56);
}

.header-right {
  display: flex;
  gap: 10rpx;
  flex: none;
}

.stat-pill {
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 20, 0.06);
  display: flex;
  gap: 8rpx;
  align-items: baseline;
}

.stat-label {
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.6);
}

.stat-value {
  font-size: 24rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.9);
}

.brand-scroll {
  margin-top: 16rpx;
}

.brand-row {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 2rpx;
}

.brand-chip {
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(0, 0, 0, 0.06);
  color: rgba(29, 29, 31, 0.7);
  font-size: 24rpx;
  font-weight: 900;
  white-space: nowrap;
}

.brand-chip.active {
  background: rgba(255, 106, 0, 0.14);
  border-color: rgba(255, 106, 0, 0.18);
  color: #FF6A00;
}

.tabs {
  margin-top: 16rpx;
  padding: 12rpx;
  display: flex;
  justify-content: center;
}

.controls {
  margin-top: 16rpx;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.controls-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.seg {
  display: flex;
  border-radius: 999rpx;
  background: rgba(17, 17, 20, 0.06);
  padding: 6rpx;
  gap: 6rpx;
  flex: none;
}

.seg-item {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.72);
}

.seg-item.active {
  background: rgba(255, 255, 255, 0.86);
  color: rgba(29, 29, 31, 0.92);
}



.search-wrap {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: rgba(17, 17, 20, 0.05);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  gap: 12rpx;
  transition: all 0.2s ease;
}

.search-wrap:active {
  background: rgba(17, 17, 20, 0.08);
}

.sheet.action-sheet {
  padding: 0;
  background: #fff;
}

.sheet-header {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
}

.sheet-close {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.3);
  padding: 10rpx;
}

.action-list {
  padding: 16rpx 0;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 24rpx;
}

.action-item:active {
  background: rgba(0, 0, 0, 0.04);
}

.action-icon {
  font-size: 40rpx;
  width: 60rpx;
  text-align: center;
}

.action-content {
  flex: 1;
}

.action-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #000;
  margin-bottom: 4rpx;
}

.action-desc {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
}

.action-arrow {
  font-size: 40rpx;
  color: rgba(0, 0, 0, 0.2);
  font-weight: 300;
}

.search-icon {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.3);
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(29, 29, 31, 0.9);
}

.search-placeholder {
  color: rgba(0, 0, 0, 0.3);
  font-weight: 500;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.15);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  font-weight: 900;
}

.search-clear:active {
  background: rgba(0, 0, 0, 0.25);
}

.low-pill {
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(17, 17, 20, 0.06);
  color: rgba(29, 29, 31, 0.72);
  font-size: 24rpx;
  font-weight: 900;
  flex: none;
}

.low-pill.warn {
  background: rgba(255, 59, 48, 0.14);
  color: rgba(255, 59, 48, 0.9);
}

.series-scroll {
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.series-row {
  display: flex;
  gap: 12rpx;
}

.series-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 20, 0.06);
  color: rgba(29, 29, 31, 0.72);
  font-size: 24rpx;
  font-weight: 900;
  display: inline-block;
}

.series-chip.active {
  background: rgba(255, 106, 0, 0.14);
  color: #FF6A00;
}

.threshold-row {
  align-items: center;
}

.threshold-label {
  font-size: 24rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.86);
  flex: none;
}

.threshold-ctrl {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 20, 0.06);
  flex: none;
}

.mini-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.78);
  color: rgba(29, 29, 31, 0.82);
  font-size: 34rpx;
  font-weight: 900;
}

.threshold-input {
  width: 80rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.9);
}

.batch-btn {
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(175, 82, 222, 0.14);
  color: rgba(175, 82, 222, 0.92);
  font-size: 24rpx;
  font-weight: 900;
  flex: none;
}

.list {
  margin-top: 16rpx;
  padding: 18rpx;
}

.list-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 12rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
}

.list-sub {
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.56);
}

.list-scroll {
  max-height: 620rpx;
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 10rpx;
  border-radius: 22rpx;
}

.item + .item {
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  border-top-left-radius: 0;
  border-top-right-radius: 0;
}

.item.low {
  background: rgba(255, 59, 48, 0.06);
}

.item-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.swatch {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  border: 1px solid rgba(0, 0, 0, 0.08);
  flex: none;
}

.meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.code {
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
}

.sub {
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.56);
}

.sub.warn {
  color: #FF3B30;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: none;
}

.count-large {
  font-size: 36rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
  padding: 10rpx 20rpx;
  min-width: 60rpx;
  text-align: right;
  position: relative;
}

.count-large.warn {
  color: #FF3B30;
}

.dot-warn {
  position: absolute;
  top: 10rpx;
  right: 0;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FF3B30;
}

.check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  border: 2px solid rgba(0, 0, 0, 0.12);
  background: rgba(255, 255, 255, 0.7);
}

.check.on {
  background: rgba(175, 82, 222, 0.16);
  border-color: rgba(175, 82, 222, 0.35);
}

.list-pad {
  height: 140rpx;
}

.logs {
  margin-top: 16rpx;
  padding: 18rpx;
}

.logs-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding-bottom: 10rpx;
}

.logs-title {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
}

.logs-actions {
  display: flex;
  gap: 8rpx;
}

.log-chip {
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 20, 0.06);
  color: rgba(29, 29, 31, 0.72);
  font-size: 22rpx;
  font-weight: 900;
}

.log-chip.active {
  background: rgba(255, 106, 0, 0.14);
  color: #FF6A00;
}

/* Timeline & Empty States */
.logs-scroll {
  max-height: 520rpx;
}

.empty-state {
  padding: 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.45);
}

.timeline {
  padding: 12rpx 0;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
  padding-bottom: 24rpx;
}

.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 24rpx;
  flex: none;
  position: relative;
}

.timeline-line {
  position: absolute;
  top: 12rpx;
  bottom: -24rpx;
  width: 2px;
  background: rgba(0, 0, 0, 0.06);
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ccc;
  z-index: 1;
  margin-top: 10rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 1px rgba(0,0,0,0.05);
}

.timeline-dot.add {
  background: #34C759;
}

.timeline-dot.sub {
  background: #FF3B30;
}

.timeline-content {
  flex: 1;
  min-width: 0;
  background: rgba(255, 255, 255, 0.5);
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(0, 0, 0, 0.04);
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
}

.timeline-time {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(29, 29, 31, 0.4);
}

.timeline-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.timeline-delta {
  font-size: 32rpx;
  font-weight: 900;
}

.timeline-delta.add {
  color: #34C759;
}

.timeline-delta.sub {
  color: #FF3B30;
}

.timeline-after {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(29, 29, 31, 0.5);
}

.logs-pad {
  height: 140rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.35);
  z-index: 20000;
}

.sheet {
  width: 100%;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  padding: 26rpx;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
}

.sheet-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.56);
}

.sheet-input {
  margin-top: 16rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(17, 17, 20, 0.06);
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
}

.sheet-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.52);
}

.sheet-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
}

.sheet-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
}

.sheet-btn.ghost {
  background: rgba(17, 17, 20, 0.06);
  color: rgba(29, 29, 31, 0.86);
}

.sheet-btn.primary {
  background: linear-gradient(135deg, #FF6A00, #FFB000);
  color: #fff;
}

.fab-float {
  position: fixed;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 9999;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.72));
  border: 1px solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.18), 0 10rpx 26rpx rgba(0, 0, 0, 0.10), inset 0 1px 0 rgba(255, 255, 255, 0.85);
  transform: translateZ(0);
}

.fab-actions {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  height: 100rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  gap: 12rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.12);
  z-index: 9999;
}

.fab-action {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
}

.fab-action.ghost {
  background: rgba(17, 17, 20, 0.06);
  color: rgba(29, 29, 31, 0.72);
}

.fab-action.primary {
  background: #FF6A00;
  color: #fff;
  flex: 1.5;
}

.fab-float.warn {
  background: linear-gradient(180deg, rgba(255, 242, 242, 0.92), rgba(255, 255, 255, 0.74));
  border-color: rgba(255, 59, 48, 0.16);
}

.fab-float-text {
  font-size: 26rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
}

.fab-badge {
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 59, 48, 0.14);
  color: rgba(255, 59, 48, 0.92);
  font-size: 24rpx;
  font-weight: 900;
}

.stats-card {
  margin-top: 16rpx;
  padding: 18rpx;
}

.stats-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.stats-title {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
}

.stats-sub {
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.56);
}

.chart-canvas {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.6);
}

.legend-row {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 12rpx;
}

.legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 10rpx;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.legend.dimmed {
  opacity: 0.3;
  filter: grayscale(100%);
}

.legend.active {
  background: rgba(0,0,0,0.05);
}

.legend:active {
  background: rgba(0,0,0,0.08);
}

.legend-swatch {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  border: 1px solid rgba(0,0,0,0.08);
}

.legend-text {
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.78);
}

.low-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.low-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 8rpx;
  border-radius: 16rpx;
}

.low-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.low-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.inventory-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between; /* Change gap to space-between */
  padding: 8rpx 0;
}

.grid-item {
  width: 48%; /* Explicit width less than 50% to ensure 2 columns */
  margin-bottom: 16rpx; /* Use margin-bottom instead of gap */
  background: rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
  padding: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border: 1px solid rgba(0, 0, 0, 0.04);
}

.grid-item.low {
  background: rgba(255, 59, 48, 0.08);
  border-color: rgba(255, 59, 48, 0.12);
}

.grid-item.selected {
  background: rgba(175, 82, 222, 0.12);
  border-color: rgba(175, 82, 222, 0.2);
}

.grid-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grid-code {
  font-size: 32rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
}

.grid-swatch {
  width: 32rpx;
  height: 32rpx;
  border-radius: 10rpx;
  border: 1px solid rgba(0, 0, 0, 0.08);
}

.grid-body {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 48rpx;
}

.grid-count {
  font-size: 40rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
  line-height: 1;
}

.grid-count.warn {
  color: #FF3B30;
}

.grid-warn {
  font-size: 20rpx;
  font-weight: 800;
  color: #FF3B30;
  background: rgba(255, 255, 255, 0.6);
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}

/* Grid Item Styles */

/* Log Dialog */
.log-sheet {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.log-sheet-scroll {
  flex: 1;
