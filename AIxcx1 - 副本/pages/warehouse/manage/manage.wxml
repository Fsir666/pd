<view class="page-root">
  <view class="paper-bg"></view>

  <view class="header glass-card">
    <view class="header-left">
      <text class="header-title">智能豆库</text>
      <text class="header-sub">库存管理 · 低库存预警 · 变动记录</text>
    </view>
    <view class="header-right">
      <view class="stat-pill">
        <text class="stat-label">本品牌</text>
        <text class="stat-value">{{brandTotal}}颗</text>
      </view>
      <view class="stat-pill">
        <text class="stat-label">全部</text>
        <text class="stat-value">{{allTotal}}颗</text>
      </view>
    </view>
  </view>

  <view class="tabs glass-card">
    <view class="seg">
      <view class="seg-item {{currentTab==='inventory' ? 'active' : ''}}" data-tab="inventory" bindtap="onTabTap">库存</view>
      <view class="seg-item {{currentTab==='alerts' ? 'active' : ''}}" data-tab="alerts" bindtap="onTabTap">预警</view>
      <view class="seg-item {{currentTab==='logs' ? 'active' : ''}}" data-tab="logs" bindtap="onTabTap">记录</view>
      <view class="seg-item {{currentTab==='stats' ? 'active' : ''}}" data-tab="stats" bindtap="onTabTap">统计</view>
    </view>
  </view>

  <scroll-view scroll-x class="brand-scroll" show-scrollbar="{{false}}">
    <view class="brand-row">
      <view
        class="brand-chip {{selectedBrand===item ? 'active' : ''}}"
        wx:for="{{brands}}"
        wx:key="item"
        data-brand="{{item}}"
        bindtap="onBrandTap"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{currentTab==='inventory'}}">
  <view class="controls glass-card">
    <!-- Series Filter for Inventory -->
    <scroll-view scroll-x class="series-scroll" show-scrollbar="{{false}}">
      <view class="series-row">
        <view
          class="series-chip {{selectedSeries===item.key ? 'active' : ''}}"
          wx:for="{{seriesList}}"
          wx:key="key"
          data-series="{{item.key}}"
          bindtap="onSeriesTap"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>

    <view class="controls-row">
      <view class="seg">
        <view class="seg-item {{sortMode==='code' ? 'active' : ''}}" data-sort="code" bindtap="onSortTap">按色号</view>
        <view class="seg-item {{sortMode==='count' ? 'active' : ''}}" data-sort="count" bindtap="onSortTap">按数量</view>
      </view>

    </view>

    <view class="controls-row">
      <view class="search-wrap">
        <view class="search-icon">🔍</view>
        <input
          class="search-input"
          value="{{searchQuery}}"
          placeholder="搜索色号"
          placeholder-class="search-placeholder"
          bindinput="onSearchInput"
        />
        <view class="search-clear" wx:if="{{searchQuery}}" bindtap="onClearSearch">✕</view>
      </view>
      <view class="low-pill {{lowCount>0 ? 'warn' : ''}}">
        {{lowCount>0 ? ('预警 ' + lowCount) : '库存正常'}}
      </view>
    </view>
  </view>

  <view class="list glass-card">
    <view class="list-header">
      <text class="list-title">库存明细</text>
      <text class="list-sub">{{items.length}}项</text>
    </view>

    <scroll-view scroll-y class="list-scroll" show-scrollbar="{{false}}">
      <view class="empty-state" wx:if="{{!items.length}}">
        <view class="empty-icon">📦</view>
        <text class="empty-text">暂无相关库存</text>
      </view>
      <view class="inventory-grid" wx:else>
        <view
          class="grid-item {{item.isLow ? 'low' : ''}} {{item.selected ? 'selected' : ''}}"
          wx:for="{{items}}"
          wx:key="key"
          data-code="{{item.code}}"
          bindtap="onItemTap"
        >
          <view class="grid-head">
            <text class="grid-code">{{item.code}}</text>
            <view class="grid-swatch" style="background-color: {{item.hex}};"></view>
          </view>
          
          <view class="grid-body" wx:if="{{!batchMode}}">
            <view class="grid-count {{item.isLow ? 'warn' : ''}}" data-code="{{item.code}}" catchtap="openCountEditor">
              {{item.count}}
            </view>
            <view class="grid-warn" wx:if="{{item.isLow}}">缺{{item.threshold - item.count}}</view>
          </view>

          <view class="grid-body" wx:else>
             <view class="check {{item.selected ? 'on' : ''}}"></view>
          </view>
        </view>
      </view>
      <view class="list-pad"></view>
    </scroll-view>
  </view>
  </view>

  <view wx:if="{{currentTab==='alerts'}}">
    <view class="controls glass-card">
      <!-- Series Filter -->
      <scroll-view scroll-x class="series-scroll" show-scrollbar="{{false}}">
        <view class="series-row">
          <view
            class="series-chip {{selectedSeries===item.key ? 'active' : ''}}"
            wx:for="{{seriesList}}"
            wx:key="key"
            data-series="{{item.key}}"
            bindtap="onSeriesTap"
          >
            {{item.label}}
          </view>
        </view>
      </scroll-view>

      <view class="controls-row threshold-row">
        <text class="threshold-label">默认阈值</text>
        <view class="threshold-ctrl">
          <view class="mini-btn" bindtap="onDefaultThresholdDec">-</view>
          <input
            class="threshold-input"
            type="number"
            value="{{defaultThreshold}}"
            bindinput="onDefaultThresholdInput"
          />
          <view class="mini-btn" bindtap="onDefaultThresholdInc">+</view>
        </view>
        <view class="batch-btn" bindtap="openBatch">批量阈值</view>
      </view>
      <view class="controls-row">
        <view class="low-pill {{lowCount>0 ? 'warn' : ''}}">
          {{lowCount>0 ? ('预警 ' + lowCount) : '库存正常'}}
        </view>
      </view>
    </view>

    <view class="list glass-card">
      <view class="list-header">
        <text class="list-title">预警清单</text>
        <text class="list-sub">{{lowCount}}项</text>
      </view>
      <scroll-view scroll-y class="list-scroll" show-scrollbar="{{false}}">
        <view class="empty-state" wx:if="{{!items.length}}">
          <view class="empty-icon">🎉</view>
          <text class="empty-text">库存充足</text>
        </view>
        <view class="inventory-grid" wx:else>
          <view
            class="grid-item low"
            wx:for="{{items}}"
            wx:key="key"
            wx:if="{{item.isLow}}"
            data-code="{{item.code}}"
            bindtap="onItemTap"
          >
            <view class="grid-head">
              <text class="grid-code">{{item.code}}</text>
              <view class="grid-swatch" style="background-color: {{item.hex}};"></view>
            </view>
            <view class="grid-body">
              <view class="grid-count warn" data-code="{{item.code}}" catchtap="openCountEditor">{{item.count}}</view>
              <view class="grid-warn">缺{{item.threshold - item.count}}</view>
            </view>
            <view class="grid-foot" style="display: flex; justify-content: flex-end; margin-top: 8rpx;">
              <text style="font-size: 20rpx; color: rgba(0,0,0,0.4); font-weight: 700;" catchtap="openThresholdEditor">阈值 {{item.threshold}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="logs glass-card" wx:if="{{currentTab==='logs'}}">
    <view class="logs-header">
      <text class="logs-title">记录</text>
      <view class="logs-actions">
        <view class="log-chip {{logScope==='brand' ? 'active' : ''}}" data-scope="brand" bindtap="onLogScopeTap">本品牌</view>
        <view class="log-chip {{logScope==='all' ? 'active' : ''}}" data-scope="all" bindtap="onLogScopeTap">全部</view>
      </view>
    </view>
    <view class="search-wrap" style="margin-bottom: 24rpx;">
      <view class="search-icon">🔍</view>
      <input
        class="search-input"
        value="{{logSearchQuery}}"
        placeholder="搜索记录色号"
        placeholder-class="search-placeholder"
        bindinput="onLogSearchInput"
      />
      <view class="search-clear" wx:if="{{logSearchQuery}}" bindtap="onClearLogSearch">✕</view>
    </view>

    <scroll-view scroll-y class="logs-scroll" show-scrollbar="{{false}}">
      <view class="empty-state" wx:if="{{!logs.length}}">
        <view class="empty-icon">📝</view>
        <text class="empty-text">暂无变动记录</text>
      </view>
      <view class="timeline" wx:else>
        <view class="timeline-item" wx:for="{{logs}}" wx:key="id">
          <view class="timeline-left">
            <view class="timeline-line"></view>
            <view class="timeline-dot {{item.isAdd ? 'add' : 'sub'}}"></view>
          </view>
          <view class="timeline-content">
            <view class="timeline-header">
              <text class="timeline-title">{{item.brand}} {{item.code}}</text>
              <text class="timeline-time">{{item.time}}</text>
            </view>
            <view class="timeline-body">
              <text class="timeline-delta {{item.isAdd ? 'add' : 'sub'}}">{{item.sign}}{{item.delta}}</text>
              <text class="timeline-after">库存: {{item.after}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="logs-pad"></view>
    </scroll-view>
  </view>

  <view wx:if="{{currentTab==='stats'}}">
    <view class="stats-card glass-card">
      <view class="stats-head">
        <text class="stats-title">各品牌库存总量</text>
        <text class="stats-sub">颗数合计</text>
      </view>
      <canvas type="2d" id="barCanvas" class="chart-canvas"></canvas>
      <view class="legend-row">
        <view class="legend" wx:for="{{brands}}" wx:key="item">
          <view class="legend-swatch" style="background-color: {{item==='MARD'?'#FF6A00': item==='COCO'?'#AF52DE': item==='漫漫'?'#54A0FF': item==='盼盼'?'#34C759':'#FF2D55'}}"></view>
          <text class="legend-text">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="stats-card glass-card">
      <view class="stats-head">
        <text class="stats-title">{{selectedBrand}} 色号用量占比</text>
        <text class="stats-sub">Top 8 + 其他</text>
      </view>
      <canvas type="2d" id="pieCanvas" class="chart-canvas" bindtouchstart="onPieTouch"></canvas>
      <view class="legend-row">
        <view
          class="legend {{pieFocusedIndex >= 0 && index !== pieFocusedIndex ? 'dimmed' : ''}} {{pieSelectedIndex === index ? 'active' : ''}}"
          wx:for="{{statsSlices}}"
          wx:key="label"
          data-index="{{index}}"
          bindtap="onLegendTap"
          bindlongpress="onLegendLongPress"
        >
          <view class="legend-swatch" style="background-color: {{item.color || item.hex}}"></view>
          <text class="legend-text">{{item.label}} {{item.value}} ({{item.percent}}%)</text>
        </view>
      </view>
    </view>

    <view class="stats-card glass-card">
      <view class="stats-head">
        <text class="stats-title">库存预警</text>
        <text class="stats-sub">仅显示前10项</text>
      </view>
      <view class="low-list">
        <view class="low-item" wx:for="{{statsLowList}}" wx:key="code">
          <view class="low-left">
            <view class="swatch" style="background-color: {{item.hex}};"></view>
            <view class="meta">
              <text class="code">{{item.code}}</text>
              <text class="sub">阈值 {{item.threshold}}</text>
            </view>
          </view>
          <view class="low-right">
            <view class="count">{{item.count}}</view>
            <view class="tag tag-warn">不足</view>
          </view>
        </view>
        <view wx:if="{{!statsLowList || statsLowList.length===0}}" class="log-empty">暂无预警</view>
      </view>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{editorVisible}}" bindtap="closeEditor">
    <view class="sheet" catchtap="true">
      <view class="sheet-title">{{editorType==='count' ? '调整数量' : '设置预警阈值'}}</view>
      <view class="sheet-sub">{{selectedBrand}} · {{editorCode}}</view>
      <input class="sheet-input" type="number" value="{{editorValue}}" bindinput="onEditorInput" />
      <view class="sheet-hint">{{editorType==='count' ? '最少为 0，支持直接输入' : '库存低于阈值时会提示'}}</view>
      <view class="sheet-actions">
        <view class="sheet-btn ghost" bindtap="closeEditor">取消</view>
        <view class="sheet-btn primary" bindtap="confirmEditor">确定</view>
      </view>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{itemActionVisible}}" bindtap="hideItemActionSheet">
    <view class="sheet action-sheet" catchtap="true">
      <view class="sheet-header">
        <view class="sheet-title">{{selectedBrand}} · {{itemActionCode}}</view>
        <view class="sheet-close" bindtap="hideItemActionSheet">✕</view>
      </view>
      
      <view class="action-list">
        <view class="action-item" bindtap="onActionEditCount">
          <view class="action-icon">📦</view>
          <view class="action-content">
            <view class="action-label">修改库存数量</view>
            <view class="action-desc">当前: {{itemActionCount}}</view>
          </view>
          <view class="action-arrow">›</view>
        </view>
        
        <view class="action-item" bindtap="onActionEditThreshold">
          <view class="action-icon">⚠️</view>
          <view class="action-content">
            <view class="action-label">设置预警阈值</view>
            <view class="action-desc">当前: {{itemActionThreshold}}</view>
          </view>
          <view class="action-arrow">›</view>
        </view>

        <view class="action-item" bindtap="onActionViewLogs">
          <view class="action-icon">📝</view>
          <view class="action-content">
            <view class="action-label">查看变动记录</view>
            <view class="action-desc">历史出入库明细</view>
          </view>
          <view class="action-arrow">›</view>
        </view>
      </view>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{batchDialogVisible}}" bindtap="hideBatchDialog">
    <view class="sheet" catchtap="true">
      <view class="sheet-title">批量设置预警阈值</view>
      <view class="sheet-sub">{{selectedBrand}} · 已选 {{selectedCount}} 项</view>
      <input class="sheet-input" type="number" value="{{batchValue}}" bindinput="onBatchInput" />
      <view class="sheet-actions">
        <view class="sheet-btn ghost" bindtap="hideBatchDialog">取消</view>
        <view class="sheet-btn primary" bindtap="applyBatch">应用</view>
      </view>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{logDialogVisible}}" bindtap="closeLogDialog">
    <view class="sheet log-sheet" catchtap="true">
      <view class="sheet-header">
        <view class="sheet-title">{{selectedBrand}} {{logDialogCode}} 变动记录</view>
        <view class="sheet-close" bindtap="closeLogDialog">✕</view>
      </view>
      
      <scroll-view scroll-y class="log-sheet-scroll" show-scrollbar="{{false}}">
        <view class="empty-state" wx:if="{{!itemLogs.length}}" style="padding: 40rpx 0;">
          <view class="empty-icon" style="font-size: 60rpx;">📝</view>
          <text class="empty-text">暂无记录</text>
        </view>
        <view class="timeline" wx:else>
          <view class="timeline-item" wx:for="{{itemLogs}}" wx:key="id">
            <view class="timeline-left">
              <view class="timeline-line"></view>
              <view class="timeline-dot {{item.isAdd ? 'add' : 'sub'}}"></view>
            </view>
            <view class="timeline-content">
              <view class="timeline-header">
                <text class="timeline-time">{{item.time}}</text>
                <text class="timeline-after">库存: {{item.after}}</text>
              </view>
              <view class="timeline-body">
                <text class="timeline-delta {{item.isAdd ? 'add' : 'sub'}}">{{item.sign}}{{item.delta}}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="fab-float {{lowCount>0 ? 'warn' : ''}}" wx:if="{{currentTab==='alerts' && !batchMode}}" bindtap="openBatch">
    <text class="fab-float-text">预警设置</text>
    <view class="fab-badge" wx:if="{{lowCount>0}}">{{lowCount}}</view>
  </view>

  <view class="fab-actions" wx:if="{{batchMode}}">
    <view class="fab-action ghost" bindtap="toggleSelectAll">{{selectAllText}}</view>
    <view class="fab-action ghost" bindtap="closeBatch">取消</view>
    <view class="fab-action primary" bindtap="showBatchDialog">设置阈值 ({{selectedCount}})</view>
  </view>
</view>
