<wxs module="refresh">
var pullThreshold = 80;
var maxPull = 150;

function onPulling(e, ownerInstance) {
  var dy = e.detail.dy;
  if (dy < 0) return;
  var rotate = dy * 4;
  var scale = 0.6 + (dy / pullThreshold) * 0.6;
  if (scale > 1.2) scale = 1.2;
  var icon = ownerInstance.selectComponent('.refresh-icon');
  var text = ownerInstance.selectComponent('.refresh-text');
  if (icon) {
    icon.setStyle({ transform: 'rotate(' + rotate + 'deg) scale(' + scale + ')' });
  }
  if (text) {
    var opacity = (dy - 20) / (pullThreshold - 20);
    if (opacity < 0) opacity = 0;
    if (opacity > 1) opacity = 1;
    text.setStyle({ opacity: opacity });
  }
}

function onStatusChange(newValue, oldValue, ownerInstance, instance) {
  if (newValue) {
    var icon = ownerInstance.selectComponent('.refresh-icon');
    if (icon) icon.setStyle({ transform: '' });
  }
}

module.exports = {
  onPulling: onPulling,
  onStatusChange: onStatusChange
}
</wxs>

<view class="page-container">
  <view class="ambient-bg">
    <view class="orb orb-1"></view>
    <view class="orb orb-2"></view>
    <view class="orb orb-3"></view>
  </view>
  <view class="header-bg"></view>
  
  <scroll-view 
    scroll-y 
    style="height: 100vh;" 
    refresher-enabled="{{true}}" 
    refresher-threshold="{{100}}"
    refresher-default-style="none"
    refresher-background="transparent"
    refresher-triggered="{{isRefreshing}}"
    bindrefresherpulling="{{refresh.onPulling}}"
    bindrefresherrefresh="onRefresh"
    bindrefresherrestore="onRestore"
  >
    <!-- Custom Refresher -->
    <view slot="refresher" class="custom-refresher" prop="{{isRefreshing}}" change:prop="{{refresh.onStatusChange}}">
      <view class="refresh-content">
        <view class="refresh-icon {{isRefreshing ? 'rotating' : ''}}">💡</view>
        <text class="refresh-text">寻找灵感...</text>
      </view>
    </view>

    <view class="content-container">
      <view class="page-header">
        <view class="title-row">
          <text class="page-title">灵感社区</text>
          <view class="header-actions">
            <view class="title-badge">精选</view>
            <view class="header-search-btn" bindtap="openSearch">搜索</view>
          </view>
        </view>
        <text class="page-subtitle">发现拼豆灵感，收藏你的下一张图</text>
      </view>

      <scroll-view class="chip-scroll" scroll-x show-scrollbar="false">
        <view class="chip-row">
          <view class="chip {{feedSort === 'new' ? 'active' : ''}}" bindtap="onFeedSortTap" data-key="new">最新</view>
          <view class="chip {{feedSort === 'hot' ? 'active' : ''}}" bindtap="onFeedSortTap" data-key="hot">热门</view>
          <view class="chip">可爱</view>
          <view class="chip">动漫</view>
          <view class="chip">像素风</view>
          <view class="chip">节日</view>
        </view>
      </scroll-view>

      <!-- Permanent Action Banner (Formerly Empty State) -->
      <view class="empty-state">
        <view class="empty-card">
          <view class="empty-hero">
            <view class="empty-icon">✨</view>
            <view class="empty-texts">
              <view class="empty-title">还没有灵感内容</view>
              <view class="empty-desc">先做一张作品发布到这里，让大家看到你的拼豆！</view>
            </view>
          </view>
          <view class="empty-actions">
            <button class="primary-btn" bindtap="onCreateTap">开始创作</button>
            <button class="ghost-btn" bindtap="onGenerateTap">图片转像素</button>
          </view>
        </view>
      </view>

      <view wx:if="{{communityList.length > 0}}">
        <view class="section-row">
          <text class="section-title">今日灵感</text>
          <text class="section-sub">{{communityList.length}} 条</text>
        </view>

        <!-- Waterfall Layout -->
        <view class="waterfall-container">
          <!-- Left Column -->
          <view class="waterfall-column">
            <view class="card-item" 
                  wx:for="{{leftList}}" 
                  wx:key="_id"
                  bindtap="goToDetail"
                  data-id="{{item._id}}"
                  data-title="{{item.content || '未命名'}}"
                  data-image-url="{{item.imageUrl}}"
                  data-author="{{item.author}}"
                  data-likes="{{item.likes}}">
              <view class="card-media">
                <image class="card-img" src="{{item.imageUrl}}" mode="widthFix" lazy-load binderror="onImageError" data-list="left" data-index="{{index}}"></image>
                <view class="card-media-overlay"></view>
              </view>
              <view class="card-info">
                <text class="card-title">{{item.content || '无题'}}</text>
                <view class="card-meta">
                  <view class="author-info" catchtap="goToAuthor" data-openid="{{item._openid}}">
                    <image class="author-avatar" src="{{item.authorAvatar}}" mode="aspectFill" wx:if="{{item.authorAvatar}}"></image>
                    <view class="avatar-placeholder" wx:else>{{item.author[0] || '?'}}</view>
                    <text class="author-name">{{item.author}}</text>
                  </view>
                  <view class="likes-info">
                    <text class="like-icon">❤️</text>
                    <text>{{item.likes}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <!-- Right Column -->
          <view class="waterfall-column">
            <view class="card-item" 
                  wx:for="{{rightList}}" 
                  wx:key="_id"
                  bindtap="goToDetail"
                  data-id="{{item._id}}"
                  data-title="{{item.content || '未命名'}}"
                  data-image-url="{{item.imageUrl}}"
                  data-author="{{item.author}}"
                  data-likes="{{item.likes}}">
              <view class="card-media">
                <image class="card-img" src="{{item.imageUrl}}" mode="widthFix" lazy-load binderror="onImageError" data-list="right" data-index="{{index}}"></image>
                <view class="card-media-overlay"></view>
              </view>
              <view class="card-info">
                <text class="card-title">{{item.content || '无题'}}</text>
                <view class="card-meta">
                  <view class="author-info" catchtap="goToAuthor" data-openid="{{item._openid}}">
                    <image class="author-avatar" src="{{item.authorAvatar}}" mode="aspectFill" wx:if="{{item.authorAvatar}}"></image>
                    <view class="avatar-placeholder" wx:else>{{item.author[0] || '?'}}</view>
                    <text class="author-name">{{item.author}}</text>
                  </view>
                  <view class="likes-info">
                    <text class="like-icon">❤️</text>
                    <text>{{item.likes}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- Bottom Padding for TabBar -->
      <view class="safe-bottom" style="height: 160rpx;"></view>
    </view>
  </scroll-view>

  <view wx:if="{{searchVisible}}" class="search-overlay" bindtap="closeSearch">
    <view class="search-panel glass-card" catchtap="noop">
      <view class="search-bar">
        <input
          class="search-input"
          value="{{searchQuery}}"
          focus="{{searchFocus}}"
          placeholder="搜索用户/作品（支持模糊）"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
        <view class="search-clear" wx:if="{{searchQuery}}" bindtap="onSearchClear">清空</view>
        <view class="search-close" bindtap="closeSearch">关闭</view>
      </view>

      <view class="search-results">
        <view wx:if="{{searchLoading}}" class="search-loading">搜索中...</view>

        <view wx:else>
          <view class="search-section" wx:if="{{searchUsers.length > 0}}">
            <view class="search-section-title">用户</view>
            <view
              class="user-row-item"
              wx:for="{{searchUsers}}"
              wx:key="_openid"
              bindtap="goToUserProfileFromSearch"
              data-openid="{{item._openid}}"
            >
              <image class="user-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
              <view class="user-row-main">
                <view class="user-row-name">{{item.nickName}}</view>
                <view class="user-row-bio">{{item.bio || '暂无简介'}}</view>
              </view>
              <view
                class="follow-btn {{item.isFollowing ? 'following' : ''}}"
                catchtap="onToggleFollowFromSearch"
                data-openid="{{item._openid}}"
                data-index="{{index}}"
              >
                {{item.isFollowing ? '已关注' : '关注'}}
              </view>
            </view>
          </view>

          <view class="search-section" wx:if="{{searchWorks.length > 0}}">
            <view class="search-section-title">作品</view>
            <view
              class="work-row-item"
              wx:for="{{searchWorks}}"
              wx:key="_id"
              bindtap="goToDetailFromSearch"
              data-id="{{item._id}}"
              data-title="{{item.content || item.title || '未命名'}}"
              data-image-url="{{item.imageUrl}}"
              data-author="{{item.author}}"
              data-likes="{{item.likes}}"
            >
              <image class="work-thumb" src="{{item.imageUrl}}" mode="aspectFill"></image>
              <view class="work-row-main">
                <view class="work-row-title">{{item.content || item.title || '未命名'}}</view>
                <view class="work-row-sub">
                  <view class="work-row-author">{{item.author || '匿名用户'}}</view>
                  <view class="work-row-like">❤️ {{item.likes || 0}}</view>
                </view>
              </view>
            </view>
          </view>

          <view wx:if="{{searchQuery && searchUsers.length === 0 && searchWorks.length === 0}}" class="search-empty">
            未找到相关内容
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
