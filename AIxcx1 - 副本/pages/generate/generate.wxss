/* Global Page Setup */
.page-root {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  background-color: #F2F4F8;
  overflow-x: hidden;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* Ambient Background */
.ambient-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.6;
}

.orb-1 {
  width: 500rpx;
  height: 500rpx;
  background: #FFEAA7; /* Soft Yellow */
  top: -100rpx;
  right: -100rpx;
}

.orb-2 {
  width: 400rpx;
  height: 400rpx;
  background: #74B9FF; /* Soft Blue */
  bottom: 20%;
  left: -50rpx;
}

/* Glassmorphism Utilities */
.glass-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.04);
  border-radius: 40rpx;
}

/* Upload State */
.upload-container {
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  min-height: 80vh;
  justify-content: center;
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

.upload-card {
  height: 500rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 40rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.upload-card:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.95);
}

.upload-icon-box {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #fff, #f5f5f7);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 40rpx;
  box-shadow: 0 20rpx 40rpx rgba(0,0,0,0.06);
  border: 1px solid rgba(255,255,255,0.8);
}

.upload-icon {
  font-size: 72rpx;
}

.upload-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 16rpx;
  letter-spacing: -0.5px;
}

.upload-desc {
  font-size: 28rpx;
  color: #86868b;
}

.features-list {
  padding: 36rpx 34rpx;
  background: rgba(255, 255, 255, 0.6);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1d1d1f;
  letter-spacing: -0.3px;
}

.intro-desc {
  font-size: 26rpx;
  color: rgba(29, 29, 31, 0.65);
  line-height: 1.6;
}

.feature-item {
  display: flex;
  align-items: center;
  margin-bottom: 0;
  justify-content: flex-start;
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 500;
}

.feature-icon {
  margin-right: 16rpx;
  font-size: 36rpx;
}

/* Editor State */
.editor-container {
  padding: 30rpx 40rpx;
  position: relative;
  z-index: 1;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

/* 原图预览 */
.original-section {
  padding: 32rpx;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.original-img {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  background-color: #f5f5f7;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  border: 1px solid rgba(0,0,0,0.02);
}

.reupload-btn {
  font-size: 28rpx;
  color: #007AFF;
  padding: 16rpx 40rpx;
  background: rgba(0, 122, 255, 0.1);
  border-radius: 100rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.reupload-btn:active {
  background: rgba(0, 122, 255, 0.2);
  transform: scale(0.98);
}

/* 结果标题行 */
.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
  padding: 0 10rpx;
}

.section-title-large {
  font-size: 44rpx;
  font-weight: 800;
  color: #1d1d1f;
  letter-spacing: -1px;
}

.section-hint {
  font-size: 26rpx;
  color: #86868b;
}

/* 结果预览 */
.preview-section {
  padding: 32rpx;
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 400rpx;
  position: relative;
  background: #fff;
}

.canvas-container {
  width: 100%;
  height: 600rpx;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.zoom-hint-icon {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #1d1d1f;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  pointer-events: none;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.1);
  backdrop-filter: blur(10px);
}

.process-canvas {
  position: absolute;
  top: -9999px;
  left: -9999px;
  visibility: hidden;
}

.display-canvas {
  width: 100%;
  height: 100%;
}

.settings-section {
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.setting-item {
  margin-bottom: 40rpx;
}

.setting-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.setting-hint {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.setting-value {
  color: #007AFF;
  font-weight: 700;
  background: rgba(0, 122, 255, 0.1);
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-block {
  width: 100% !important;
  margin-top: 20rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn-primary, .btn-secondary {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, #007AFF, #0056b3);
  color: #FFF;
  box-shadow: 0 16rpx 32rpx rgba(0, 122, 255, 0.3);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 16rpx rgba(0, 122, 255, 0.2);
}

.btn-secondary {
  background: #F0F2F5;
  color: #666;
}

.btn-secondary:active {
  background: #E1E4E8;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 24rpx;
  padding-left: 0;
  border-left: none;
  text-align: center;
  width: 100%;
}

.btn-save {
  flex: none;
  margin-top: 20rpx;
}

.btn-save-primary {
  height: 112rpx;
  line-height: 112rpx;
  border-radius: 56rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFF;
  background: linear-gradient(135deg, #FF6A00, #FFB000);
  box-shadow: 0 18rpx 36rpx rgba(255, 122, 0, 0.28);
  border: none;
}

.btn-save-primary:active {
  transform: scale(0.98);
  box-shadow: 0 10rpx 20rpx rgba(255, 122, 0, 0.2);
}

.save-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(29, 29, 31, 0.6);
  text-align: center;
}

.canvas-fab {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1d1d1f;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(0,0,0,0.12);
  backdrop-filter: blur(10px);
}

.canvas-fab:active {
  transform: scale(0.98);
}

.export-canvas {
  position: absolute;
  left: -9999px;
  top: -9999px;
}

.segmented-control {
  display: flex;
  background: rgba(118, 118, 128, 0.12);
  border-radius: 16rpx;
  padding: 4rpx;
  margin-top: 20rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #333;
  border-radius: 12rpx;
  transition: all 0.2s;
  font-weight: 500;
}

.segment-item.active {
  background: #FFF;
  color: #000;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
  font-weight: 600;
}

.stats-section {
  margin-top: 24rpx;
  padding: 24rpx;
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.stats-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.stats-brand {
  font-size: 24rpx;
  color: #007AFF;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.1);
}

.stats-summary {
  font-size: 26rpx;
  color: #6e6e73;
}

.setting-brand-tabs {
  margin-top: 12rpx;
  margin-bottom: 0;
}

.brand-tabs {
  height: 66rpx;
  margin-top: 12rpx;
  margin-bottom: 10rpx;
}

.brand-tabs-inner {
  height: 66rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.brand-chip {
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.06);
  color: #1d1d1f;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.brand-chip.active {
  background: rgba(0, 122, 255, 0.12);
  color: #007AFF;
}

.stats-sort {
  margin: 8rpx 0 20rpx 0;
}

.stats-list {
  max-height: 720rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.5), 0 8rpx 20rpx rgba(0,0,0,0.06);
  margin-bottom: 16rpx;
}

.stats-index {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #FFD54F;
  color: #0F1012;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats-swatch {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  box-shadow: inset 0 3rpx 6rpx rgba(255,255,255,0.6), inset 0 -3rpx 6rpx rgba(0,0,0,0.06);
  border: 1rpx solid rgba(0,0,0,0.08);
}

.stats-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.stats-code {
  font-size: 30rpx;
  color: #1d1d1f;
  font-weight: 800;
  letter-spacing: -0.3px;
}

.stats-hex {
  font-size: 22rpx;
  color: #6e6e73;
  font-weight: 600;
}

.stats-count {
  font-size: 26rpx;
  color: #6e6e73;
  font-weight: 500;
}
