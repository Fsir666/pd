<view class="page-root">
  <!-- 背景 -->
  <view class="ambient-bg">
    <view class="orb orb-1"></view>
    <view class="orb orb-2"></view>
  </view>

  <!-- 状态1: 上传界面 -->
  <view class="upload-container" wx:if="{{!imageUrl}}">
    <view class="upload-card glass-card" bindtap="onChooseImage">
      <view class="upload-icon-box">
        <text class="upload-icon">📷</text>
      </view>
      <text class="upload-title">上传一张图片</text>
      <text class="upload-desc">支持相册 / 拍照 · JPG / PNG</text>
    </view>
    
    <view class="features-list glass-card">
      <text class="intro-title">生成像素图能做什么？</text>
      <text class="intro-desc">把图片转成可照着拼的马赛克网格，并自动生成用色清单与颗数。</text>
      <view class="feature-item">
        <text class="feature-icon">✨</text>
        <text>一键像素化，自动匹配拼豆色板</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">🎛️</text>
        <text>网格尺寸 16–128 可调，适配不同作品大小</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">🏷️</text>
        <text>可显示品牌色号（MARD / COCO / 漫漫 / 盼盼 / 咪小窝）</text>
      </view>
      <view class="feature-item">
        <text class="feature-icon">🖼️</text>
        <text>导出高清图到相册（含马赛克色号 + 用色清单）</text>
      </view>
    </view>
  </view>

  <!-- 状态2: 编辑与结果界面 -->
  <view class="editor-container" wx:else>
    
    <!-- 原图预览区域 -->
    <view class="original-section glass-card">
      <view class="section-title">原图预览</view>
      <image class="original-img" src="{{imageUrl}}" mode="aspectFit" bindtap="onPreviewOriginal"></image>
      <view class="reupload-btn" bindtap="onReUpload">更换图片</view>
    </view>

    <!-- 参数设置区域 -->
    <view class="settings-section glass-card">
      <view class="setting-item">
        <view class="setting-label">
          <text>尺寸</text>
          <text class="setting-value">{{gridSize}}x{{gridSize}}</text>
        </view>
        <slider min="16" max="128" step="4" value="{{gridSize}}" activeColor="#007AFF" bindchange="onGridSizeChange" bindchanging="onGridSizeChanging"/>
      </view>

      <view class="setting-item">
        <view class="setting-label">
          <text>风格</text>
        </view>
        <view class="segmented-control">
          <view class="segment-item {{presetKey === 'auto' ? 'active' : ''}}" bindtap="onPresetTap" data-preset="auto">推荐</view>
          <view class="segment-item {{presetKey === 'clear' ? 'active' : ''}}" bindtap="onPresetTap" data-preset="clear">清晰</view>
          <view class="segment-item {{presetKey === 'real' ? 'active' : ''}}" bindtap="onPresetTap" data-preset="real">真实</view>
          <view class="segment-item {{presetKey === 'pixel' ? 'active' : ''}}" bindtap="onPresetTap" data-preset="pixel">像素图</view>
        </view>
      </view>

      <view class="setting-item">
        <view class="setting-label">
          <text>更多设置</text>
        </view>
        <view class="segmented-control">
          <view class="segment-item {{showAdvanced ? 'active' : ''}}" bindtap="onToggleAdvanced">{{showAdvanced ? '收起' : '展开'}}</view>
        </view>
      </view>

      <view wx:if="{{showAdvanced}}">
        <view class="setting-item">
          <view class="setting-label">
            <text>取样模式</text>
          </view>
          <view class="segmented-control">
            <view class="segment-item {{sampleMode === 'auto' ? 'active' : ''}}" bindtap="onSetSampleMode" data-mode="auto">自动</view>
            <view class="segment-item {{sampleMode === 'photo' ? 'active' : ''}}" bindtap="onSetSampleMode" data-mode="photo">照片</view>
            <view class="segment-item {{sampleMode === 'pixel' ? 'active' : ''}}" bindtap="onSetSampleMode" data-mode="pixel">像素图</view>
          </view>
        </view>

        <view class="setting-item">
          <view class="setting-label">
            <text>颗粒感</text>
            <text class="setting-value">{{ditherValue}}%</text>
          </view>
          <slider min="0" max="80" step="5" value="{{ditherValue}}" activeColor="#007AFF" bindchange="onDitherChange" bindchanging="onDitherChanging"/>
        </view>

        <view class="setting-item">
          <view class="setting-label">
            <text>更清晰</text>
            <text class="setting-value">{{detailValue}}%</text>
          </view>
          <slider min="0" max="60" step="5" value="{{detailValue}}" activeColor="#007AFF" bindchange="onDetailChange" bindchanging="onDetailChanging"/>
        </view>
      </view>

      <view wx:if="{{showAdvanced}}">
        <view class="setting-item">
          <view class="setting-label">
            <text>显示网格线</text>
            <switch checked="{{showGrid}}" color="#007AFF" bindchange="onToggleGrid"/>
          </view>
        </view>

        <view class="setting-item">
          <view class="setting-label">
            <text>显示标尺</text>
            <switch checked="{{showRuler}}" color="#007AFF" bindchange="onToggleRuler"/>
          </view>
        </view>

        <view class="setting-item">
          <view class="setting-label">
            <text>马赛克色号</text>
          </view>
          <scroll-view scroll-x class="brand-tabs setting-brand-tabs" show-scrollbar="{{false}}">
            <view class="brand-tabs-inner">
              <view class="brand-chip {{selectedBrand === item.key ? 'active' : ''}}" wx:for="{{brandOptions}}" wx:key="key" bindtap="onBrandTap" data-brand="{{item.key}}">
                <text>{{item.label}}</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="setting-item">
          <view class="setting-label">
            <text>显示格内色号</text>
            <switch checked="{{showCellCodes}}" color="#007AFF" bindchange="onToggleCellCodes"/>
          </view>
        </view>

        <view class="setting-item" wx:if="{{showGrid}}">
          <view class="setting-label">
            <text>辅助网格 (加粗)</text>
          </view>
          <view class="segmented-control">
            <view class="segment-item {{auxGridIndex === 0 ? 'active' : ''}}" bindtap="onSetAuxGrid" data-index="0">关闭</view>
            <view class="segment-item {{auxGridIndex === 1 ? 'active' : ''}}" bindtap="onSetAuxGrid" data-index="1">5格</view>
            <view class="segment-item {{auxGridIndex === 2 ? 'active' : ''}}" bindtap="onSetAuxGrid" data-index="2">10格</view>
          </view>
        </view>
      </view>
      
      <button class="btn-primary btn-block" bindtap="onGenerate">开始生成拼豆图</button>
    </view>

    <!-- 生成结果区域 (点击生成后显示) -->
    <view class="result-section" wx:if="{{isGenerated}}">
      <view class="section-header-row">
        <text class="section-title-large">生成结果</text>
        <text class="section-hint">双指缩放 / 单指拖动</text>
      </view>

      <view class="preview-section glass-card">
        <view class="canvas-container">
          <!-- 原始 Canvas 用于处理像素数据 (隐藏) -->
          <canvas type="2d" id="processCanvas" class="process-canvas" style="width:{{processWidth}}px; height:{{processHeight}}px;"></canvas>
          <!-- 展示用 Canvas -->
          <canvas
            type="2d"
            id="displayCanvas"
            class="display-canvas"
            style="width:{{displayW}}px; height:{{displayH}}px;"
            bindtouchstart="onCanvasTouchStart"
            catchtouchmove="onCanvasTouchMove"
            bindtouchend="onCanvasTouchEnd"
            bindtouchcancel="onCanvasTouchEnd"
          ></canvas>
          
          <view class="canvas-fab" bindtap="onPreviewResult">放大查看</view>
        </view>
      </view>
      <canvas type="2d" id="exportCanvas" class="export-canvas" style="width:{{exportW}}px; height:{{exportH}}px;"></canvas>
      <button class="btn-block btn-save btn-save-primary" bindtap="onSaveImage" loading="{{isSaving}}" disabled="{{isSaving}}">{{isSaving ? '正在保存…' : '保存高清图到相册'}}</button>
      <view class="save-hint">包含马赛克色号 + 用色清单</view>

      <view class="stats-section glass-card">
        <view class="stats-header">
          <view class="stats-title-wrap">
            <text class="stats-title">用色统计</text>
            <text class="stats-brand">{{selectedBrand || '不显示'}}</text>
          </view>
          <view class="stats-summary">
            <text>共 {{statsTotalColors}} 色 / {{statsTotalBeads}} 颗</text>
          </view>
        </view>

        <scroll-view scroll-x class="brand-tabs" show-scrollbar="{{false}}">
          <view class="brand-tabs-inner">
            <view class="brand-chip {{selectedBrand === item.key ? 'active' : ''}}" wx:for="{{brandOptions}}" wx:key="key" bindtap="onBrandTap" data-brand="{{item.key}}">
              <text>{{item.label}}</text>
            </view>
          </view>
        </scroll-view>

        <view class="stats-sort">
          <view class="segmented-control">
            <view class="segment-item {{statsSortMode === 'count' ? 'active' : ''}}" bindtap="onStatsSortChange" data-mode="count">按数量</view>
            <view class="segment-item {{statsSortMode === 'code' ? 'active' : ''}}" bindtap="onStatsSortChange" data-mode="code">按色号</view>
          </view>
        </view>

        <scroll-view scroll-y class="stats-list" show-scrollbar="{{false}}">
          <view class="stats-row" wx:for="{{statsList}}" wx:key="key">
            <view class="stats-index">{{index + 1}}</view>
            <view class="stats-swatch" style="background-color: {{item.hex}}"></view>
            <view class="stats-main">
              <text class="stats-code">{{item.code}}</text>
              <text class="stats-hex">{{item.hex}}</text>
            </view>
            <text class="stats-count">{{item.count}} 颗</text>
          </view>
        </scroll-view>
      </view>
    </view>

  </view>
</view>
