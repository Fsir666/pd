<view class="container">
  <!-- Input Section -->
  <view class="input-card">
    <view class="input-group">
      <text class="label">DeepSeek API Key</text>
      <input class="input" placeholder="请输入 DeepSeek Key (用于生成像素画)" value="{{apiKey}}" bindinput="onApiKeyInput" />
    </view>
    <view class="input-group">
      <text class="label">生成提示词</text>
      <input class="input" placeholder="想要生成什么？例如：一只像素猫咪" value="{{prompt}}" bindinput="onPromptInput" />
    </view>
  </view>

  <!-- Hidden Canvas for generation (Must be outside wx:if to be selectable) -->
  <canvas type="2d" id="pixelCanvas" class="hidden-canvas"></canvas>

  <view class="preview-card">
    <view class="card-header">
      <text class="card-title">AI 生成预览</text>
    </view>
    
    <view class="card-content">
      <block wx:if="{{generatedData && generatedData.imageUrl}}">
        <image 
          src="{{generatedData.imageUrl}}" 
          mode="aspectFit" 
          class="preview-image"
          bindtap="onPreviewImage"
        />
      </block>
      <block wx:else>
        <view class="empty-state">
          <text class="empty-text">输入主题，点击生成\n获取一张 AI 绘制的图片</text>
        </view>
      </block>
    </view>
  </view>

  <view class="action-area">
    <button class="btn generate-btn" bindtap="generateData" hover-class="btn-hover">
      {{generatedData ? '重新生成' : '自动生成'}}
    </button>
    
    <button class="btn submit-btn" type="primary" bindtap="submitData" disabled="{{!generatedData || loading}}" loading="{{loading}}">
      确认提交
    </button>
  </view>
</view>
