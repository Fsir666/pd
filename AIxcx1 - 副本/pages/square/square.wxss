.page-root {
  min-height: 100vh;
  background: #f3f0ea;
}

.paper-bg {
  position: fixed;
  inset: 0;
  background: radial-gradient(900rpx 600rpx at 20% 12%, rgba(255, 210, 140, 0.35), transparent 55%),
    radial-gradient(780rpx 520rpx at 82% 22%, rgba(130, 210, 255, 0.32), transparent 58%),
    radial-gradient(900rpx 700rpx at 55% 92%, rgba(255, 160, 190, 0.22), transparent 60%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(243, 240, 234, 0.92));
  filter: saturate(115%);
  z-index: 0;
}

.scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
}

/* Ensure bottom padding for custom tab bar */
page {
  padding-bottom: calc(120rpx + 40rpx + env(safe-area-inset-bottom));
}

.content {
  min-height: 100vh;
  padding-top: 220rpx;
  padding-bottom: calc(120rpx + 40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.poster-wrap {
  width: 94%;
  margin: 0 auto;
  position: relative;
}

.poster-img {
  width: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 60rpx rgba(0, 0, 0, 0.12);
  transform: translateZ(0);
  display: block;
}

.comingsoon-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0);
  opacity: 0;
  pointer-events: none;
  transition: opacity 160ms ease, background 160ms ease;
  z-index: 10000;
}

.comingsoon-mask.show {
  opacity: 1;
  pointer-events: auto;
  background: rgba(0, 0, 0, 0.35);
}

.comingsoon-card {
  width: 560rpx;
  padding: 34rpx 30rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(18px) saturate(160%);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 22rpx 70rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
  transform: translateY(16rpx) scale(0.98);
  transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.comingsoon-mask.show .comingsoon-card {
  transform: translateY(0) scale(1);
}

.comingsoon-title {
  font-size: 34rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
  text-align: center;
}

.comingsoon-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(29, 29, 31, 0.68);
  text-align: center;
  line-height: 1.4;
}

.comingsoon-btn {
  margin-top: 24rpx;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.06);
  color: rgba(29, 29, 31, 0.88);
  font-size: 30rpx;
  font-weight: 900;
}

.custom-tabbar {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: saturate(180%) blur(50px);
  -webkit-backdrop-filter: saturate(180%) blur(50px);
  border-radius: 55rpx;
  border-top: 0.5px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 9999;
  box-sizing: border-box;
  padding: 10rpx;
  overflow: hidden;
}

.tab-cursor {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  width: 25%;
  background: #ffffff;
  border-radius: 45rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08), 0 0 1rpx rgba(0, 0, 0, 0.1);
  transition: left 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  z-index: 1;
  pointer-events: none;
}

.tab-cursor.no-transition {
  transition: none !important;
}

.tab-item {
  position: relative;
  z-index: 100;
  flex: 1;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #999;
  font-weight: normal;
  transition: all 0.25s;
}

.tab-item.active {
  color: #000;
  font-weight: 800;
  font-size: 30rpx;
  transform: scale(1.05);
}
