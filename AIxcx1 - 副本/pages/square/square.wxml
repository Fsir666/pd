<view class="page-root">
  <view class="paper-bg"></view>

  <scroll-view class="scroll" scroll-y>
    <view class="content">
      <view class="poster-wrap">
        <image
          class="poster-img"
          src="{{posterSrc}}"
          mode="widthFix"
          catchtap="onCtaTap"
          catchtouchstart="onCtaTap"
        />
      </view>
      <!-- Bottom Padding for TabBar -->
      <view style="height: 160rpx;"></view>
    </view>
  </scroll-view>

  <view class="comingsoon-mask {{comingSoonVisible ? 'show' : ''}}" catchtap="hideComingSoon">
    <view class="comingsoon-card" catchtap="hideComingSoon">
      <view class="comingsoon-title">功能即将上线</view>
      <view class="comingsoon-desc">小程序正式上线后开放，敬请期待</view>
      <view class="comingsoon-btn">知道了</view>
    </view>
  </view>
</view>
