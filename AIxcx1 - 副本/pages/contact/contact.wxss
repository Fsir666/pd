page {
  background-color: #F2F2F7;
}

.page-container {
  padding: 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.contact-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.05);
}

.header-icon {
  font-size: 60rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 28rpx;
  color: #8E8E93;
}

/* Menu Group */
.menu-group {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 60rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: #FFFFFF;
  position: relative;
}

.menu-item:active {
  background: #F2F2F7;
}

.menu-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 32rpx;
  right: 0;
  height: 1rpx;
  background: #E5E5EA;
}

.item-title {
  font-size: 30rpx;
  color: #1C1C1E;
}

.item-arrow {
  color: #C7C7CC;
  font-size: 32rpx;
}

/* Button */
.contact-btn {
  background: #007AFF;
  color: #fff;
  border-radius: 50rpx;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 30rpx rgba(0, 122, 255, 0.3);
}

.contact-btn::after {
  border: none;
}

.btn-icon {
  margin-right: 16rpx;
  font-size: 36rpx;
}