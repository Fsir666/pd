.page-root {
  position: relative;
  width: 100vw;
  height: 100vh;
  background-color: #F2F4F8;
  overflow: hidden;
}

.ambient-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.7;
}

.orb-1 {
  width: 600rpx;
  height: 600rpx;
  background: #E0C3FC;
  top: -150rpx;
  left: -100rpx;
  animation: float 10s infinite ease-in-out;
}

.orb-2 {
  width: 500rpx;
  height: 500rpx;
  background: #FFD1FF;
  bottom: 10%;
  right: -100rpx;
  animation: float 12s infinite ease-in-out reverse;
}

.orb-3 {
  width: 400rpx;
  height: 400rpx;
  background: #D4F1F4;
  top: 40%;
  left: 20%;
  animation: float 15s infinite ease-in-out 2s;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(20rpx, 30rpx); }
}

.container {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.tools-header {
  margin: 40rpx 0 60rpx;
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #333;
  margin-bottom: 8rpx;
}

.page-desc {
  font-size: 28rpx;
  color: #999;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2328;
  margin: 40rpx 0 24rpx;
  padding-left: 8rpx;
  border-left: 8rpx solid #FF6B00;
  line-height: 1;
}

/* Featured Grid */
.featured-grid {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-bottom: 40rpx;
}

.featured-card {
  width: 100%;
  position: relative;
  overflow: hidden;
  border-radius: 40rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
  box-sizing: border-box;
}

.featured-card:active {
  transform: scale(0.98);
}

.featured-card.primary {
  background: linear-gradient(120deg, #FFFFFF 0%, #FFF8F0 100%);
  border: 1px solid rgba(255, 107, 0, 0.1);
}

.featured-card.secondary {
  background: linear-gradient(120deg, #FFFFFF 0%, #FFF3E0 100%);
  border: 1px solid rgba(255, 159, 67, 0.1);
}

.card-bg-icon {
  position: absolute;
  right: -20rpx;
  bottom: -40rpx;
  font-size: 200rpx;
  opacity: 0.06;
  pointer-events: none;
  transform: rotate(-15deg);
}

.card-content {
  display: flex;
  align-items: center;
  z-index: 1;
}

.card-icon {
  width: 110rpx;
  height: 110rpx;
  background: #fff;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 32rpx;
  box-shadow: 0 12rpx 30rpx rgba(0,0,0,0.08);
}

.card-text {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #333;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #888;
  font-weight: 500;
}

.card-action {
  background: rgba(0,0,0,0.05);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #555;
}

/* Modern Utility Grid */
.utility-grid-modern {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  padding-bottom: 120rpx;
}

.utility-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 16rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.03);
  transition: transform 0.2s;
}

.utility-item:active {
  transform: scale(0.96);
}

.utility-icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.03);
}

.utility-icon {
  font-size: 48rpx;
}

.utility-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #444;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.coming-soon {
  opacity: 0.7;
  border: 2px dashed rgba(0,0,0,0.08);
  background: transparent;
  box-shadow: none;
}

.coming-soon .utility-icon-box {
  background: rgba(0,0,0,0.03) !important;
}

/* Hide original grid styles to avoid conflict if any remain */
.toolbox-grid {
  display: none;
}

/* Animations */
@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

@keyframes wiggle {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-10deg); }
  75% { transform: rotate(10deg); }
}

@keyframes breathe {
  0%, 100% { transform: scale(1); filter: brightness(100%); }
  50% { transform: scale(0.85); filter: brightness(110%); }
}

@keyframes spin-slow {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.tool-icon.pulse { animation: pulse 2s infinite ease-in-out; }
.tool-icon.wiggle { animation: wiggle 1.5s infinite ease-in-out; }
.tool-icon.breathe { animation: breathe 2s infinite ease-in-out; }
.tool-icon.spin-slow { animation: spin-slow 8s infinite linear; }
.tool-icon.bounce { animation: bounce 2s infinite ease-in-out; }
.tool-icon.float { animation: float 3s infinite ease-in-out; }