/* pages/my-collections/my-collections.wxss */

/* Global Page Setup */
.page-root {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  background-color: #F2F4F8;
  overflow-x: hidden;
}

/* Ambient Diffused Background */
.ambient-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.7;
}

.orb-1 {
  width: 600rpx;
  height: 600rpx;
  background: #E0C3FC; /* Soft Purple */
  top: -150rpx;
  left: -100rpx;
  animation: float 10s infinite ease-in-out;
}

.orb-2 {
  width: 500rpx;
  height: 500rpx;
  background: #FFD1FF; /* Soft Pink */
  bottom: 10%;
  right: -100rpx;
  animation: float 12s infinite ease-in-out reverse;
}

.orb-3 {
  width: 400rpx;
  height: 400rpx;
  background: #D4F1F4; /* Soft Blue */
  top: 40%;
  left: 20%;
  animation: float 15s infinite ease-in-out 2s;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(20rpx, 30rpx); }
}

.container {
  position: relative;
  z-index: 1;
  padding: 30rpx;
  box-sizing: border-box;
}

.loading {
  text-align: center;
  margin-top: 200rpx;
  color: #999;
  font-size: 28rpx;
}

/* 列表样式 (List Style - Single Column) */
.collection-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card {
  display: flex; /* Flex Layout for Horizontal Card */
  flex-direction: row;
  padding: 24rpx; /* Add padding to contain rounded image */
  height: 240rpx; /* Adjusted height for padding */
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
  box-sizing: border-box; /* Ensure padding includes in height */
}

.card:active {
  transform: scale(0.98);
}

.card-img {
  width: 192rpx; /* Square size */
  height: 192rpx;
  border-radius: 24rpx; /* Rounded corners - Increased for better look */
  background-color: rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  padding-left: 24rpx; /* Space between img and text */
  padding-right: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-author {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.author-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #ddd;
  margin-right: 12rpx;
}

.card-author text {
  font-size: 26rpx;
  color: #888;
}

.card-heat {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #ff6b00;
  font-weight: 500;
  margin-top: 4rpx;
}

.heat-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 34rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.empty-tips {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.go-home-btn {
  background: #333;
  color: #fff;
  font-size: 30rpx;
  padding: 20rpx 80rpx;
  border-radius: 100rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: opacity 0.2s;
}

.go-home-btn:active {
  opacity: 0.9;
}
