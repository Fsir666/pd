<!-- custom-tab-bar/index.wxml -->
<view class="custom-tabbar">
  <!-- 背景容器 -->
  <view class="tab-bar-bg"></view>

  <!-- 光标 -->
  <view class="tab-cursor {{isDragging ? 'no-transition' : ''}}" style="left: calc({{cursorLeft}} + 12.5% - {{cursorWidth}} / 2); width: {{cursorWidth}};"></view>
  
  <!-- 图标和文字层 -->
  <view class="tab-content-container">
    <view class="tab-item {{selected === 0 ? 'active' : ''}}">
      <view class="tab-text {{hoverIndex === 0 ? 'hover-text' : ''}}">首页</view>
    </view>
    
    <view class="tab-item {{selected === 1 ? 'active' : ''}}">
      <view class="tab-text {{hoverIndex === 1 ? 'hover-text' : ''}}">社区</view>
    </view>
    
    <view class="tab-item {{selected === 2 ? 'active' : ''}}">
      <view class="tab-text {{hoverIndex === 2 ? 'hover-text' : ''}}">广场</view>
    </view>
    
    <view class="tab-item {{selected === 3 ? 'active' : ''}}">
      <view class="tab-text {{hoverIndex === 3 ? 'hover-text' : ''}}">我的</view>
    </view>
  </view>

  <!-- 触摸事件层 (放在最后以覆盖所有元素) -->
  <view class="touch-layer" 
    bindtouchstart="handleTabStart" 
    bindtouchmove="handleTabDrag" 
    bindtouchend="handleTabEnd" 
    bindtouchcancel="handleTabCancel">
  </view>
</view>
