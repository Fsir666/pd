<view class="page-root">
  <view class="ambient-bg">
    <view class="orb orb-1"></view>
    <view class="orb orb-2"></view>
    <view class="orb orb-3"></view>
  </view>

  <scroll-view scroll-y class="scroll">
    <view class="container">
      <view class="hero glass-card">
        <text class="hero-title">{{hero.title}}</text>
        <text class="hero-subtitle">{{hero.subtitle}}</text>
      </view>

      <view class="quick glass-card">
        <view class="section-head">
          <text class="section-title">✅ 快速上手</text>
        </view>
        <view class="bullets">
          <view class="bullet" wx:for="{{quickStart}}" wx:key="*this">
            <view class="dot"></view>
            <text class="bullet-text">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="content">
        <view class="guide-card glass-card" wx:for="{{sections}}" wx:for-item="section" wx:key="title">
          <view class="section-head">
            <text class="section-title">{{section.title}}</text>
          </view>
          <view class="rows">
            <view class="row" wx:for="{{section.items}}" wx:for-item="entry" wx:key="label">
              <view class="row-label">{{entry.label}}</view>
              <view class="row-text">{{entry.text}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="footer">
        <text class="footer-text">做完第一件作品后，建议从“简单头像/徽章/钥匙扣”继续练习。</text>
      </view>
    </view>
  </scroll-view>
</view>

<!-- 全局隐私授权弹窗 -->
<privacy-popup />
