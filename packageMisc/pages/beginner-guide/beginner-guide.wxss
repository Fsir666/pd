.page-root {
  position: relative;
  width: 100vw;
  height: 100vh;
  background-color: #F2F4F8;
  overflow: hidden;
}

.ambient-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.7;
}

.orb-1 {
  width: 600rpx;
  height: 600rpx;
  background: #E0C3FC;
  top: -150rpx;
  left: -100rpx;
  animation: float 10s infinite ease-in-out;
}

.orb-2 {
  width: 500rpx;
  height: 500rpx;
  background: #FFD1FF;
  bottom: 10%;
  right: -100rpx;
  animation: float 12s infinite ease-in-out reverse;
}

.orb-3 {
  width: 400rpx;
  height: 400rpx;
  background: #D4F1F4;
  top: 40%;
  left: 20%;
  animation: float 15s infinite ease-in-out 2s;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(20rpx, 30rpx); }
}

.scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
}

.container {
  padding: 24rpx 24rpx 60rpx;
}

.glass-card {
  background: rgba(255, 255, 255, 0.50);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.05);
  border-radius: 32rpx;
}

.hero {
  padding: 28rpx 28rpx 26rpx;
  margin-bottom: 18rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1d1d1f;
  display: block;
  letter-spacing: -0.6px;
}

.hero-subtitle {
  font-size: 26rpx;
  color: rgba(29, 29, 31, 0.65);
  margin-top: 10rpx;
  display: block;
}

.quick {
  padding: 22rpx 24rpx 16rpx;
  margin-bottom: 18rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1d1d1f;
  letter-spacing: -0.4px;
}

.bullets {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.bullet {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  margin-top: 10rpx;
  flex-shrink: 0;
}

.bullet-text {
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(29, 29, 31, 0.78);
}

.content {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.guide-card {
  padding: 22rpx 24rpx 10rpx;
}

.rows {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.row {
  display: flex;
  gap: 16rpx;
}

.row-label {
  width: 160rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(29, 29, 31, 0.86);
  flex-shrink: 0;
}

.row-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(29, 29, 31, 0.74);
}

.footer {
  padding: 26rpx 6rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(29, 29, 31, 0.55);
  text-align: center;
  line-height: 1.6;
}

