<view class="container">
  <view class="header">开发者工具</view>
  
  <view class="tool-grid">
    <view class="tool-card" bindtap="goToAddTemplate">
      <view class="tool-icon">📝</view>
      <view class="tool-name">添加图纸</view>
      <view class="tool-desc">上传新的拼豆图纸到数据库</view>
    </view>
    
    <!-- Future tools can be added here -->
    <!-- 
    <view class="tool-card">
      <view class="tool-icon">📊</view>
      <view class="tool-name">数据统计</view>
      <view class="tool-desc">查看用户活跃度</view>
    </view>
    -->
  </view>

  <!-- iOS 26 悬浮导航栏 (Custom Floating TabBar) -->
  <view class="custom-tabbar" bindtouchstart="handleTabStart" bindtouchmove="handleTabDrag" bindtouchend="handleTabEnd" bindtouchcancel="handleTabCancel">
    <view class="tab-cursor {{isDragging ? 'no-transition' : ''}}" style="left: {{cursorLeft}};"></view>
    <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">首页</view>
    <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">社区</view>
    <view class="tab-item {{currentTab === 2 ? 'active' : ''}}" bindtap="switchTab" data-index="2">广场</view>
    <view class="tab-item {{currentTab === 3 ? 'active' : ''}}" bindtap="switchTab" data-index="3">我的</view>
  </view>
</view>

<!-- 全局隐私授权弹窗 -->
<privacy-popup />
