<view class="container">
  <view class="card">
    <view class="card-title">添加图纸</view>
    
    <view class="form-item">
      <text class="label">标题</text>
      <input class="input" placeholder="请输入标题" data-field="title" bindinput="onInput" value="{{form.title}}" />
    </view>
    
    <view class="form-item">
      <text class="label">作者</text>
      <input class="input" placeholder="请输入作者" data-field="author" bindinput="onInput" value="{{form.author}}" />
    </view>

    <view class="form-item">
      <text class="label">描述</text>
      <textarea class="textarea" placeholder="请输入描述" data-field="description" bindinput="onInput" value="{{form.description}}" auto-height />
    </view>

    <view class="form-row">
      <view class="form-item half">
        <text class="label">尺寸 (如32x32)</text>
        <input class="input" placeholder="32x32" data-field="size" bindinput="onInput" value="{{form.size}}" />
      </view>
      <view class="form-item half">
        <text class="label">难度 (1-5)</text>
        <slider min="1" max="5" show-value data-field="difficulty" bindchange="onSliderChange" value="{{difficultyNum}}" />
      </view>
    </view>
    
    <view class="form-item">
      <text class="label">图片</text>
      <view class="image-uploader" bindtap="chooseImage">
        <image wx:if="{{tempImagePath}}" src="{{tempImagePath}}" mode="aspectFit" class="preview-image" />
        <view wx:else class="upload-placeholder">
          <text class="plus">+</text>
          <text class="tip">点击上传图片</text>
        </view>
      </view>
    </view>

    <button class="submit-btn" type="primary" bindtap="submitTemplate" loading="{{loading}}">提交图纸</button>
  </view>
</view>
<privacy-popup />
