.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #FAF7F3;
}

/* 顶部栏 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 88rpx 28rpx 20rpx;
  background: #FAF7F3;
}
.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-icon {
  font-size: 52rpx;
  color: #3A2A2E;
  line-height: 1;
}
.topbar-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A2A2E;
}
.topbar-right {
  width: 64rpx;
}

/* 状态提示 */
.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 180rpx 60rpx;
  text-align: center;
}
.state-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.state-title { font-size: 30rpx; color: #3A2A2E; font-weight: 600; }
.state-sub { font-size: 26rpx; color: #9A8A86; margin-top: 12rpx; }
.state-btn {
  margin-top: 40rpx;
  padding: 18rpx 56rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #FF8A3D, #FF6B00);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 分组标题 */
.section-label {
  padding: 20rpx 36rpx 16rpx;
  font-size: 24rpx;
  color: #A08C88;
}

/* 菜单组 */
.menu-group {
  margin: 0 28rpx;
  background: #FFFDFB;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(176, 138, 128, 0.08);
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: #FFFDFB;
  transition: background 0.2s;
}
.item-left {
  display: flex;
  align-items: center;
}
.icon-box {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.color-orange { background: #D89A5C; }
.color-orange .menu-icon { filter: brightness(100); }
.menu-icon {
  font-size: 34rpx;
  color: #FFFDFB;
}
.item-texts {
  display: flex;
  flex-direction: column;
}
.item-title {
  font-size: 32rpx;
  color: #4A3A3E;
  font-weight: 500;
}
.item-sub {
  font-size: 23rpx;
  color: #A08C88;
  margin-top: 6rpx;
}
.item-right {
  display: flex;
  align-items: center;
}
.icon-chevron::after {
  content: '';
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #C2B4B4;
  border-right: 4rpx solid #C2B4B4;
  transform: rotate(45deg);
  margin-right: 6rpx;
}

/* 底部提示 */
.tips {
  margin-top: 36rpx;
  text-align: center;
  font-size: 24rpx;
  color: #C2B4B4;
}

.hover-scale {
  transform: scale(0.98);
  opacity: 0.85;
  transition: all 0.15s cubic-bezier(0.25, 0.1, 0.25, 1);
}
