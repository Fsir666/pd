page {
  background-color: var(--ym-bg, #FBF7F2);
}

.page-container {
  padding: 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.contact-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  background: var(--ym-surface, #FFFDFB);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 58, 62, 0.06);
}

.header-icon {
  font-size: 60rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ym-text, #4A3A3E);
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 28rpx;
  color: var(--ym-text-sub, #9B8A8C);
}

/* Menu Group */
.menu-group {
  background: var(--ym-surface, #FFFDFB);
  border-radius: var(--ym-r-lg, 26rpx);
  overflow: hidden;
  margin-bottom: 60rpx;
  box-shadow: 0 2rpx 12rpx rgba(74, 58, 62, 0.05);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: var(--ym-surface, #FFFDFB);
  position: relative;
}

.menu-item:active {
  background: var(--ym-primary-wash, #F6E9E4);
}

.menu-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 32rpx;
  right: 0;
  height: 1rpx;
  background: var(--ym-line, #F0E4DC);
}

.item-title {
  font-size: 30rpx;
  color: var(--ym-text, #4A3A3E);
}

.item-arrow {
  color: var(--ym-text-faint, #C2B4B4);
  font-size: 32rpx;
}

/* Button */
.contact-btn {
  background: linear-gradient(135deg, #D4607A, #E07A8E);
  color: #FFFFFF;
  border-radius: 50rpx;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 30rpx rgba(212, 96, 122, 0.3);
}

.contact-btn::after {
  border: none;
}

.btn-icon {
  margin-right: 16rpx;
  font-size: 36rpx;
}
