/* custom-tab-bar/index.wxss */
.custom-tabbar {
  position: fixed;
  bottom: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 5%;
  width: 90%;
  height: 100rpx; /* 减小高度，适应纯文字 */
  z-index: 9999;
  box-sizing: border-box;
}

.tab-bar-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.62);
  backdrop-filter: blur(32px) saturate(180%);
  -webkit-backdrop-filter: blur(32px) saturate(180%);
  border-radius: 60rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.09);
  overflow: hidden;
  z-index: 1;
}

.tab-bar-bg::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 24rpx;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.tab-bar-bg::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0) 58%),
    radial-gradient(circle at 50% 100%, rgba(0, 0, 0, 0.06), rgba(0, 0, 0, 0) 60%);
  pointer-events: none;
}

.tab-cursor {
  position: absolute;
  top: 15rpx;
  bottom: 15rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.52));
  backdrop-filter: blur(18px) saturate(180%);
  -webkit-backdrop-filter: blur(18px) saturate(180%);
  border-radius: 48rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  transition: left 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), width 0.25s ease;
  z-index: 2;
  box-shadow:
    0 8rpx 24rpx rgba(0, 0, 0, 0.10),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.90),
    inset 0 -10rpx 20rpx rgba(255, 255, 255, 0.20);
}

.tab-cursor.no-transition {
  transition: none !important;
}

.tab-content-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: space-around;
  align-items: center;
  z-index: 3;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: row; /* 改为行布局，虽然只有一个子元素 */
  justify-content: center;
  align-items: center;
}

.tab-text {
  font-size: 28rpx;
  line-height: 1; /* 紧凑行高 */
  font-weight: 500;
  text-align: center;
  color: #888;
  transition: all 0.3s ease;
  transform: scale(0.95);
  margin: 0; /* 彻底清除边距 */
  padding-bottom: 0; /* 移除底部 padding，确保完全垂直居中 */
  /* 如果字体本身有偏下，可以微调 transform-origin */
}

.tab-item.active .tab-text {
  color: #333;
  font-weight: 600;
  transform: scale(1.1);
}

/* 扫光效果 */
.tab-text.hover-text {
  color: #333;
  transform: scale(1.1);
}

.touch-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 99;
  background: transparent;
}
