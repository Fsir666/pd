<view class="container">
  <view class="header-bar" style="padding-top: {{safeAreaTop}}px; height: {{headerBarHeight}}px;">
    <view class="header-left">
      <view class="back-button" bindtap="onBack">
        <text class="back-icon">←</text>
      </view>
    </view>
    <view class="header-center">
      <text class="header-title">拼豆模式</text>
      <view class="coord-display" wx:if="{{isDrawMode}}">
        <text class="coord-label">坐标:</text>
        <text class="coord-value">X: {{currentCoordX}}, Y: {{currentCoordY}}</text>
      </view>
    </view>
    <view class="header-right">
      <view class="header-placeholder"></view>
    </view>
  </view>
  
  <view class="x-axis" style="top: {{headerHeight}}px; left: {{yAxisWidth}}px;">
    <view class="x-axis-label" wx:for="{{xAxisLabels}}" wx:key="index" style="left: {{item.screenX - yAxisWidth}}px;" bindtap="onXAxisTap" data-value="{{item.value}}">
      <view class="x-axis-tick {{item.tickType}}"></view>
      <text class="axis-text {{item.tickType}} {{item.isHighlighted ? 'highlighted' : ''}}">{{item.value}}</text>
    </view>
  </view>
  
  <view class="y-axis" style="top: {{headerHeight + xAxisHeight}}px; width: {{yAxisWidth}}px; height: calc(100vh - {{headerHeight + xAxisHeight}}px);">
    <view class="y-axis-label" wx:for="{{yAxisLabels}}" wx:key="index" style="top: {{item.relativeY}}px;" bindtap="onYAxisTap" data-value="{{item.value}}">
      <view class="y-axis-tick {{item.tickType}}"></view>
      <text class="axis-text {{item.tickType}} {{item.isHighlighted ? 'highlighted' : ''}}">{{item.value}}</text>
    </view>
  </view>
  
  <view class="canvas-container" style="left: {{yAxisWidth}}px; top: {{headerHeight + xAxisHeight}}px; width: {{canvasWidth}}px; height: {{canvasHeight}}px;" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
    <canvas type="2d" id="beadBoard" style="width: 100%; height: 100%;" />
  </view>
  
  <view class="mini-map-container" wx:if="{{showMiniMap && miniMapBeadCount > 0 && !showColorPalette && !showSettings}}" bindtap="onMiniMapTap">
    <canvas type="2d" id="miniMapCanvas" style="width: {{miniMapSize}}px; height: {{miniMapSize}}px;" />
  </view>
  
  <!-- 画笔设置面板遮罩 - 放在ui-overlay外面确保点击生效 -->
  <view class="brush-settings-mask" wx:if="{{showBrushSettings}}" bindtap="closeBrushSettings" catchtouchmove="preventTouchMove"></view>

  <!-- 画笔设置面板 - 放在ui-overlay外面 -->
  <view class="brush-settings-popup {{showBrushSettings ? 'show' : ''}}" wx:if="{{showBrushSettings}}" style="left: {{brushSettingsX}}px; bottom: calc(100vh - {{brushSettingsY}}px + 50px);">
    <view class="brush-settings-arrow" style="left: 50%; transform: translateX(-50%);"></view>
    <view class="brush-settings-content" catchtap="preventClose">
      <view class="brush-settings-header">
        <text class="brush-settings-title">{{brushSettingsTarget === 'brush' ? '✏️ 画笔设置' : '🧹 橡皮设置'}}</text>
      </view>

      <!-- 画笔大小 - 滑动条 -->
      <view class="brush-settings-section">
        <view class="brush-size-header">
          <text class="brush-settings-label">画笔大小</text>
          <text class="brush-size-value">{{brushSize}}</text>
        </view>
        <view class="brush-size-slider-container">
          <text class="brush-size-min">1</text>
          <slider class="brush-size-slider" min="1" max="10" value="{{brushSize}}" show-value="{{false}}" block-size="20" activeColor="#007aff" backgroundColor="#e5e5ea" bindchange="onBrushSizeChange" bindchanging="onBrushSizeChanging"/>
          <text class="brush-size-max">10</text>
        </view>
      </view>

      <!-- 画笔形状 -->
      <view class="brush-settings-section" wx:if="{{brushSettingsTarget === 'brush'}}">
        <text class="brush-settings-label">画笔形状</text>
        <view class="brush-shape-options">
          <view class="brush-shape-option {{brushShape === 'square' ? 'active' : ''}}" data-shape="square" bindtap="setBrushShape">
            <view class="brush-shape-preview shape-square"></view>
            <text class="brush-shape-label">方形</text>
          </view>
          <view class="brush-shape-option {{brushShape === 'cross' ? 'active' : ''}}" data-shape="cross" bindtap="setBrushShape">
            <view class="brush-shape-preview shape-cross"></view>
            <text class="brush-shape-label">十字</text>
          </view>
        </view>
      </view>

      <!-- 对称绘制 -->
      <view class="brush-settings-section" wx:if="{{brushSettingsTarget === 'brush'}}">
        <text class="brush-settings-label">对称绘制</text>
        <view class="symmetry-options">
          <view class="symmetry-option {{symmetryMode === 'none' ? 'active' : ''}}" data-mode="none" bindtap="setSymmetryMode">
            <text class="symmetry-icon">✕</text>
          </view>
          <view class="symmetry-option {{symmetryMode === 'horizontal' ? 'active' : ''}}" data-mode="horizontal" bindtap="setSymmetryMode">
            <text class="symmetry-icon">↔</text>
          </view>
          <view class="symmetry-option {{symmetryMode === 'vertical' ? 'active' : ''}}" data-mode="vertical" bindtap="setSymmetryMode">
            <text class="symmetry-icon">↕</text>
          </view>
          <view class="symmetry-option {{symmetryMode === 'quad' ? 'active' : ''}}" data-mode="quad" bindtap="setSymmetryMode">
            <text class="symmetry-icon">✚</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="ui-overlay">
    <view class="toolbar-container" wx:if="{{!showColorPalette && !showSettings}}">
      <view class="water-drop-wrapper">
        <view class="toggle-btn-top" bindtap="toggleToolbar">
          <text class="toggle-arrow {{toolbarExpanded ? 'expanded' : ''}}">∧</text>
        </view>
        
        <view class="toolbar-capsule">
          <view class="tooltip-wrapper {{tooltipSide === 'left' ? 'tooltip-left' : ''}} {{tooltipSide === 'center' ? 'tooltip-center' : ''}} {{tooltipSide === 'right' ? 'tooltip-right' : ''}}">
            <view class="tooltip {{showTooltip ? 'show' : ''}}">{{tooltipText}}</view>
          </view>
          
          <view
            class="quick-btn quick-btn-left {{dragTarget === 'left' ? 'drop-target' : ''}} {{draggingTool && quickButtons.left.id === draggingTool.id ? 'dragging' : ''}} {{isDrawMode && !eraserMode && quickButtons.left.id === 'brush' ? 'active' : ''}} {{eraserMode && quickButtons.left.id === 'eraser' ? 'active' : ''}}"
            data-side="left"
            bindtap="onQuickButtonTap"
            bindlongpress="onQuickButtonLongPress"
            bindtouchmove="onQuickButtonTouchMove"
            bindtouchend="onQuickButtonTouchEnd">
            <view wx:if="{{quickButtons.left.id === 'palette' && selectedColor}}" class="quick-btn-color" style="background-color: {{selectedColor.hex}};"></view>
            <view wx:else class="quick-btn-icon {{quickButtons.left.iconClass}}"></view>
            <view wx:if="{{isDrawMode && !eraserMode && selectedColor && quickButtons.left.id === 'brush'}}" class="quick-btn-color-indicator" style="background-color: {{selectedColor.hex}};"></view>
          </view>

          <view
            class="quick-btn quick-btn-center {{dragTarget === 'center' ? 'drop-target' : ''}} {{draggingTool && quickButtons.center.id === draggingTool.id ? 'dragging' : ''}} {{isDrawMode && !eraserMode && quickButtons.center.id === 'brush' ? 'active' : ''}} {{eraserMode && quickButtons.center.id === 'eraser' ? 'active' : ''}}"
            data-side="center"
            bindtap="onQuickButtonTap"
            bindlongpress="onQuickButtonLongPress"
            bindtouchmove="onQuickButtonTouchMove"
            bindtouchend="onQuickButtonTouchEnd">
            <view wx:if="{{quickButtons.center.id === 'palette' && selectedColor}}" class="quick-btn-color" style="background-color: {{selectedColor.hex}};"></view>
            <view wx:else class="quick-btn-icon {{quickButtons.center.iconClass}}"></view>
            <view wx:if="{{isDrawMode && !eraserMode && selectedColor && quickButtons.center.id === 'brush'}}" class="quick-btn-color-indicator" style="background-color: {{selectedColor.hex}};"></view>
          </view>

          <view
            class="quick-btn quick-btn-right {{dragTarget === 'right' ? 'drop-target' : ''}} {{draggingTool && quickButtons.right.id === draggingTool.id ? 'dragging' : ''}} {{isDrawMode && !eraserMode && quickButtons.right.id === 'brush' ? 'active' : ''}} {{eraserMode && quickButtons.right.id === 'eraser' ? 'active' : ''}}"
            data-side="right"
            bindtap="onQuickButtonTap"
            bindlongpress="onQuickButtonLongPress"
            bindtouchmove="onQuickButtonTouchMove"
            bindtouchend="onQuickButtonTouchEnd">
            <view wx:if="{{quickButtons.right.id === 'palette' && selectedColor}}" class="quick-btn-color" style="background-color: {{selectedColor.hex}};"></view>
            <view wx:else class="quick-btn-icon {{quickButtons.right.iconClass}}"></view>
            <view wx:if="{{isDrawMode && !eraserMode && selectedColor && quickButtons.right.id === 'brush'}}" class="quick-btn-color-indicator" style="background-color: {{selectedColor.hex}};"></view>
          </view>
        </view>
      </view>
      
      <view class="toolbar-panel {{toolbarExpanded ? 'expanded' : ''}}">
        <view class="toolbar-scroll">
          <view class="toolbar-tools">
            <view
              class="toolbar-tool {{dragTarget === 'tool_' + item.id ? 'drop-target' : ''}} {{draggingTool && draggingTool.id === item.id ? 'dragging' : ''}} {{isDrawMode && !eraserMode && item.id === 'brush' ? 'active' : ''}} {{eraserMode && item.id === 'eraser' ? 'active' : ''}}"
              wx:for="{{toolbarTools}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="onToolbarToolTap"
              bindlongpress="onToolLongPress"
              bindtouchmove="onToolTouchMove"
              bindtouchend="onToolTouchEnd">
              <view class="tool-content">
                <view class="tool-icon {{item.iconClass}}"></view>
                <text class="tool-label">{{item.name}}</text>
              </view>
              <view wx:if="{{isDrawMode && !eraserMode && selectedColor && item.id === 'brush'}}" class="toolbar-tool-color" style="background-color: {{selectedColor.hex}};"></view>
            </view>
          </view>
        </view>
      </view>
      
      <view class="dragging-indicator" wx:if="{{draggingTool}}">
        <view class="dragging-tool" style="left: {{dragCurrentX - 40}}px; top: {{dragCurrentY - 40}}px;">
          <view class="dragging-icon {{draggingTool.iconClass}}"></view>
        </view>
      </view>
    </view>
  </view>
  
  <view class="color-palette-mask" wx:if="{{showColorPalette}}" bindtap="closeColorPalette" catchtouchmove="preventTouchMove">
    <view class="color-palette" catchtap="preventClose" catchtouchmove="preventTouchMove">
      <view class="palette-header">
        <view class="palette-search-mini" wx:if="{{!isSearching}}" bindtap="startSearch">
          <text class="search-icon-mini">🔍</text>
          <text class="search-placeholder-mini">搜索色号...</text>
        </view>
        <view class="palette-search-active" wx:if="{{isSearching}}">
          <text class="search-icon-mini">🔍</text>
          <input class="search-input-mini" placeholder="搜索色号..." value="{{searchKeyword}}" bindinput="onSearchInput" focus="{{isSearching}}" />
          <view class="search-clear-mini" bindtap="clearSearch" wx:if="{{searchKeyword}}">✕</view>
        </view>
        <view class="palette-toggle-btn" bindtap="toggleBrandColumn">
          <text class="toggle-icon">{{brandColumnExpanded ? '◀' : '▶'}}</text>
          <text class="toggle-text">{{brandColumnExpanded ? '收起' : '品牌'}}</text>
        </view>
        <view class="palette-close" bindtap="closeColorPalette">✕</view>
      </view>
      
      <view class="palette-body" wx:if="{{!isSearching}}">
        <view class="palette-column brand-series-column {{brandColumnExpanded ? 'expanded' : 'collapsed'}}">
          <view class="column-header">品牌 & 色卡</view>
          <scroll-view scroll-y class="column-scroll">
            <view class="brand-group {{expandedBrands[item.id] ? 'expanded' : ''}}" wx:for="{{brands}}" wx:key="id">
              <view class="brand-header" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="toggleBrandExpand">
                <view class="brand-info">
                  <view class="brand-name">{{item.name}}</view>
                  <view class="brand-count">{{item.seriesCount}} 个色卡</view>
                </view>
                <view class="brand-arrow">▶</view>
              </view>
              <view class="series-list" wx:if="{{expandedBrands[item.id]}}">
                <view class="series-card {{selectedSeries && selectedSeries.id === series.id ? 'selected' : ''}}" wx:for="{{item.seriesList}}" wx:key="id" wx:for-item="series" data-id="{{series.id}}" data-name="{{series.name}}" bindtap="selectSeries">
                  <view class="series-info">
                    <view class="series-name">{{series.name}}</view>
                    <view class="series-count">{{series.colors}} 色</view>
                  </view>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
        
        <view class="palette-column color-column {{brandColumnExpanded ? 'narrow' : 'wide'}}">
          <view class="column-header">颜色</view>
          <scroll-view scroll-y class="column-scroll" wx:if="{{(selectedSeries && groupedColors.length > 0) || recentColors.length > 0}}">
            <view class="recent-section" wx:if="{{recentColors.length > 0}}">
              <view class="section-header">
                <text class="section-title">最近使用</text>
                <text class="section-count">{{recentColors.length}} 色</text>
              </view>
              <view class="color-grid {{brandColumnExpanded ? 'grid-7' : 'grid-10'}}">
                <view class="color-item" wx:for="{{recentColors}}" wx:key="hex" data-hex="{{item.hex}}" data-code="{{item.code}}" data-series="{{item.series}}" bindtap="selectColor">
                  <view class="color-circle" style="background-color: {{item.hex}};"></view>
                  <text class="color-code">{{item.code}}</text>
                </view>
              </view>
              <view class="section-divider" wx:if="{{selectedSeries && groupedColors.length > 0}}"></view>
            </view>
            
            <view class="color-section" wx:for="{{groupedColors}}" wx:key="name" wx:if="{{selectedSeries && groupedColors.length > 0}}">
              <view class="section-header" data-series="{{item.name}}" bindtap="toggleSeriesExpand">
                <text class="section-title">{{item.name}}</text>
                <text class="section-count">{{item.colors.length}} 色</text>
                <text class="section-toggle">{{item.expanded ? '收起' : '展开'}}</text>
              </view>
              <view class="color-grid {{brandColumnExpanded ? 'grid-7' : 'grid-10'}}" wx:if="{{item.expanded}}">
                <view class="color-item" wx:for="{{item.colors}}" wx:key="code" wx:for-item="color" 
                      data-hex="{{color.hex}}" 
                      data-code="{{color.code}}" 
                      data-series="{{color.series}}" 
                      bindtap="selectColor">
                  <view class="color-circle" style="background-color: {{color.hex}};"></view>
                  <text class="color-code">{{color.code}}</text>
                </view>
              </view>
            </view>
          </scroll-view>
          <view class="column-empty" wx:if="{{!selectedSeries && groupedColors.length === 0 && recentColors.length === 0}}">
            <text class="empty-text">请选择品牌和色卡</text>
          </view>
        </view>
      </view>
      
      <view class="palette-body search-body" wx:if="{{isSearching}}">
        <view class="search-results" wx:if="{{searchResults.length > 0}}">
          <view class="search-result-count">找到 {{searchResults.length}} 个结果</view>
          <view class="search-result-card" wx:for="{{searchResults}}" wx:key="code" data-hex="{{item.hex}}" data-code="{{item.code}}" data-series="{{item.series}}" bindtap="selectColor">
            <view class="result-color" style="background-color: {{item.hex}};"></view>
            <view class="result-info">
              <view class="result-code">{{item.code}}</view>
              <view class="result-detail">{{item.brand}} · {{item.seriesId}} · {{item.series}} · {{item.hex}}</view>
            </view>
            <view class="result-action">点击选择</view>
          </view>
        </view>
        <view class="search-empty" wx:elif="{{searchKeyword}}">
          <text class="search-empty-icon">🔍</text>
          <text class="search-empty-text">未找到相关颜色</text>
          <text class="search-empty-tip">请尝试其他关键词</text>
        </view>
        <view class="search-empty" wx:else>
          <text class="search-empty-icon">🔍</text>
          <text class="search-empty-text">输入色号开始搜索</text>
        </view>
      </view>
    </view>
  </view>
  
  <view class="settings-mask" wx:if="{{showSettings}}" bindtap="closeSettings" catchtouchmove="preventTouchMove">
    <view class="settings-panel" catchtap="preventClose">
      <view class="settings-header">
        <text class="settings-title">设置</text>
        <view class="settings-close" bindtap="closeSettings">
          <text class="close-icon">✕</text>
        </view>
      </view>
      
      <scroll-view class="settings-body" scroll-y style="height: 600rpx;">
        <!-- 显示设置 - iOS 风格分组 -->
        <view class="ios-section">
          <view class="ios-section-header">显示</view>
          <view class="ios-group">
            <view class="ios-cell {{showGridLines ? 'active' : ''}}" bindtap="toggleGridLines">
              <view class="ios-cell-icon" style="background: #007aff;">
                <text class="ios-icon-text">▦</text>
              </view>
              <view class="ios-cell-content">
                <text class="ios-cell-title">网格线</text>
              </view>
              <view class="ios-cell-accessory">
                <view class="ios-toggle {{showGridLines ? 'on' : ''}}">
                  <view class="ios-toggle-knob"></view>
                </view>
              </view>
            </view>
            <view class="ios-cell {{showCenterCross ? 'active' : ''}}" bindtap="toggleCenterCross">
              <view class="ios-cell-icon" style="background: #ff9500;">
                <text class="ios-icon-text">✚</text>
              </view>
              <view class="ios-cell-content">
                <text class="ios-cell-title">十字线</text>
              </view>
              <view class="ios-cell-accessory">
                <view class="ios-toggle {{showCenterCross ? 'on' : ''}}">
                  <view class="ios-toggle-knob"></view>
                </view>
              </view>
            </view>
            <view class="ios-cell {{showMiniMap ? 'active' : ''}}" bindtap="toggleMiniMapSwitch">
              <view class="ios-cell-icon" style="background: #af52de;">
                <text class="ios-icon-text">🗺</text>
              </view>
              <view class="ios-cell-content">
                <text class="ios-cell-title">小地图</text>
              </view>
              <view class="ios-cell-accessory">
                <view class="ios-toggle {{showMiniMap ? 'on' : ''}}">
                  <view class="ios-toggle-knob"></view>
                </view>
              </view>
            </view>
            <view class="ios-cell {{showAreaBorder ? 'active' : ''}}" bindtap="toggleAreaBorder">
              <view class="ios-cell-icon" style="background: #007aff;">
                <text class="ios-icon-text">▢</text>
              </view>
              <view class="ios-cell-content">
                <text class="ios-cell-title">区域边框</text>
              </view>
              <view class="ios-cell-accessory">
                <view class="ios-toggle {{showAreaBorder ? 'on' : ''}}">
                  <view class="ios-toggle-knob"></view>
                </view>
              </view>
            </view>
            <view class="ios-cell {{showColorCodes ? 'active' : ''}}" bindtap="toggleColorCodes">
              <view class="ios-cell-icon" style="background: #34c759;">
                <text class="ios-icon-text">🏷</text>
              </view>
              <view class="ios-cell-content">
                <text class="ios-cell-title">色号显示</text>
              </view>
              <view class="ios-cell-accessory">
                <view class="ios-toggle {{showColorCodes ? 'on' : ''}}">
                  <view class="ios-toggle-knob"></view>
                </view>
              </view>
            </view>
          </view>
        </view>
        
        <!-- 拼豆区域边框颜色 -->
        <view class="ios-section" wx:if="{{showAreaBorder}}">
          <view class="ios-section-header">区域边框颜色</view>
          <view class="ios-group">
            <view class="ios-cell" bindtap="openBorderColorPicker">
              <view class="ios-cell-content">
                <text class="ios-cell-title">颜色</text>
              </view>
              <view class="ios-cell-accessory">
                <view class="ios-color-dot" style="background-color: {{areaBorderColors[areaBorderColor]}};"></view>
                <text class="ios-cell-value">{{areaBorderColorNames[areaBorderColor]}}</text>
                <text class="ios-chevron">›</text>
              </view>
            </view>
          </view>
        </view>
        
        <!-- 网格线颜色 -->
        <view class="ios-section">
          <view class="ios-section-header">网格线颜色</view>
          <view class="ios-group">
            <view class="ios-cell" bindtap="openColorPicker">
              <view class="ios-cell-content">
                <text class="ios-cell-title">颜色</text>
              </view>
              <view class="ios-cell-accessory">
                <view class="ios-color-dot" style="background-color: {{gridColors[gridLineColor]}};"></view>
                <text class="ios-cell-value">{{gridLineColorName}}</text>
                <text class="ios-chevron">›</text>
              </view>
            </view>
          </view>
        </view>
        
        <!-- 拼豆形状 -->
        <view class="ios-section">
          <view class="ios-section-header">拼豆形状</view>
          <view class="ios-group">
            <view class="ios-cell" bindtap="openShapePicker">
              <view class="ios-cell-content">
                <text class="ios-cell-title">形状</text>
              </view>
              <view class="ios-cell-accessory">
                <text class="ios-cell-value">{{beadShapeName}}</text>
                <text class="ios-chevron">›</text>
              </view>
            </view>
          </view>
        </view>
        
        <!-- 拼豆区域尺寸 -->
        <view class="ios-section">
          <view class="ios-section-header">拼豆区域</view>
          <view class="ios-group">
            <view class="ios-cell" bindtap="openSizePicker">
              <view class="ios-cell-content">
                <text class="ios-cell-title">尺寸</text>
              </view>
              <view class="ios-cell-accessory">
                <text class="ios-cell-value">{{gridWidth}} × {{gridHeight}}</text>
                <text class="ios-chevron">›</text>
              </view>
            </view>
          </view>
        </view>
        
        <!-- 辅助线 -->
        <view class="ios-section">
          <view class="ios-section-header">辅助线</view>
          <view class="ios-group">
            <view class="ios-cell {{showAuxiliaryLines ? 'active' : ''}}" bindtap="toggleAuxiliaryLines">
              <view class="ios-cell-icon" style="background: #ff9500;">
                <text class="ios-icon-text">┅</text>
              </view>
              <view class="ios-cell-content">
                <text class="ios-cell-title">显示辅助线</text>
              </view>
              <view class="ios-cell-accessory">
                <view class="ios-toggle {{showAuxiliaryLines ? 'on' : ''}}">
                  <view class="ios-toggle-knob"></view>
                </view>
              </view>
            </view>
            <view class="ios-cell" bindtap="openIntervalPicker" wx:if="{{showAuxiliaryLines}}">
              <view class="ios-cell-content">
                <text class="ios-cell-title">间隔</text>
              </view>
              <view class="ios-cell-accessory">
                <text class="ios-cell-value">{{gridCycleInterval}} 格</text>
                <text class="ios-chevron">›</text>
              </view>
            </view>
          </view>
        </view>
        
        <!-- 高亮样式设置 -->
        <view class="ios-section">
          <view class="ios-section-header">高亮样式</view>
          <view class="ios-group">
            <view class="ios-cell" bindtap="openHighlightStylePicker">
              <view class="ios-cell-content">
                <text class="ios-cell-title">高亮类型</text>
              </view>
              <view class="ios-cell-accessory">
