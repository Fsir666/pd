          </view>
          <view class="color-item {{gridLineColor === 'blue' ? 'selected' : ''}}" bindtap="selectGridLineColor" data-color="blue">
            <view class="color-circle" style="background-color: #007aff;"></view>
            <text class="color-text">蓝色</text>
          </view>
          <view class="color-item {{gridLineColor === 'green' ? 'selected' : ''}}" bindtap="selectGridLineColor" data-color="green">
            <view class="color-circle" style="background-color: #34c759;"></view>
