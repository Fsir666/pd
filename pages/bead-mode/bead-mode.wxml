          </view>
          <view class="color-item {{gridLineColor === 'purple' ? 'selected' : ''}}" bindtap="selectGridLineColor" data-color="purple">
            <view class="color-circle" style="background-color: #af52de;"></view>
            <text class="color-text">紫色</text>
          </view>
          <view class="color-item {{gridLineColor === 'orange' ? 'selected' : ''}}" bindtap="selectGridLineColor" data-color="orange">
            <view class="color-circle" style="background-color: #ff9500;"></view>
            <text class="color-text">橙色</text>
          </view>
          <view class="color-item {{gridLineColor === 'red' ? 'selected' : ''}}" bindtap="selectGridLineColor" data-color="red">
            <view class="color-circle" style="background-color: #ff3b30;"></view>
            <text class="color-text">红色</text>
          </view>
        </view>
      </view>
