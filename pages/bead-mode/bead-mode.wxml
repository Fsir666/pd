      <view class="picker-header">
        <text class="picker-title">选择边框颜色</text>
        <view class="picker-close" bindtap="closeBorderColorPicker">✕</view>
      </view>
      <view class="picker-body">
        <view class="color-grid">
          <view class="color-item {{areaBorderColor === 'blue' ? 'selected' : ''}}" bindtap="selectBorderColor" data-color="blue">
            <view class="color-circle" style="background-color: #007aff;"></view>
            <text class="color-text">蓝色</text>
          </view>
          <view class="color-item {{areaBorderColor === 'green' ? 'selected' : ''}}" bindtap="selectBorderColor" data-color="green">
            <view class="color-circle" style="background-color: #34c759;"></view>
            <text class="color-text">绿色</text>
          </view>
          <view class="color-item {{areaBorderColor === 'pink' ? 'selected' : ''}}" bindtap="selectBorderColor" data-color="pink">
            <view class="color-circle" style="background-color: #ff2d55;"></view>
            <text class="color-text">粉色</text>
          </view>
          <view class="color-item {{areaBorderColor === 'purple' ? 'selected' : ''}}" bindtap="selectBorderColor" data-color="purple">
            <view class="color-circle" style="background-color: #af52de;"></view>
            <text class="color-text">紫色</text>
          </view>
          <view class="color-item {{areaBorderColor === 'orange' ? 'selected' : ''}}" bindtap="selectBorderColor" data-color="orange">
            <view class="color-circle" style="background-color: #ff9500;"></view>
            <text class="color-text">橙色</text>
          </view>
          <view class="color-item {{areaBorderColor === 'red' ? 'selected' : ''}}" bindtap="selectBorderColor" data-color="red">
            <view class="color-circle" style="background-color: #ff3b30;"></view>
            <text class="color-text">红色</text>
          </view>
          <view class="color-item {{areaBorderColor === 'gray' ? 'selected' : ''}}" bindtap="selectBorderColor" data-color="gray">
            <view class="color-circle" style="background-color: #8e8e93;"></view>
            <text class="color-text">灰色</text>
          </view>
          <view class="color-item {{areaBorderColor === 'black' ? 'selected' : ''}}" bindtap="selectBorderColor" data-color="black">
            <view class="color-circle" style="background-color: #1c1c1e;"></view>
            <text class="color-text">黑色</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 高亮颜色选择器 -->
  <view class="picker-mask" wx:if="{{showHighlightColorPicker}}" bindtap="closeHighlightColorPicker">
    <view class="picker-panel" catchtap="preventClose">
      <view class="picker-header">
        <text class="picker-title">选择高亮颜色</text>
        <view class="picker-close" bindtap="closeHighlightColorPicker">✕</view>
      </view>
      <view class="picker-body">
        <view class="color-grid">
          <view class="color-item" bindtap="selectHighlightColor" data-color="#007aff">
            <view class="color-circle" style="background-color: #007aff;"></view>
            <text class="color-text">蓝色</text>
          </view>
          <view class="color-item" bindtap="selectHighlightColor" data-color="#34c759">
            <view class="color-circle" style="background-color: #34c759;"></view>
            <text class="color-text">绿色</text>
          </view>
          <view class="color-item" bindtap="selectHighlightColor" data-color="#ff2d55">
            <view class="color-circle" style="background-color: #ff2d55;"></view>
            <text class="color-text">粉色</text>
          </view>
          <view class="color-item" bindtap="selectHighlightColor" data-color="#af52de">
            <view class="color-circle" style="background-color: #af52de;"></view>
            <text class="color-text">紫色</text>
          </view>
          <view class="color-item" bindtap="selectHighlightColor" data-color="#ff9500">
            <view class="color-circle" style="background-color: #ff9500;"></view>
            <text class="color-text">橙色</text>
          </view>
          <view class="color-item" bindtap="selectHighlightColor" data-color="#ff3b30">
            <view class="color-circle" style="background-color: #ff3b30;"></view>
            <text class="color-text">红色</text>
          </view>
          <view class="color-item" bindtap="selectHighlightColor" data-color="#8e8e93">
            <view class="color-circle" style="background-color: #8e8e93;"></view>
            <text class="color-text">灰色</text>
          </view>
          <view class="color-item" bindtap="selectHighlightColor" data-color="#1c1c1e">
            <view class="color-circle" style="background-color: #1c1c1e;"></view>
            <text class="color-text">黑色</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 高亮样式类型选择器 -->
  <view class="picker-mask" wx:if="{{showHighlightStylePicker}}" bindtap="closeHighlightStylePicker">
    <view class="picker-panel" catchtap="preventClose">
      <view class="picker-header">
        <text class="picker-title">选择高亮类型</text>
        <view class="picker-close" bindtap="closeHighlightStylePicker">✕</view>
      </view>
      <view class="picker-body">
        <view class="style-options">
          <view class="style-option {{highlightStyle.type === 'fill' ? 'selected' : ''}}" bindtap="selectHighlightStyle" data-type="fill">
            <view class="style-preview style-preview-fill"></view>
            <text class="style-label">填充</text>
          </view>
          <view class="style-option {{highlightStyle.type === 'border' ? 'selected' : ''}}" bindtap="selectHighlightStyle" data-type="border">
            <view class="style-preview style-preview-border"></view>
            <text class="style-label">边框</text>
          </view>
          <view class="style-option {{highlightStyle.type === 'both' ? 'selected' : ''}}" bindtap="selectHighlightStyle" data-type="both">
            <view class="style-preview style-preview-both"></view>
            <text class="style-label">填充 + 边框</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 形状选择器 -->
  <view class="picker-mask" wx:if="{{showShapePicker}}" bindtap="closeShapePicker">
    <view class="picker-panel" catchtap="preventClose">
      <view class="picker-header">
        <text class="picker-title">选择形状</text>
        <view class="picker-close" bindtap="closeShapePicker">✕</view>
      </view>
      <view class="picker-body">
        <view class="shape-list">
          <view class="shape-option {{beadShape === 'square' ? 'selected' : ''}}" bindtap="selectShape" data-shape="square">
            <view class="shape-preview square"></view>
            <text class="shape-name">方形</text>
          </view>
          <view class="shape-option {{beadShape === 'circle' ? 'selected' : ''}}" bindtap="selectShape" data-shape="circle">
            <view class="shape-preview circle"></view>
            <text class="shape-name">圆形</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 尺寸选择器 -->
  <view class="picker-mask" wx:if="{{showSizePicker}}" bindtap="closeSizePicker">
    <view class="picker-panel" catchtap="preventClose">
      <view class="picker-header">
        <text class="picker-title">拼豆区域尺寸</text>
        <view class="picker-close" bindtap="closeSizePicker">✕</view>
      </view>
      <view class="picker-body">
        <view class="size-presets">
          <view class="size-preset {{gridWidth === 16 && gridHeight === 16 ? 'selected' : ''}}" bindtap="selectSize" data-w="16" data-h="16">16 × 16</view>
          <view class="size-preset {{gridWidth === 29 && gridHeight === 29 ? 'selected' : ''}}" bindtap="selectSize" data-w="29" data-h="29">29 × 29</view>
          <view class="size-preset {{gridWidth === 32 && gridHeight === 32 ? 'selected' : ''}}" bindtap="selectSize" data-w="32" data-h="32">32 × 32</view>
          <view class="size-preset {{gridWidth === 48 && gridHeight === 48 ? 'selected' : ''}}" bindtap="selectSize" data-w="48" data-h="48">48 × 48</view>
          <view class="size-preset {{gridWidth === 64 && gridHeight === 64 ? 'selected' : ''}}" bindtap="selectSize" data-w="64" data-h="64">64 × 64</view>
        </view>
        <view class="size-custom">
          <text class="custom-label">自定义</text>
          <view class="custom-inputs">
            <view class="input-group">
              <text class="input-label">宽</text>
              <input class="size-input" type="number" value="{{gridWidth}}" bindinput="onWidthInput" />
            </view>
            <text class="input-separator">×</text>
            <view class="input-group">
              <text class="input-label">高</text>
              <input class="size-input" type="number" value="{{gridHeight}}" bindinput="onHeightInput" />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 间隔选择器 -->
  <view class="picker-mask" wx:if="{{showIntervalPicker}}" bindtap="closeIntervalPicker">
    <view class="picker-panel" catchtap="preventClose">
      <view class="picker-header">
        <text class="picker-title">标记线间隔</text>
        <view class="picker-close" bindtap="closeIntervalPicker">✕</view>
      </view>
      <view class="picker-body">
        <view class="interval-options">
          <view class="interval-option {{gridCycleInterval === 5 ? 'selected' : ''}}" bindtap="selectInterval" data-value="5">
            <text class="interval-number">5</text>
            <text class="interval-unit">格</text>
          </view>
          <view class="interval-option {{gridCycleInterval === 10 ? 'selected' : ''}}" bindtap="selectInterval" data-value="10">
            <text class="interval-number">10</text>
            <text class="interval-unit">格</text>
          </view>
          <view class="interval-option {{gridCycleInterval === 15 ? 'selected' : ''}}" bindtap="selectInterval" data-value="15">
            <text class="interval-number">15</text>
            <text class="interval-unit">格</text>
          </view>
        </view>
        <view class="interval-slider-section">
          <text class="slider-label">自定义</text>
          <slider class="interval-slider" min="3" max="20" value="{{gridCycleInterval}}" show-value block-size="20" activeColor="#007aff" backgroundColor="#f2f2f7" bindchange="onIntervalChange"/>
        </view>
      </view>
    </view>
  </view>

  <!-- 导入图片弹窗 -->
  <view class="import-image-mask" wx:if="{{showImportImage}}" bindtap="closeImportImage" catchtouchmove="preventTouchMove">
    <view class="import-image-panel" catchtap="preventClose">
      <view class="import-header">
        <text class="import-title">📷 导入图片生成</text>
        <view class="import-close" bindtap="closeImportImage">✕</view>
      </view>
      
      <scroll-view class="import-body" scroll-y>
        <!-- 图片选择区域 -->
        <view class="import-section">
          <view class="section-title">选择图片</view>
          <view class="image-picker" bindtap="chooseImage">
            <image wx:if="{{importImageSrc}}" class="preview-image" src="{{importImageSrc}}" mode="aspectFit" />
            <view wx:else class="image-placeholder">
              <text class="placeholder-icon">🖼️</text>
              <text class="placeholder-text">点击选择图片</text>
            </view>
          </view>
          <view wx:if="{{importImageWidth > 0}}" class="image-info">
            <text class="info-text">原图尺寸: {{importImageWidth}} × {{importImageHeight}}</text>
          </view>
        </view>

        <!-- 品牌选择 -->
        <view class="import-section">
          <view class="section-title">拼豆品牌</view>
          <picker mode="selector" range="{{brands}}" range-key="name" value="{{importBrandIndex}}" bindchange="onImportBrandChange">
            <view class="brand-picker">
              <text class="brand-name">{{importBrandName || 'MARD'}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>

        <!-- 基础尺寸 -->
        <view class="import-section">
          <view class="section-title">尺寸设置</view>
          <view class="size-slider-container">
            <text class="size-label">短边尺寸 (格)</text>
            <slider class="size-slider" min="16" max="64" value="{{importBaseSize}}" show-value block-size="20" activeColor="#007aff" backgroundColor="#f2f2f7" bindchange="onImportBaseSizeChange"/>
          </view>
        </view>

        <!-- 预览尺寸 -->
        <view class="import-section" wx:if="{{importImageWidth > 0}}">
          <view class="section-title">生成尺寸</view>
          <view class="preview-size">
            <text class="size-value">{{importPreviewWidth}} × {{importPreviewHeight}} 格</text>
          </view>
        </view>

        <!-- 处理进度 -->
        <view class="import-section" wx:if="{{isProcessing}}">
          <view class="section-title">处理中...</view>
          <progress class="process-progress" percent="{{processProgress}}" activeColor="#007aff" backgroundColor="#f2f2f7" stroke-width="8" />
        </view>
      </scroll-view>

      <!-- 底部按钮 -->
      <view class="import-footer">
        <view class="import-btn cancel-btn" bindtap="closeImportImage">取消</view>
        <view class="import-btn confirm-btn {{isProcessing ? 'disabled' : ''}}" bindtap="confirmImportImage">
          {{isProcessing ? '处理中...' : '确认导入'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 隐藏的Canvas用于图片处理 -->
  <canvas type="2d" id="importCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 1px; height: 1px;"></canvas>
  
  <!-- 选区操作菜单 -->
  <view class="selection-menu-mask" wx:if="{{selectionMenuVisible}}" bindtap="closeSelectionMenu">
    <view class="selection-menu" catchtap="preventClose" style="left: {{selectionMenuX}}px; top: {{selectionMenuY}}px;">
      <view class="selection-menu-item" bindtap="onSelectionCopy">
        <text class="menu-icon">📋</text>
        <text class="menu-text">复制</text>
      </view>
      <view class="selection-menu-item" bindtap="onSelectionCut">
        <text class="menu-icon">✂️</text>
        <text class="menu-text">剪切</text>
      </view>
      <view class="selection-menu-item" bindtap="onSelectionDelete">
        <text class="menu-icon">🗑️</text>
        <text class="menu-text">删除</text>
      </view>
      <view class="selection-menu-item" bindtap="onSelectionClear">
        <text class="menu-icon">✖️</text>
        <text class="menu-text">取消选区</text>
      </view>
    </view>
  </view>
  
  <!-- 导出弹窗 -->
  <view class="export-modal-mask" wx:if="{{showExportModal}}" bindtap="closeExportModal">
    <view class="export-modal" catchtap="preventClose">
      <view class="export-header">
        <text class="export-title">导出拼豆作品</text>
        <view class="export-close" bindtap="closeExportModal">✕</view>
      </view>
      
      <scroll-view class="export-content" scroll-y>
        <!-- 预览区域 -->
        <view class="export-preview-section">
          <view class="preview-header">
            <text class="preview-title">预览</text>
            <view class="preview-zoom-controls">
              <view class="zoom-btn" bindtap="onPreviewZoomOut">−</view>
              <text class="zoom-scale">{{exportPreviewScale}}%</text>
              <view class="zoom-btn" bindtap="onPreviewZoomIn">+</view>
              <view class="zoom-btn reset-btn" bindtap="onPreviewZoomReset">重置</view>
            </view>
          </view>
          <scroll-view class="preview-container" scroll-x scroll-y enhanced show-scrollbar="{{false}}">
            <view class="preview-scroll-content" style="min-width: 100%; min-height: 300rpx;">
              <image 
                class="preview-image" 
                src="{{exportPreviewUrl}}" 
                mode="widthFix" 
                style="width: {{exportPreviewScale}}%; transform: scale({{exportPreviewScale / 100}}); transform-origin: top left;"
                wx:if="{{exportPreviewUrl}}" 
              />
              <view class="preview-placeholder" wx:else>
                <text>生成预览中...</text>
              </view>
            </view>
          </scroll-view>
        </view>
        
        <!-- 工具选项 -->
        <view class="export-tools-section">
          <view class="tool-row">
            <view class="tool-item {{exportShowGrid ? 'active' : ''}}" bindtap="onExportToggleGrid" data-value="{{!exportShowGrid}}">
              <view class="tool-icon">#</view>
              <text class="tool-label">网格</text>
            </view>
            <view class="tool-item {{exportShowRuler ? 'active' : ''}}" bindtap="onExportToggleRuler" data-value="{{!exportShowRuler}}">
              <view class="tool-icon">📏</view>
              <text class="tool-label">标尺</text>
            </view>
            <view class="tool-item {{exportShowColorCode ? 'active' : ''}}" bindtap="onExportToggleColorCode" data-value="{{!exportShowColorCode}}">
              <view class="tool-icon">A1</view>
              <text class="tool-label">色号</text>
            </view>
            <view class="tool-item {{exportShowHexCode ? 'active' : ''}}" bindtap="onExportToggleHexCode" data-value="{{!exportShowHexCode}}">
              <view class="tool-icon">HEX</view>
              <text class="tool-label">HEX</text>
            </view>
          </view>
          
          <!-- 色号字体大小 -->
          <view class="font-size-section" wx:if="{{exportShowColorCode || exportShowHexCode}}">
            <text class="font-size-label">字体大小</text>
            <view class="font-size-options">
              <view class="font-size-chip {{exportFontSize === 'small' ? 'active' : ''}}" bindtap="onExportSetFontSize" data-size="small">小</view>
              <view class="font-size-chip {{exportFontSize === 'medium' ? 'active' : ''}}" bindtap="onExportSetFontSize" data-size="medium">中</view>
              <view class="font-size-chip {{exportFontSize === 'large' ? 'active' : ''}}" bindtap="onExportSetFontSize" data-size="large">大</view>
            </view>
          </view>
          
          <!-- 辅助网格选项 -->
          <view class="aux-grid-section" wx:if="{{exportShowGrid}}">
            <text class="aux-label">辅助粗线</text>
            <view class="aux-options">
              <view class="aux-chip {{exportAuxGridIndex === 0 ? 'active' : ''}}" bindtap="onExportSetAuxGrid" data-index="0">无</view>
              <view class="aux-chip {{exportAuxGridIndex === 1 ? 'active' : ''}}" bindtap="onExportSetAuxGrid" data-index="1">5格</view>
              <view class="aux-chip {{exportAuxGridIndex === 2 ? 'active' : ''}}" bindtap="onExportSetAuxGrid" data-index="2">10格</view>
            </view>
          </view>
        </view>
        
        <!-- 颜色统计 -->
        <view class="export-stats-section" wx:if="{{exportStatsList.length > 0}}">
          <view class="stats-header">
            <text class="stats-title">颜色统计</text>
            <text class="stats-total">共 {{exportStatsTotal}} 个豆子</text>
          </view>
          <view class="stats-grid">
            <view class="stats-item" wx:for="{{exportStatsList}}" wx:key="color">
              <view class="stats-color-block" style="background-color: {{item.color}};"></view>
              <view class="stats-info">
                <view class="stats-count">{{item.count}} 个 ({{item.percentage}}%)</view>
                <view class="stats-brand" wx:if="{{item.brandInfo}}">{{item.brandInfo.brandName}} {{item.brandInfo.code}}</view>
                <view class="stats-hex" wx:if="{{exportShowHexCode}}">{{item.color}}</view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
      
      <!-- 底部按钮 -->
      <view class="export-footer">
        <view class="export-btn cancel-btn" bindtap="closeExportModal">取消</view>
        <view class="export-btn confirm-btn {{isExporting ? 'disabled' : ''}}" bindtap="onSaveExportImage">
          {{isExporting ? '导出中...' : '保存高清图'}}
        </view>
      </view>
    </view>
  </view>
  
  <!-- 隐藏的Canvas用于导出 -->
  <canvas type="2d" id="exportCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 1px; height: 1px;"></canvas>
  <!-- 隐藏的Canvas用于发布预览 -->
  <canvas canvas-id="publishPreviewCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 300px; height: 300px;"></canvas>
  
  <!-- 发布弹窗 -->
  <view class="publish-modal {{showPublishModal ? 'show' : ''}}" catchtap="closePublishModal">
    <view class="publish-content" catchtap="preventClose">
      <view class="publish-header">
        <text class="publish-title">发布作品</text>
        <view class="publish-close" catchtap="closePublishModal">×</view>
      </view>
      
      <view class="publish-preview">
        <image class="publish-preview-img" src="{{publishPreviewUrl}}" mode="aspectFit" wx:if="{{publishPreviewUrl}}"></image>
        <view class="publish-preview-placeholder" wx:else>
          <text>作品预览</text>
        </view>
      </view>
      
      <view class="publish-form">
        <view class="publish-field">
          <text class="publish-label">作品标题 <text class="required">*</text></text>
          <input class="publish-input" placeholder="给你的作品起个名字吧" value="{{publishTitle}}" bindinput="onPublishTitleInput" maxlength="30" />
        </view>
        
        <view class="publish-field">
          <text class="publish-label">作品描述</text>
          <textarea class="publish-textarea" placeholder="介绍一下你的作品（可选）" value="{{publishDescription}}" bindinput="onPublishDescInput" maxlength="200" auto-height />
        </view>
        
        <view class="publish-field publish-switch-field">
          <text class="publish-label">公开作品</text>
          <switch checked="{{publishIsPublic}}" bindchange="onPublishPublicChange" color="#007AFF" />
        </view>
      </view>
      
      <view class="publish-actions">
        <view class="publish-btn cancel-btn" catchtap="closePublishModal">取消</view>
        <view class="publish-btn confirm-btn {{isPublishing ? 'disabled' : ''}}" bindtap="onConfirmPublish">
          {{isPublishing ? '发布中...' : '发布'}}
        </view>
      </view>
    </view>
  </view>
</view>
