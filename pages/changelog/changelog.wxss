.page-container {
  min-height: 100vh;
  background: var(--ym-bg, #FBF7F2);
  padding: 30rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ---------- 头部 ---------- */
.page-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 36rpx;
}

.header-icon {
  font-size: 72rpx;
  line-height: 1;
}

.header-title {
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ym-text, #4A3A3E);
}

.header-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ym-text-sub, #9B8A8C);
}

/* ---------- 时间线 ---------- */
.timeline {
  position: relative;
  padding-left: 34rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 2rpx;
  background: var(--ym-line-strong, #E4D5CB);
}

.version-card {
  position: relative;
  background: var(--ym-surface, #FFFDFB);
  border-radius: var(--ym-r-md, 20rpx);
  padding: 28rpx 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(74, 58, 62, 0.05);
}

.card-dot {
  position: absolute;
  left: -33rpx;
  top: 36rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--ym-primary, #D4607A);
  border: 4rpx solid var(--ym-bg, #FBF7F2);
}

.card-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.head-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.version-no {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ym-text, #4A3A3E);
}

.version-tag {
  margin-left: 14rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  color: #FFFFFF;
}

.tag-new { background: var(--ym-primary, #D4607A); }
.tag-fix { background: #E0795C; }
.tag-opt { background: var(--ym-honey, #D89A5C); }

.head-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.version-date {
  font-size: 24rpx;
  color: var(--ym-text-sub, #9B8A8C);
}

.version-time {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ym-primary, #D4607A);
  font-weight: 500;
}

.version-title {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--ym-text, #4A3A3E);
  font-weight: 500;
}

.version-items {
  margin-top: 14rpx;
}

.item-row {
  display: flex;
  flex-direction: row;
  margin-top: 8rpx;
}

.item-dot {
  width: 24rpx;
  color: var(--ym-primary, #D4607A);
  font-size: 28rpx;
  line-height: 40rpx;
}

.item-text {
  flex: 1;
  font-size: 26rpx;
  color: #5C4A4E;
  line-height: 40rpx;
}

/* ---------- 底部 ---------- */
.page-footer {
  margin-top: 20rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: var(--ym-text-faint, #C2B4B4);
}
