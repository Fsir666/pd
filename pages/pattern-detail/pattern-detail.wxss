.page {
  min-height: 100vh;
  background: #FBF7F2;
  padding: 28rpx;
  box-sizing: border-box;
}

.sheet-card {
  background: #FFFDFB;
  border-radius: 32rpx;
  padding: 30rpx 26rpx 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(176, 138, 128, 0.10);
  border: 1rpx solid #F0E4DC;
}

.sheet-head {
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.sheet-head-main {
  flex: 1;
  min-width: 0;
}

.fav-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #7A6A6E;
  background: #F5EDE6;
  border: 1rpx solid #F0E4DC;
}

.fav-btn .fav-icon {
  font-size: 30rpx;
}

.fav-btn.on {
  color: #D89A5C;
  background: #F7EEDF;
  border-color: rgba(216, 154, 92, 0.30);
}

.fav-btn:active {
  transform: scale(0.94);
}

.sheet-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A3A3E;
}

.sheet-sub {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #9B8A8C;
}

.canvas {
  display: block;
  margin: 0 auto;
  border-radius: 16rpx;
  background: #FFFDFB;
}

.sheet-tip {
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: #C2B4B4;
}

.list-card {
  margin-top: 26rpx;
  background: #FFFDFB;
  border-radius: 32rpx;
  padding: 28rpx 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(176, 138, 128, 0.10);
  border: 1rpx solid #F0E4DC;
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A3A3E;
  margin-bottom: 18rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F5EDE6;
}

.row:last-child {
  border-bottom: none;
}

.swatch {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  border: 1rpx solid #E4D5CB;
  flex-shrink: 0;
}

.code {
  margin-left: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3A3E;
  width: 120rpx;
}

.hex {
  font-size: 23rpx;
  color: #B7A9A9;
  flex: 1;
}

.count {
  font-size: 26rpx;
  color: #A8455C;
  font-weight: 600;
}

.actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 600;
}

.btn-primary {
  color: #FFFDFB;
  background: linear-gradient(135deg, #D4607A, #E0909A);
  box-shadow: 0 14rpx 34rpx rgba(212, 96, 122, 0.26);
}

.btn-ghost {
  color: #A8455C;
  background: #F6E9E4;
  border: 1rpx solid #EFD9D2;
}

.safe-bottom {
  height: 80rpx;
}
