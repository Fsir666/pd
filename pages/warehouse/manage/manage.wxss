
/* manage.wxss */
.page-root {
  min-height: 100vh;
  background-color: #FBF7F2;
  padding-bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  box-sizing: border-box;
}

.paper-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  background: #FBF7F2;
}

.glass-card {
  background: rgba(255,255,255,0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
  margin: 24rpx;
  overflow: hidden;
}

/* Header */
.header {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #000;
  margin-bottom: 8rpx;
}

.header-sub {
  font-size: 24rpx;
  color: #9B8A8C;
}

.header-right {
  display: flex;
  gap: 16rpx;
}

.stat-pill {
  background: rgba(0,0,0,0.05);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 20rpx;
  color: #9B8A8C;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #000;
}

/* Tabs */
.tabs {
  margin-top: 0;
  padding: 8rpx;
}

.seg {
  display: flex;
  background: rgba(118,118,128,0.12);
  border-radius: 16rpx;
  padding: 4rpx;
  width: 400rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #000;
  padding: 12rpx 0;
  border-radius: 14rpx;
}

.seg-item.active {
  background: #D4607A;
  color: #FFFDFB;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.12);
  font-weight: 600;
}

/* Main Navigation */
.main-nav {
  display: flex;
  background: rgba(118,118,128,0.08);
  border-radius: 20rpx;
  padding: 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.nav-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
  opacity: 0.6;
}

.nav-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #7A6A6E;
}

.nav-item.active {
  background: #FFFDFB;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  transform: scale(1.02);
}

.nav-item.active .nav-icon {
  opacity: 1;
  transform: scale(1.1);
}

.nav-item.active .nav-text {
  color: #000;
  font-weight: 700;
}

/* Controls */
.controls {
  padding: 24rpx;
}

.series-grid, .series-filter-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* Log Color Filter */
.log-color-scroll {
  white-space: nowrap;
  margin-bottom: 32rpx;
}

.log-color-row {
  display: inline-flex;
  padding: 0 4rpx;
}

.log-color-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx 8rpx 8rpx;
  background: rgba(0,0,0,0.05);
  border-radius: 32rpx;
  margin-right: 16rpx;
  border: 1px solid transparent;
  transition: all 0.2s;
}

.log-color-chip.active {
  background: #FFFDFB;
  border-color: #D4607A;
  box-shadow: 0 4rpx 12rpx rgba(212,96,122,0.15);
}

.chip-swatch {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: 1px solid rgba(0,0,0,0.1);
}

.all-colors-swatch {
  background: conic-gradient(from 0deg, #C0485C, #D89A5C, #E0B45C, #7A9E7E, #D4607A, #B49AC4, #FF2D55, #C0485C);
}

.chip-code {
  font-size: 24rpx;
  font-weight: 500;
  color: #4A3A3E;
}

.log-color-chip.active .chip-code {
  color: #D4607A;
  font-weight: 600;
}

.series-chip {
  padding: 12rpx 24rpx;
  background: #FBF7F2;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #4A3A3E;
  transition: all 0.2s;
}

.series-chip.active {
  background: #D4607A;
  color: #FFFDFB;
  font-weight: 600;
}

.group-scroll {
  white-space: nowrap;
  margin-bottom: 32rpx;
}

.group-row {
  display: inline-flex;
  padding: 0 4rpx;
}

.group-chip {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: rgba(0,0,0,0.05);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #7A6A6E;
  margin-right: 16rpx;
}

.group-chip.active {
  background: #D4607A;
  color: #FFFDFB;
  font-weight: 600;
}

.controls-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.controls-row:last-child {
  margin-bottom: 0;
}

.search-wrap {
  flex: 1;
  background: #F0E4DC;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  margin-right: 16rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #9B8A8C;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #000;
}

.search-clear {
  font-size: 28rpx;
  color: #9B8A8C;
  padding: 8rpx;
}

.low-pill {
  font-size: 24rpx;
  color: #7A9E7E;
  font-weight: 600;
  background: rgba(52,199,89,0.1);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.low-pill.warn {
  color: #C0485C;
  background: rgba(255,59,48,0.1);
}

/* List */
.list {
  padding: 0;
  display: flex;
  flex-direction: column;
  min-height: 400rpx;
  background: transparent !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1px solid rgba(0,0,0,0.05);
}

.filter-switch {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(0,0,0,0.05);
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #9B8A8C;
  transition: all 0.3s ease;
}

.filter-switch.active {
  background: rgba(255,59,48,0.1);
  color: #C0485C;
  font-weight: 600;
}

.switch-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C2B4B4;
  transition: all 0.3s ease;
}

.filter-switch.active .switch-dot {
  background: #C0485C;
  box-shadow: 0 0 8rpx rgba(255,59,48,0.4);
}

.list-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
}

.list-sub {
  font-size: 24rpx;
  color: #9B8A8C;
}

.list-scroll {
  max-height: 60vh;
}

.inventory-list {
  padding: 0 24rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #FFFDFB;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  transition: all 0.2s ease;
  border: 1px solid rgba(0,0,0,0.02);
  /* position: relative; Removed to use flex layout for checkbox */
}

.list-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}

.batch-check {
  margin-left: 24rpx;
  display: flex;
  align-items: center;
}

.item-left {
  display: flex;
  align-items: center;
  flex: 1; /* Push other items to the right */
}

.item-swatch {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  border: 4rpx solid #FFFDFB;
  box-shadow: 0 8rpx 16rpx rgba(0,0,0,0.1) !important;
}

.item-info {
  display: flex;
  flex-direction: column;
}

.item-code {
  font-size: 36rpx;
  font-weight: 800;
  color: #000;
  letter-spacing: -0.5px;
}

.item-hex {
  font-size: 24rpx;
  color: #9B8A8C;
  margin-top: 6rpx;
  font-family: monospace;
  background: rgba(0,0,0,0.03);
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  display: inline-block;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.item-stats {
  display: flex;
  align-items: center;
  gap: 32rpx;
  /* margin-right: 12rpx; Removed to let flex handle spacing */
}

.stat-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 80rpx;
}

.stat-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3A3E;
  line-height: 1.2;
}

.stat-lbl {
  font-size: 20rpx;
  color: #9B8A8C;
  margin-top: 6rpx;
  font-weight: 500;
}

.stat-col.warn .stat-val {
  color: #C0485C;
}

.stat-col.warn .stat-lbl {
  color: #C0485C;
  opacity: 0.8;
}

.stat-col.safe .stat-lbl {
  color: #7A9E7E;
  opacity: 0.8;
}

.sufficient-tag {
  font-size: 24rpx;
  color: #7A9E7E;
  font-weight: 700;
  background: rgba(52,199,89,0.1);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  line-height: 1.2;
}

.item-count-wrap {
  background: #FBF7F2;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: baseline;
}

.item-count-wrap.warn {
  background: rgba(255,59,48,0.1);
}

.item-count {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
}

.item-count-wrap.warn .item-count {
  color: #C0485C;
}

.item-unit {
  font-size: 20rpx;
  color: #9B8A8C;
  margin-left: 4rpx;
}

.item-warn {
  font-size: 20rpx;
  color: #C0485C;
  margin-top: 4rpx;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2px solid #C2B4B4;
}

.check.on {
  background: #D4607A;
  border-color: #D4607A;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9B8A8C;
}

.empty-state-large {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-illustration {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #9B8A8C;
  margin-bottom: 48rpx;
  text-align: center;
}

.empty-action {
  background: #D4607A;
  color: #FFFDFB;
  padding: 20rpx 40rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* Inventory Grid (Alerts Tab) */
.inventory-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx;
}

.grid-item {
  width: 33.33%;
  padding: 12rpx;
  box-sizing: border-box;
}

.grid-item.low {
  position: relative;
}

.grid-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 8rpx;
}

.grid-code {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.grid-swatch {
  width: 100%;
  padding-bottom: 100%;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.grid-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.grid-count {
  font-size: 28rpx;
  font-weight: 700;
}

.grid-count.warn {
  color: #C0485C;
}

.grid-warn {
  font-size: 20rpx;
  color: #C0485C;
  background: rgba(255,59,48,0.1);
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
}

.batch-bar {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 32rpx);
  left: 32rpx;
  right: 32rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(176,138,128,0.22);
  z-index: 1000;
  border: 1px solid rgba(255,255,255,0.5);
}

.batch-bar-left {
  display: flex;
  align-items: center;
}

.batch-bar-center {
  flex: 1;
  margin: 0 24rpx;
  background: #FBF7F2;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border: 1px solid rgba(0,0,0,0.05);
}

.batch-bar-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.batch-bar-input {
  width: 100%;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #000;
  height: 100%;
}

.batch-btn-cancel {
  font-size: 28rpx;
  color: #9B8A8C;
  padding: 20rpx;
  font-weight: 500;
}

.batch-btn-toggle {
  font-size: 28rpx;
  color: #D4607A;
  font-weight: 600;
  padding: 10rpx 20rpx;
  background: rgba(212,96,122,0.1);
  border-radius: 24rpx;
}

.batch-btn-apply {
  background: #000;
  color: #FFFDFB;
  padding: 20rpx 40rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.2);
  transition: all 0.2s;
}

.batch-btn-apply:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* Logs */
.logs-header {
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(0,0,0,0.05);
}

.logs-title {
  font-size: 32rpx;
  font-weight: 700;
}

.logs-actions {
  display: flex;
  background: rgba(118,118,128,0.12);
  border-radius: 8rpx;
  padding: 4rpx;
}

.log-chip {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  color: #7A6A6E;
}

.log-chip.active {
  background: #D4607A;
  color: #FFFDFB;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

/* Logs List */
.log-list {
  padding: 0 24rpx;
}

.log-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFDFB;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.log-left {
  display: flex;
  align-items: center;
}

.log-swatch {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
  border: 2rpx solid rgba(0,0,0,0.05);
}

.log-info {
  display: flex;
  flex-direction: column;
}

.log-code {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3A3E;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
}

.log-brand {
  font-size: 20rpx;
  background: rgba(0,0,0,0.05);
  color: #7A6A6E;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  font-weight: 500;
}

.log-time {
  font-size: 24rpx;
  color: #9B8A8C;
}

.log-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.log-delta {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.log-delta.add {
  color: #7A9E7E;
}

.log-delta.sub {
  color: #C0485C;
}

.log-after {
  font-size: 22rpx;
  color: #9B8A8C;
  background: rgba(0,0,0,0.03);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

/* Stats */
.stats-card {
  padding: 24rpx;
}

.stats-head {
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 700;
  display: block;
}

.stats-sub {
  font-size: 24rpx;
  color: #9B8A8C;
}

.chart-canvas {
  width: 100%;
  height: 400rpx;
}

.legend-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.legend {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #7A6A6E;
}

.legend-swatch {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.low-list {
  display: flex;
  flex-direction: column;
}

.low-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1px solid rgba(0,0,0,0.05);
}

.low-left {
  display: flex;
  align-items: center;
}

.swatch {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.meta {
  display: flex;
  flex-direction: column;
}

.code {
  font-size: 28rpx;
  font-weight: 600;
}

.sub {
  font-size: 20rpx;
  color: #9B8A8C;
}

.low-right {
  text-align: right;
}

.count {
  font-size: 28rpx;
  font-weight: 700;
  color: #C0485C;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  margin-top: 4rpx;
  display: inline-block;
}

.tag-warn {
  background: rgba(255,59,48,0.1);
  color: #C0485C;
}

/* Modals / Sheets */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #FFFDFB;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  box-sizing: border-box;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  text-align: center;
}

.sheet-sub {
  font-size: 28rpx;
  color: #9B8A8C;
  margin-bottom: 40rpx;
  text-align: center;
}

.sheet-input {
  background: #FBF7F2;
  height: 100rpx;
  border-radius: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}

.current-stock {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background: #FBF7F2;
  border-radius: 16rpx;
}

.current-label {
  font-size: 28rpx;
  color: #9B8A8C;
}

.current-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3A3E;
  margin-left: 8rpx;
}

.quick-buttons {
  margin-bottom: 24rpx;
}

.quick-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.quick-btn {
  flex: 1;
  height: 72rpx;
