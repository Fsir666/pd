/* Action Sheet (Item Details) */
.action-sheet {
  padding: 0;
  background: #FBF7F2;
}

.sheet-header {
  background: #FFFDFB;
  padding: 32rpx;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(0,0,0,0.05);
}

.sheet-close {
  font-size: 32rpx;
  color: #9B8A8C;
  padding: 8rpx;
}

.action-list {
  padding: 24rpx;
}

.action-item {
  background: #FFFDFB;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  background: #FBF7F2;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}

.action-content {
  flex: 1;
}

.action-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
  margin-bottom: 4rpx;
}

.action-desc {
  font-size: 24rpx;
  color: #9B8A8C;
}

.action-arrow {
  font-size: 40rpx;
  color: #C2B4B4;
}

/* Batch Button Large */
.batch-btn-large {
  background: linear-gradient(135deg, #D4607A 0%, #0056D2 100%);
  color: #FFFDFB;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 
    0 8rpx 20rpx rgba(212,96,122,0.3),
    0 4rpx 8rpx rgba(212,96,122,0.2);
  transition: all 0.2s;
  width: 100%;
}

.batch-btn-large:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(212,96,122,0.2);
}

/* Floating Batch Bar */
.batch-bar {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  z-index: 100;
  box-shadow: 
    0 20rpx 60rpx rgba(176,138,128,0.22),
    0 8rpx 24rpx rgba(0,0,0,0.1);
  margin: 0;
}

.batch-bar-left, .batch-bar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.batch-bar-center {
  flex: 1;
  margin: 0 24rpx;
}

.batch-bar-input {
  background: #FBF7F2;
  height: 80rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #4A3A3E;
  text-align: center;
}

.batch-btn-cancel {
  font-size: 28rpx;
  color: #9B8A8C;
  padding: 20rpx;
}

.batch-btn-toggle {
  font-size: 28rpx;
  color: #D4607A;
  padding: 20rpx;
  font-weight: 600;
}

.batch-btn-apply {
  background: #000;
  color: #FFFDFB;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(176,138,128,0.22);
}

.batch-btn-apply:active {
  transform: scale(0.96);
  background: #4A3A3E;
}

.check-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.9);
  border: 3rpx solid #C2B4B4;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
}

.check-circle.checked {
  background: #D4607A;
  border-color: #D4607A;
}

.check-inner {
  width: 18rpx;
  height: 18rpx;
  background: #FFFDFB;
  border-radius: 50%;
}

/* Modal Styles */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-card {
  width: 600rpx;
  background: #FFFDFB;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.1);
  animation: modalScale 0.2s ease-out;
}

@keyframes modalScale {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
  color: #000;
}

.modal-input {
  background: #FBF7F2;
  height: 88rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  margin-bottom: 48rpx;
  text-align: center;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: opacity 0.2s;
}

.modal-btn:active {
  opacity: 0.7;
}

.modal-btn.ghost {
  background: #FBF7F2;
  color: #000;
}

.modal-btn.primary {
  background: #D4607A;
  color: #FFFDFB;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 24rpx;
  color: #9B8A8C;
  margin-bottom: 12rpx;
  display: block;
}

.color-picker-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.color-preview-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0,0,0,0.08);
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,0.6);
}

.hex-input {
  flex: 1;
  margin-bottom: 0;
  height: 72rpx;
  font-size: 26rpx;
}


.color-picker-container {
  width: 100%;
  margin: 8rpx 0 6rpx;
}

.sv-panel {
  position: relative;
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f00;
  border: 1rpx solid #FBF7F2;
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,0.4);
}

.sv-white-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, #FFFDFB 0%, rgba(255,255,255,0) 100%);
}

.sv-black-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, #000 0%, rgba(0,0,0,0) 100%);
}

.picker-handle {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  border: 2rpx solid #FFFDFB;
  box-shadow: 0 2rpx 8rpx rgba(74,58,62,0.28);
}

.hue-slider {
  position: relative;
  height: 20rpx;
  border-radius: 999rpx;
  margin-top: 16rpx;
  background: linear-gradient(90deg, #FF0000 0%, #FFFF00 16.6%, #00FF00 33.3%, #00FFFF 50%, #0000FF 66.6%, #FF00FF 83.3%, #FF0000 100%);
  border: 1rpx solid #FBF7F2;
}

.hue-handle {
  position: absolute;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: #FFFDFB;
  border: 2rpx solid rgba(176,138,128,0.22);
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.2);
}
