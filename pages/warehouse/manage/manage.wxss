  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-btn.ghost {
  background: #FBF7F2;
  color: #000;
}

.sheet-btn.primary {
  background: #000;
  color: #FFFDFB;
}

