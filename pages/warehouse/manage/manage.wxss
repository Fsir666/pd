/* Group List Styles */
.custom-group-list {
  margin-top: 16rpx;
  padding-left: 16rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.group-label {
  font-size: 24rpx;
  color: #7A6A6E;
}

.add-group-btn {
  font-size: 24rpx;
  color: #D4607A;
}

.custom-group-item {
  background: rgba(0,0,0,0.02);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.group-info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.group-name {
