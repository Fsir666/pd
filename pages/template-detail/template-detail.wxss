/* pages/template-detail/template-detail.wxss */
.container {
  padding-bottom: 200rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

.preview-card {
  background: #fff;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  position: relative;
  height: 500rpx;
}

.preview-canvas {
  width: 100%;
  height: 100%;
}

.preview-hint {
  position: absolute;
  bottom: 20rpx;
  background: rgba(0,0,0,0.5);
  color: white;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.fullscreen-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0,0,0,0.9);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-content {
  width: 100%;
  height: 100%;
  position: relative;
}

.fullscreen-canvas {
  width: 100%;
  height: 100%;
}

.close-btn {
  position: absolute;
  top: 80rpx;
  right: 40rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 50%;
  color: white;
  font-size: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1001;
}

.operation-tip {
  position: absolute;
  bottom: 100rpx;
  left: 0;
  width: 100%;
  text-align: center;
  color: rgba(255,255,255,0.7);
  font-size: 28rpx;
  pointer-events: none;
}

.info-card {
  background: #fff;
  padding: 30rpx;
  margin: 0 20rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

/* 尺寸选择器样式 */
.size-selector {
  margin-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.selector-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.size-options {
  display: flex;
  justify-content: space-between;
}

.size-option {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  margin: 0 10rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
  border-radius: 10rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.size-option:first-child {
  margin-left: 0;
}

.size-option:last-child {
  margin-right: 0;
}

.size-option.active {
  background: #FFF0E6;
  color: #FF6B00;
  border-color: #FF6B00;
  font-weight: bold;
}

/* 评论区样式 */
.comment-section {
  padding-bottom: 20rpx;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.comment-tabs {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.tab {
  padding: 0 10rpx;
}

.tab.active {
  color: #333;
  font-weight: bold;
}

.divider {
  margin: 0 10rpx;
  color: #eee;
}

.comment-list {
  margin-bottom: 30rpx;
}

.comment-item {
  display: flex;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #f8f8f8;
  padding-bottom: 20rpx;
}

.comment-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.user-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #eee;
}

.comment-content-box {
  flex: 1;
}

.user-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.like-box {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.like-icon {
  margin-left: 8rpx;
}

.comment-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.comment-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.comment-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #aaa;
}

.comment-input-area {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.input-box {
  flex: 1;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 10rpx 20rpx;
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.comment-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.image-btn {
  font-size: 36rpx;
  color: #999;
  padding: 0 10rpx;
}

.send-btn {
  font-size: 28rpx;
  color: #FF6B00;
  font-weight: bold;
  padding: 10rpx 0;
}

.selected-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.selected-img-wrapper {
  position: relative;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.selected-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
}

.delete-img {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: rgba(0,0,0,0.5);
  color: white;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
}

.title-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.author {
  font-size: 26rpx;
  color: #666;
}

.heat-badge {
  background: #FFF0E6;
  color: #FF6B00;
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
}

.data-grid {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.data-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.data-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.data-label {
  font-size: 24rpx;
  color: #999;
}

.desc-section {
  padding-top: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
  border-left: 8rpx solid #FF6B00;
  padding-left: 20rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-info {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 24rpx;
  color: #999;
}

.price-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B00;
}

.action-btn {
  background: linear-gradient(135deg, #FF6B00, #FF8C42);
  color: white;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 0, 0.3);
}
