<view class="container">
  <!-- 搜索/标题区域 -->
  <view class="header-section">
    <view class="page-title">品牌目录</view>
    <view class="subtitle">共 {{brands.length}} 个品牌收录</view>
  </view>

  <!-- 品牌列表 -->
  <view class="brand-grid">
    <block wx:for="{{brands}}" wx:key="id">
      <view class="brand-card" bindtap="onViewColors" data-id="{{item.id}}" data-name="{{item.name}}">
        <!-- 顶部：图标和名称 -->
        <view class="card-top">
          <view class="brand-icon" style="background-color: {{item.color}};">
            {{item.initial}}
          </view>
          <view class="brand-info">
            <view class="name-row">
              <text class="name">{{item.name}}</text>
              <text wx:if="{{item.tag}}" class="tag" style="color: {{item.color}}; background-color: {{item.color}}15;">{{item.tag}}</text>
            </view>
            <text class="desc">{{item.colors}}</text>
          </view>
        </view>
        
        <!-- 底部：操作区 -->
        <view class="card-action">
          <text class="action-text">查看颜色</text>
          <view class="action-btn" catchtap="onViewChart" data-id="{{item.id}}" data-name="{{item.name}}">
            <text>📊 色卡</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>