<wxs module="refresh">
var pullThreshold = 80;
var maxPull = 150;

function onPulling(e, ownerInstance) {
  var dy = e.detail.dy;
  if (dy < 0) return;
  
  // 简单的插值计算
  // 旋转：每像素转动 4 度
  var rotate = dy * 4;
  
  // 缩放：0.6 -> 1.2
  var scale = 0.6 + (dy / pullThreshold) * 0.6;
  if (scale > 1.2) scale = 1.2;
  
  // 获取组件实例
  var icon = ownerInstance.selectComponent('.refresh-icon');
  var text = ownerInstance.selectComponent('.refresh-text');
  
  if (icon) {
    icon.setStyle({
      transform: 'rotate(' + rotate + 'deg) scale(' + scale + ')'
    });
  }
  
  if (text) {
    var opacity = (dy - 20) / (pullThreshold - 20);
    if (opacity < 0) opacity = 0;
    if (opacity > 1) opacity = 1;
    
    text.setStyle({
      opacity: opacity
    });
  }
}

function onStatusChange(newValue, oldValue, ownerInstance, instance) {
  if (newValue) {
    var icon = ownerInstance.selectComponent('.refresh-icon');
    if (icon) {
      icon.setStyle({
        transform: ''
      });
    }
  }
}

module.exports = {
  onPulling: onPulling,
  onStatusChange: onStatusChange
}
</wxs>

<view class="page-root">
  <!-- 动态弥散背景 -->
  <view class="ambient-bg">
    <view class="orb orb-1"></view>
    <view class="orb orb-2"></view>
    <view class="orb orb-3"></view>
  </view>

  <scroll-view 
    scroll-y 
    style="height: 100vh;" 
    refresher-enabled="{{true}}" 
    refresher-threshold="{{120}}"
    refresher-default-style="none"
    refresher-background="transparent"
    refresher-triggered="{{isRefreshing}}"
    bindrefresherpulling="{{refresh.onPulling}}"
    bindrefresherrefresh="onRefresh"
    bindrefresherrestore="onRestore"
  >
    <!-- 自定义下拉刷新动画容器 -->
    <view slot="refresher" class="custom-refresher" prop="{{isRefreshing}}" change:prop="{{refresh.onStatusChange}}">
      <view class="refresh-content">
        <view class="refresh-icon {{isRefreshing ? 'rotating' : ''}}">👾</view>
        <text class="refresh-text">下拉刷新…</text>
      </view>
    </view>

    <view class="container">
      <!-- 顶部状态栏 (毛玻璃) -->
      <view class="header-status">
        <view class="status-item">
          <text class="icon">💰</text>
          <text class="value">{{userInfo.coins}}</text>
          <text class="label">豆币</text>
        </view>
        <view class="status-item">
          <text class="icon">⚡</text>
          <text class="value">{{userInfo.energy}}/10</text>
          <text class="label">体力</text>
        </view>
      </view>

      <!-- 顶部状态栏：豆币 / 体力（见下方 header-status） -->

      <!-- Hero 主创作入口：画板（bead-mode 空白大画板） -->
      <view class="hero-card" bindtap="onGoBoard">
        <view class="hero-body">
          <view class="hero-badge">
            <text class="hero-badge-dot"></text>
            <text class="hero-badge-text">拼豆创作工具</text>
          </view>
          <text class="hero-title">画板</text>
          <text class="hero-sub">自由绘制 · 选色落珠 · 导出图纸</text>
          <view class="hero-cta">
            <text class="hero-cta-text">进入画板</text>
            <text class="hero-cta-arrow">›</text>
          </view>
        </view>
        <view class="hero-beads">
          <view class="bead b1"></view><view class="bead b2"></view><view class="bead b3"></view>
          <view class="bead b4"></view><view class="bead b5"></view><view class="bead b6"></view>
          <view class="bead b7"></view><view class="bead b8"></view><view class="bead b9"></view>
        </view>
      </view>

      <!-- 快捷工具：一行四个 -->
      <view class="quick-row">
        <view class="quick-item" bindtap="onToolTap" data-id="1">
          <view class="quick-emoji-wrap qe-sage"><text class="quick-emoji">🖼️</text></view>
          <text class="quick-label">图片转像素</text>
        </view>
        <view class="quick-item" bindtap="onToolTap" data-id="9">
          <view class="quick-emoji-wrap qe-pink"><text class="quick-emoji">🪄</text></view>
          <text class="quick-label">转卡通</text>
        </view>
        <view class="quick-item" bindtap="onToolTap" data-id="13">
          <view class="quick-emoji-wrap qe-honey"><text class="quick-emoji">📐</text></view>
          <text class="quick-label">图纸库</text>
        </view>
        <view class="quick-item" bindtap="onToolTap" data-id="4">
          <view class="quick-emoji-wrap qe-mint"><text class="quick-emoji">🎨</text></view>
          <text class="quick-label">色卡表</text>
        </view>
      </view>

      <!-- 工具箱 (Toolbox)：收起时只有一个细长按钮，展开才显示卡片壳 -->
      <view class="toolbox-section">
        <view class="toolbox-shell glass-card {{toolsExpanded ? 'shell-open' : ''}}">
          <!-- 小工具网格：收起时整块隐藏，展开时果冻动画弹出 -->
          <view class="toolbox-collapse {{toolsExpanded ? 'expanded' : ''}}">
            <view class="toolbox-grid toolbox-grid--compact">
              <block wx:for="{{allSmallTools}}" wx:key="id">
                <view class="tool-card glass-card size-{{item.size || 'small'}}" bindtap="onToolTap" data-id="{{item.id}}">
                  <view class="tool-icon tool-icon--steady" style="color: {{item.color}}">
                    {{item.icon}}
                  </view>
                  <view class="tool-info">
                    <text class="tool-title">{{item.title}}</text>
                    <text class="tool-desc">{{item.desc}}</text>
                  </view>
                </view>
              </block>
            </view>
          </view>

          <!-- 展开/收起全部工具（就地切换，不跳页） -->
          <view class="show-all-btn-container">
            <view class="show-all-btn" bindtap="onToggleTools">
              <text>{{toolsExpanded ? '收起工具' : '全部工具'}}</text>
              <text class="arrow-icon {{toolsExpanded ? 'expanded' : ''}}">></text>
            </view>
          </view>
        </view>
      </view>


      <!-- 热度榜单 (毛玻璃) -->
      <view class="rank-section">
        <view class="section-header">
          <text class="section-title-text">🔥 热门图纸榜</text>
          <view class="rank-head-right">
            <like-float class="home-like" show-particles="{{false}}" />
            <text class="section-more">查看全部 ></text>
          </view>
        </view>
        
        <!-- Template Definition -->
        <template name="rankItem">
          <view class="rank-item glass-card {{item.rank === 1 ? 'rank-gold' : ''}} {{item.rank === 2 ? 'rank-silver' : ''}} {{item.rank === 3 ? 'rank-bronze' : ''}}" 
                bindtap="goToDetail" 
                data-id="{{item.id}}"
                data-title="{{item.title}}"
                data-image-url="{{item.imageUrl}}"
                data-author="{{item.author}}"
                data-likes="{{item.heat}}">
            
            <!-- 图片区域 -->
            <view class="rank-img-box">
              <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="rank-img-real" binderror="onImageError" data-index="{{item.rank - 1}}"></image>
              <view wx:else class="rank-img-placeholder">{{item.image}}</view>
              
              <!-- 排名角标 -->
              <view class="rank-badge" wx:if="{{item.rank <= 3}}">
                <text wx:if="{{item.rank === 1}}">🥇</text>
                <text wx:elif="{{item.rank === 2}}">🥈</text>
                <text wx:elif="{{item.rank === 3}}">🥉</text>
              </view>
              <view class="rank-badge normal" wx:else>{{item.rank}}</view>
            </view>
            
            <!-- 内容区域 -->
            <view class="rank-content">
              <text class="rank-title">{{item.title}}</text>
              
              <view class="rank-footer">
                <view class="rank-author-row">
                  <text class="rank-author">{{item.author}}</text>
                </view>
                <view class="rank-heat">
                  <text class="heat-icon">🔥</text>
                  <text>{{item.heat}}</text>
                </view>
              </view>
            </view>
          </view>
        </template>

        <!-- Two Column Flex Layout -->
        <view class="rank-list-flex">
          <view class="rank-column">
            <block wx:for="{{leftTemplates}}" wx:key="id">
              <template is="rankItem" data="{{item}}"/>
            </block>
          </view>
          <view class="rank-column">
            <block wx:for="{{rightTemplates}}" wx:key="id">
              <template is="rankItem" data="{{item}}"/>
            </block>
          </view>
        </view>
      </view>
      
      <!-- Bottom Padding for TabBar -->
      <view style="height: 160rpx;"></view>
    </view>
  </scroll-view>
</view>
