/* ============================================================
   悠米拼豆 · 首页 index
   视觉体系：奶油手作 S1
   ============================================================ */

/* ---------- 页面根 ---------- */
.page-root {
  position: relative;
  width: 100vw;
  height: 100vh;
  background-color: var(--ym-bg, #FBF7F2);
  overflow: hidden;
}

/* ---------- 背景柔光（暖调） ---------- */
.ambient-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90rpx);
  opacity: 0.6;
}

.orb-1 {
  width: 600rpx;
  height: 600rpx;
  background: var(--ym-primary-wash, #F6E9E4);
  top: -150rpx;
  left: -100rpx;
  animation: float 10s infinite ease-in-out;
}

.orb-2 {
  width: 500rpx;
  height: 500rpx;
  background: var(--ym-honey-wash, #F7EEDF);
  bottom: 10%;
  right: -100rpx;
  animation: float 12s infinite ease-in-out reverse;
}

.orb-3 {
  width: 400rpx;
  height: 400rpx;
  background: var(--ym-mint-wash, #E9F0E8);
  top: 40%;
  left: 20%;
  animation: float 15s infinite ease-in-out 2s;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(20rpx, 30rpx); }
}

/* ---------- 卡片基座 ---------- */
.glass-card {
  background: var(--ym-surface, #FFFDFB);
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: var(--ym-shadow, 0 6rpx 20rpx rgba(176, 138, 128, 0.10));
  border-radius: var(--ym-r-xl, 32rpx);
}

/* ---------- 滚动容器 ---------- */
scroll-view {
  position: relative;
  z-index: 1;
  height: 100vh;
}

.container {
  padding-bottom: calc(120rpx + 40rpx + env(safe-area-inset-bottom));
}

.like-strip {
  height: 88rpx;
  padding: 0 24rpx 18rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

/* ---------- 顶部状态栏 ---------- */
.header-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  margin: 20rpx auto;
  z-index: 100;
  position: sticky;
  top: 20rpx;
  width: calc(100% - 48rpx);
  box-sizing: border-box;
  background: rgba(255, 253, 251, 0.86);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 52rpx;
  box-shadow: 0 8rpx 26rpx rgba(176, 138, 128, 0.14);
}

.status-item {
  display: flex;
  align-items: center;
  background: var(--ym-bg-sunk, #F5EDE6);
  padding: 8rpx 22rpx;
  border-radius: 40rpx;
}

.status-item .icon {
  margin-right: 8rpx;
  font-size: 30rpx;
}

.status-item .value {
  font-weight: 500;
  color: var(--ym-text, #4A3A3E);
  margin-right: 8rpx;
  font-size: 28rpx;
  font-variant-numeric: tabular-nums;
}

.status-item .label {
  font-size: 23rpx;
  color: var(--ym-text-sub, #9B8A8C);
}

/* ---------- 轮播 ---------- */
.banner-swiper {
  height: 300rpx;
  margin: 30rpx 24rpx;
  border-radius: var(--ym-r-xl, 32rpx);
  overflow: hidden;
  box-shadow: var(--ym-shadow, 0 6rpx 20rpx rgba(176, 138, 128, 0.14));
  transform: translateZ(0);
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.banner-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.banner-deco-1 {
  width: 220rpx;
  height: 220rpx;
  top: -70rpx;
  right: -40rpx;
}

.banner-deco-2 {
  width: 140rpx;
  height: 140rpx;
  bottom: -50rpx;
  left: -30rpx;
  background: rgba(255, 255, 255, 0.12);
}

.banner-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 0 40rpx;
}

.banner-icon {
  font-size: 76rpx;
  line-height: 1;
  filter: drop-shadow(0 4rpx 6rpx rgba(0, 0, 0, 0.15));
}

.banner-text {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.banner-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.18);
}

.banner-sub {
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 400;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.15);
}

/* ---------- 开始拼豆 CTA ---------- */
.game-start-section {
  padding: 0 24rpx;
  margin-bottom: 40rpx;
}

.start-btn-card {
  background: var(--ym-primary, #D4607A);
  border: 2rpx solid rgba(255, 255, 255, 0.24);
  box-shadow: 0 16rpx 34rpx rgba(212, 96, 122, 0.30);
  border-radius: var(--ym-r-xl, 32rpx);
  padding: 46rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: white;
  position: relative;
  transition: transform 0.1s ease;
}

.start-btn-card:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 20rpx rgba(212, 96, 122, 0.22);
}

.start-content {
  display: flex;
  flex-direction: column;
}

.start-title {
  font-size: 46rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.12);
}

.start-desc {
  font-size: 25rpx;
  opacity: 0.92;
  font-weight: 400;
}

.start-icon {
  font-size: 76rpx;
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

/* ---------- 区块标题 ---------- */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
  padding: 0 10rpx;
}

.section-title-text {
  font-size: 31rpx;
  font-weight: 500;
  color: var(--ym-text, #4A3A3E);
  letter-spacing: 0.4rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 500;
  color: var(--ym-text, #4A3A3E);
}

.section-more {
  font-size: 23rpx;
  color: var(--ym-text-sub, #9B8A8C);
}

/* ---------- 工具箱 ---------- */
.toolbox-section {
  padding: 0 24rpx 40rpx;
}

.toolbox-shell {
  padding: 16rpx;
  background: var(--ym-surface, #FFFDFB);
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: var(--ym-shadow, 0 6rpx 20rpx rgba(176, 138, 128, 0.10));
  border-radius: var(--ym-r-xl, 32rpx);
}

.toolbox-feature-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.tool-feature {
  border-radius: var(--ym-r-lg, 26rpx);
  border: 2rpx solid transparent;
  background: var(--ym-primary-wash, #F6E9E4);
  box-shadow: none;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.tool-feature:active {
  transform: scale(0.985);
}

.tool-feature--primary {
  min-height: 190rpx;
}

.tool-feature--secondary {
  min-height: 190rpx;
}

.tool-feature-top {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
}

.tool-feature-icon {
  margin-bottom: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--ym-r-md, 20rpx);
  font-size: 48rpx;
  background: var(--ym-surface-pure, #FFFFFF);
  box-shadow: 0 6rpx 16rpx rgba(176, 138, 128, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-feature-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tool-feature-title {
  font-size: 31rpx;
  font-weight: 500;
  color: var(--ym-text, #4A3A3E);
  letter-spacing: 0.3rpx;
}

.tool-feature--secondary .tool-feature-title {
  font-size: 27rpx;
  font-weight: 500;
}

.tool-feature-desc {
  font-size: 22rpx;
  color: var(--ym-text-sub, #9B8A8C);
}

.toolbox-grid.toolbox-grid--compact {
  gap: 16rpx;
  grid-template-columns: repeat(3, 1fr);
  grid-auto-flow: row;
  margin-bottom: 16rpx;
}

/* ---------- 工具网格折叠容器（果冻动画） ---------- */
.toolbox-collapse {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transform-origin: top center;
  transition:
    max-height 0.5s cubic-bezier(0.34, 1.45, 0.64, 1),
    opacity 0.3s ease;
}

.toolbox-collapse.expanded {
  max-height: 660rpx;
  opacity: 1;
  animation: jelly-in 0.55s cubic-bezier(0.34, 1.45, 0.64, 1);
}

@keyframes jelly-in {
  0%   { transform: scale(0.9, 0.82); }
  40%  { transform: scale(1.03, 1.08); }
  70%  { transform: scale(0.98, 0.97); }
  100% { transform: scale(1, 1); }
}

.toolbox-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  grid-auto-flow: dense;
}

/* ---------- 工具小卡 ---------- */
.tool-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 10rpx;
  background: var(--ym-bg-sunk, #F5EDE6);
  border: 2rpx solid transparent;
  border-radius: var(--ym-r-lg, 26rpx);
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
  overflow: hidden;
  height: 100%;
  box-sizing: border-box;
}

.tool-card.size-small {
  grid-column: span 1;
  grid-row: span 1;
}

.tool-card:active {
  transform: scale(0.96);
  background: var(--ym-primary-wash, #F6E9E4);
}

.tool-icon {
  font-size: 50rpx;
  margin-bottom: 16rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ym-surface-pure, #FFFFFF);
  border-radius: var(--ym-r-md, 20rpx);
  box-shadow: 0 6rpx 16rpx rgba(176, 138, 128, 0.14);
  transition: transform 0.3s ease;
}

.tool-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.tool-title {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ym-text, #4A3A3E);
  text-align: center;
  line-height: 1.3;
}

.tool-desc {
  display: none;
}

/* --- 尺寸变体 --- */
.tool-card.size-large {
  grid-column: span 2;
  grid-row: span 2;
  background: var(--ym-surface-pure, #FFFFFF);
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx;
}

.tool-card.size-large .tool-icon {
  font-size: 72rpx;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 0;
  border-radius: var(--ym-r-lg, 26rpx);
  background: var(--ym-bg-sunk, #F5EDE6);
  box-shadow: none;
}

.tool-card.size-large .tool-info {
  align-items: flex-start;
}

.tool-card.size-large .tool-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  text-align: left;
}

.tool-card.size-large .tool-desc {
  display: block;
  font-size: 23rpx;
  color: var(--ym-text-sub, #9B8A8C);
  text-align: left;
  line-height: 1.4;
}

.tool-card.size-medium {
  grid-column: span 2;
  grid-row: span 1;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
  padding: 0 24rpx;
  background: var(--ym-surface-pure, #FFFFFF);
}

.tool-card.size-medium .tool-icon {
  margin-bottom: 0;
  margin-right: 24rpx;
  width: 92rpx;
  height: 92rpx;
  font-size: 46rpx;
  flex-shrink: 0;
}

.tool-card.size-medium .tool-info {
  align-items: flex-start;
  justify-content: center;
  height: 100%;
}

.tool-card.size-medium .tool-title {
  font-size: 29rpx;
  font-weight: 400;
  margin-bottom: 6rpx;
  text-align: left;
}

.tool-card.size-medium .tool-desc {
  display: block;
  font-size: 22rpx;
  color: var(--ym-text-sub, #9B8A8C);
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

/* ---------- 全部工具按钮 ---------- */
.show-all-btn-container {
  margin-top: 0;
}

.show-all-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 26rpx;
  color: var(--ym-text-sub, #9B8A8C);
  font-weight: 400;
  transition: all 0.2s;
}

.show-all-btn:active {
  transform: scale(0.98);
  background: var(--ym-bg-sunk, #F5EDE6);
}

.arrow-icon {
  margin-left: 10rpx;
  font-weight: 400;
  transform: rotate(90deg);
  display: inline-block;
  transition: transform 0.3s ease;
}

.arrow-icon.expanded {
  transform: rotate(-90deg);
}

.extra-tools {
  margin-top: 20rpx;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---------- 图标动画 ---------- */
@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

@keyframes wiggle {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-10deg); }
  75% { transform: rotate(10deg); }
}

@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(0.85); }
}

@keyframes spin-slow {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.tool-icon.pulse { animation: pulse 2s infinite ease-in-out; }
.tool-icon.wiggle { animation: wiggle 1.5s infinite ease-in-out; }
.tool-icon.breathe { animation: breathe 2s infinite ease-in-out; }
.tool-icon.spin-slow { animation: spin-slow 8s infinite linear; }
.tool-icon.bounce { animation: bounce 2s infinite ease-in-out; }
.tool-icon.float { animation: float 3s infinite ease-in-out; }

/* ---------- 热门图纸榜 ---------- */
.rank-section {
  padding: 0 24rpx 40rpx;
}

.rank-list-flex {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  width: 100%;
}

.rank-column {
  width: 48.5%;
  display: flex;
  flex-direction: column;
}

.rank-item {
  width: 100%;
  margin-bottom: 24rpx;
  background: var(--ym-surface, #FFFDFB);
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: var(--ym-shadow, 0 6rpx 20rpx rgba(176, 138, 128, 0.10));
  border-radius: var(--ym-r-xl, 32rpx);
  overflow: hidden;
  position: relative;
  transition: all 0.3s ease;
}

.rank-item:active {
  transform: scale(0.98);
}

.rank-gold {
  border: 2rpx solid rgba(216, 154, 92, 0.55);
  box-shadow: 0 10rpx 26rpx rgba(216, 154, 92, 0.20);
}

.rank-silver {
  border: 2rpx solid rgba(196, 186, 178, 0.60);
  box-shadow: 0 10rpx 26rpx rgba(176, 138, 128, 0.16);
}

.rank-bronze {
  border: 2rpx solid rgba(190, 140, 112, 0.50);
  box-shadow: 0 10rpx 26rpx rgba(190, 140, 112, 0.18);
}

.rank-img-box {
  position: relative;
  width: 100%;
  min-height: 200rpx;
  background: var(--ym-bg-sunk, #F5EDE6);
}

.rank-img-real {
  width: 100%;
  display: block;
}

.rank-img-placeholder {
  width: 100%;
  height: 300rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 80rpx;
  background: var(--ym-bg-sunk, #F5EDE6);
}

.rank-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(255, 253, 251, 0.94);
  padding: 4rpx 14rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 400;
  box-shadow: 0 4rpx 10rpx rgba(176, 138, 128, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 40rpx;
}

.rank-badge.normal {
  background: rgba(74, 58, 62, 0.62);
  color: white;
  padding: 4rpx 14rpx;
}

.rank-content {
  padding: 18rpx 20rpx;
}

.rank-title {
  font-size: 27rpx;
  font-weight: 400;
  color: var(--ym-text, #4A3A3E);
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.45;
}

.rank-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rank-author-row {
  display: flex;
  align-items: center;
}

.rank-author {
  font-size: 22rpx;
  color: var(--ym-text-sub, #9B8A8C);
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-heat {
  display: flex;
  align-items: center;
  color: var(--ym-primary, #D4607A);
  font-size: 22rpx;
  font-weight: 500;
}

.heat-icon {
  font-size: 20rpx;
  margin-right: 4rpx;
}

/* ---------- 下拉刷新 ---------- */
.custom-refresher {
  width: 100vw;
  height: 200rpx;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding-bottom: 20rpx;
}

.refresh-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.refresh-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
  transition: transform 0.1s;
}

.refresh-icon.rotating {
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.refresh-text {
  font-size: 23rpx;
  color: var(--ym-text-sub, #9B8A8C);
}

/* ============================================================
   v1.0.49 首页大整改
   Hero 主卡 + 一行四快捷工具 + 统一排版
   ============================================================ */

/* ---------- Hero 主创作卡片 ---------- */
.hero-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 32rpx;
  padding: 32rpx 28rpx;
  min-height: 232rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #D4607A 0%, #E88FA1 100%);
  box-shadow: 0 14rpx 34rpx rgba(212, 96, 122, 0.28);
  overflow: hidden;
  transition: transform 0.18s ease;
}

.hero-card:active {
  transform: scale(0.98);
}

.hero-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hero-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  margin-bottom: 16rpx;
}

.hero-badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.hero-badge-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 0.4rpx;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 0.6rpx;
  line-height: 1.3;
}

.hero-sub {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 10rpx;
  line-height: 1.5;
}

.hero-cta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 22rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(120, 40, 60, 0.18);
}

.hero-cta-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #D4607A;
}

.hero-cta-arrow {
  font-size: 28rpx;
  color: #D4607A;
  margin-top: -2rpx;
}

/* 右侧拼豆点阵装饰（3×3 像素格，呼应拼豆主题） */
.hero-beads {
  flex: none;
  width: 132rpx;
  height: 132rpx;
  margin-left: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 6rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
}

.bead {
  border-radius: 8rpx;
}

.bead.b1 { background: rgba(255,255,255,0.92); }
.bead.b2 { background: rgba(255,255,255,0.55); }
.bead.b3 { background: rgba(255,255,255,0.80); }
.bead.b4 { background: rgba(255,255,255,0.50); }
.bead.b5 { background: #D89A5C; }
.bead.b6 { background: rgba(255,255,255,0.72); }
.bead.b7 { background: rgba(255,255,255,0.62); }
.bead.b8 { background: #7A9E7E; }
.bead.b9 { background: rgba(255,255,255,0.85); }

/* ---------- 快捷工具：一行四个 ---------- */
.quick-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 6rpx 16rpx;
  border-radius: 24rpx;
  background: var(--ym-surface, #FFFDFB);
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 4rpx 14rpx rgba(176, 138, 128, 0.08);
  transition: transform 0.18s ease;
}

.quick-item:active {
  transform: scale(0.95);
}

.quick-emoji-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.quick-emoji-wrap.qe-sage  { background: #E9F0E8; }
.quick-emoji-wrap.qe-pink  { background: #F6E9E4; }
.quick-emoji-wrap.qe-honey { background: #F7EEDF; }
.quick-emoji-wrap.qe-mint  { background: #E6EDEA; }

.quick-emoji {
  font-size: 34rpx;
  line-height: 1;
}

.quick-label {
  font-size: 23rpx;
  color: var(--ym-text, #4A3A3E);
  letter-spacing: 0.2rpx;
}

/* ---------- 统一后的区块标题 ---------- */
.section-header {
  margin-bottom: 20rpx;
  padding: 0;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ym-text, #4A3A3E);
  letter-spacing: 0.4rpx;
}

.section-more {
  font-size: 23rpx;
  color: var(--ym-text-sub, #9B8A8C);
}

/* ---------- 榜单标题行右侧（点赞并入，替代独立 like-strip） ---------- */
.rank-head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rank-head-right .home-like {
  transform: scale(0.8);
  transform-origin: right center;
}

/* ---------- 圆角统一：卡片 28rpx ---------- */
.toolbox-shell,
.glass-card {
  border-radius: 28rpx;
}

.tool-card {
  border-radius: 28rpx;
}

/* ---------- 区块间距统一 ---------- */
.toolbox-section {
  padding: 0 24rpx 32rpx;
}

.rank-section {
  padding: 0 24rpx 40rpx;
}

/* ---------- 榜单图片固定比例，避免瀑布流参差 ---------- */
.rank-img-box {
  height: 220rpx;
  min-height: 220rpx;
  overflow: hidden;
  border-radius: 20rpx 20rpx 0 0;
}

.rank-img-real {
  width: 100%;
  height: 220rpx;
}

/* ---------- 装饰收敛：光斑 3 → 1 ---------- */
.orb-2,
.orb-3 {
  display: none;
}

.orb-1 {
  width: 560rpx;
  height: 560rpx;
  opacity: 0.5;
  animation: float 12s infinite ease-in-out;
}

/* ---------- 图标动画统一 ---------- */
.tool-icon--steady {
  animation: breathe 3.2s infinite ease-in-out;
}

/* ============================================================
   v1.0.50 「更多工具」区瘦身
   收起：去掉外层卡片壳和标题，只留一个细长贴紧按钮
   展开：卡片壳 + 果冻网格 + 按钮，三层贴紧
   ============================================================ */

/* 收起态：壳变成透明容器，无卡片感 */
.toolbox-shell {
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}

/* 展开态：恢复卡片壳，把网格和按钮包在一起 */
.toolbox-shell.shell-open {
  padding: 16rpx;
  background: var(--ym-surface, #FFFDFB);
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: var(--ym-shadow, 0 6rpx 20rpx rgba(176, 138, 128, 0.10));
}

/* 按钮本身：细长条，不再套 glass-card */
.show-all-btn {
  height: 68rpx;
  border-radius: 20rpx;
  background: var(--ym-bg-sunk, #F5EDE6);
  border: none;
  font-size: 24rpx;
}

.show-all-btn:active {
  transform: scale(0.98);
  background: #EFE3D9;
}

/* 收起时与上方快捷工具贴紧 */
.toolbox-section {
  padding: 0 24rpx 20rpx;
}
