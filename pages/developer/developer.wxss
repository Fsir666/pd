.container {
  padding: 20rpx;
  padding-bottom: 200rpx; /* Safe Area for TabBar */
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
}

.tool-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 10rpx;
}

.tool-card {
  width: 48%; /* 2 columns */
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  transition: transform 0.2s;
}

.tool-card:active {
  transform: scale(0.98);
}

.tool-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.tool-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.tool-desc {
  font-size: 24rpx;
  color: #999;
}

/* iOS 26 悬浮导航栏 (Custom Floating TabBar) - Apple Glass Style */
.custom-tabbar {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.65); /* Ultra low opacity white */
  backdrop-filter: saturate(180%) blur(50px); /* The "Apple Glass" Magic */
  -webkit-backdrop-filter: saturate(180%) blur(50px);
  border-radius: 55rpx;
  border-top: 0.5px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
  display: flex;
  justify-content: space-between; /* Distribute items */
  align-items: center;
  z-index: 9999;
  box-sizing: border-box;
  padding: 10rpx; /* Padding for cursor containment */
  overflow: hidden; /* Clip cursor */
}

.tab-cursor {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  width: 25%; /* 4 tabs -> 25% each */
  background: #FFFFFF;
  border-radius: 45rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08), 0 0 1rpx rgba(0,0,0,0.1);
  transition: left 0.25s cubic-bezier(0.2, 0.8, 0.2, 1); /* Smooth spring-like */
  z-index: 1;
  pointer-events: none; /* Let clicks pass through */
}

.tab-cursor.no-transition {
  transition: none !important;
}

.tab-item {
  position: relative;
  z-index: 100; /* Above cursor */
  flex: 1;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #999;
  font-weight: normal;
  transition: all 0.25s;
}

.tab-item.active {
  color: #000;
  font-weight: 800; /* Bold */
  font-size: 30rpx;
  transform: scale(1.05);
}