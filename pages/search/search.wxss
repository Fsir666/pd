.page-container {
  min-height: 100vh;
  background-color: #F2F2F7;
  position: relative;
  overflow: hidden;
}

.ambient-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.65;
}

.orb-1 {
  width: 560rpx;
  height: 560rpx;
  background: #E0C3FC;
  top: -220rpx;
  left: -140rpx;
  animation: float 10s infinite ease-in-out;
}

.orb-2 {
  width: 520rpx;
  height: 520rpx;
  background: #D4F1F4;
  top: 260rpx;
  right: -180rpx;
  animation: float 12s infinite ease-in-out reverse;
}

.orb-3 {
  width: 460rpx;
  height: 460rpx;
  background: #FFD1FF;
  bottom: 10%;
  left: 18%;
  animation: float 15s infinite ease-in-out 2s;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(18rpx, 28rpx); }
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 360rpx;
  background: linear-gradient(180deg, #E0E0EB 0%, rgba(242, 242, 247, 0) 100%);
  z-index: 0;
  pointer-events: none;
}

.glass-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 32rpx rgba(17, 17, 20, 0.08);
}

.content-container {
  position: relative;
  z-index: 1;
  padding: calc(env(safe-area-inset-top) + 16rpx) 24rpx 0;
  box-sizing: border-box;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
}

.search-icon {
  width: 48rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  opacity: 0.8;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(29, 29, 31, 0.92);
}

.search-clear {
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 20, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.74);
}

.seg-card {
  margin-top: 14rpx;
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
}

.seg-item {
  flex: 1;
  height: 60rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.68);
  background: rgba(17, 17, 20, 0.04);
}

.seg-item.active {
  color: rgba(29, 29, 31, 0.94);
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.06);
}

.discover-card {
  margin-top: 14rpx;
  padding: 18rpx;
}

.discover-title {
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.9);
  margin-bottom: 12rpx;
}

.discover-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.discover-chip {
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 20, 0.06);
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.8);
}

.history {
  margin-top: 18rpx;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.history-title {
  font-size: 26rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.84);
}

.history-clear {
  height: 48rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 20, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.72);
}

.history-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.history-chip {
  max-width: 100%;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.82);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.results-card {
  margin-top: 14rpx;
  padding: 8rpx 16rpx 16rpx;
}

.loading,
.empty {
  padding: 28rpx 6rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(29, 29, 31, 0.56);
}

.section {
  padding: 12rpx 0;
}

.section + .section {
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 6rpx 6rpx 10rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.9);
}

.section-count {
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.52);
}

.user-row-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 6rpx;
}

.user-row-item + .user-row-item {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(17, 17, 20, 0.06);
  flex: 0 0 auto;
}

.user-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-row-name {
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-row-bio {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(29, 29, 31, 0.52);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.follow-btn {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 106, 0, 1);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.follow-btn.following {
  background: rgba(17, 17, 20, 0.08);
  color: rgba(29, 29, 31, 0.78);
}

.work-row-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 6rpx;
}

.work-row-item + .work-row-item {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.work-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(17, 17, 20, 0.06);
  flex: 0 0 auto;
}

.work-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.work-row-title {
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-row-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.work-row-author {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(29, 29, 31, 0.56);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-row-like {
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.62);
  flex: 0 0 auto;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

