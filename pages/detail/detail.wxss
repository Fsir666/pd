.container {
  background-color: #FBF7F2;
  min-height: 100vh;
}

/* 1. 顶部大图与视差 */
.hero-image {
  width: 100%;
  height: 62vh;
  display: block;
  will-change: transform;
}

.back-btn {
  position: fixed;
  left: 30rpx;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 253, 251, 0.55);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  box-shadow: 0 8rpx 24rpx rgba(176, 138, 128, 0.18);
}

.back-icon {
  color: #4A3A3E;
  font-size: 40rpx;
  font-weight: bold;
}

/* 2. 内容卡片 */
.content-card {
  position: relative;
  margin-top: -60rpx;
  background: #FFFDFB;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx;
  min-height: 40vh;
  box-shadow: 0 -10rpx 30rpx rgba(176, 138, 128, 0.10);
  border: 1rpx solid #F0E4DC;
  border-bottom: none;
}

.card-header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  color: #4A3A3E;
  margin-bottom: 18rpx;
  display: block;
  letter-spacing: -0.4px;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 24rpx;
  color: #A8455C;
  background: #F6E9E4;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  margin-right: 15rpx;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.primary-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.primary-btn {
  flex: 1;
  height: 90rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}

.primary-remix {
  background: linear-gradient(135deg, #D4607A, #C2576E);
  color: #FFFDFB;
  box-shadow: 0 12rpx 30rpx rgba(212, 96, 122, 0.30);
}

.primary-copy {
  background: #E9F0E8;
  color: #4C6B4E;
  border: 1rpx solid rgba(122, 158, 126, 0.30);
}

.primary-btn:active {
  transform: scale(0.98);
  opacity: 0.95;
}

/* 作者信息 */
.author-info {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 30rpx;
  background: #FBF7F2;
  border-radius: 26rpx;
  border: 1rpx solid #F0E4DC;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #E4D5CB;
  flex-shrink: 0;
  border: 1rpx solid #F0E4DC;
}

.author-meta {
  flex: 1;
}

.nickname {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3A3E;
  display: block;
  margin-bottom: 15rpx;
}

.author-subrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.follower-text {
  font-size: 24rpx;
  color: #9B8A8C;
  font-weight: 600;
}

.follow-btn {
  height: 56rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #D4607A, #C2576E);
  color: #FFFDFB;
  box-shadow: 0 8rpx 22rpx rgba(212, 96, 122, 0.28);
  border: none;
}

.follow-btn.following {
  background: #F6E9E4;
  color: #A8455C;
  box-shadow: none;
  border: 1rpx solid rgba(212, 96, 122, 0.25);
}

.follow-btn.disabled {
  opacity: 0.6;
}

.follow-btn:active {
  transform: scale(0.96);
}

/* 作者栏操作按钮（点赞 / 收藏） */
.author-actions {
  display: flex;
  gap: 20rpx;
}

.action-pill {
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: #F5EDE6;
  border: 1rpx solid #F0E4DC;
  transition: all 0.2s;
}

.action-pill:active {
  transform: scale(0.95);
  background: #E4D5CB;
}

.action-pill.active {
  background: #F6E9E4;
}

.collect-pill.active {
  background: #F7EEDF;
}

.action-pill .icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.action-pill .count, 
.action-pill .label {
  font-size: 26rpx;
  color: #7A6A6E;
  font-weight: 600;
}

.like-pill.active .count {
  color: #D4607A;
}

.collect-pill.active .label {
  color: #D89A5C;
}

.description {
  font-size: 28rpx;
  color: #7A6A6E;
  line-height: 1.7;
  margin-bottom: 40rpx;
  text-align: justify;
}

.recommend-section {
  padding-top: 30rpx;
}

.recommend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.recommend-scroll {
  width: 100%;
  white-space: nowrap;
}

.recommend-row {
  display: inline-flex;
  gap: 20rpx;
  padding-bottom: 10rpx;
}

.recommend-card {
  display: inline-block;
  width: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #FFFDFB;
  box-shadow: 0 6rpx 20rpx rgba(176, 138, 128, 0.12);
  border: 1rpx solid #F0E4DC;
  flex-shrink: 0;
}

.recommend-img {
  width: 280rpx;
  height: 280rpx;
  background: linear-gradient(135deg, #F6E9E4 0%, #E9F0E8 100%);
  display: block;
}

.recommend-meta {
  padding: 16rpx 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recommend-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A3A3E;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.3;
  white-space: normal;
}

.recommend-sub {
  font-size: 24rpx;
  color: #9B8A8C;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 4. 评论区 */
.section-container {
  margin-bottom: 40rpx;
  padding-top: 36rpx;
  border-top: 1rpx solid #F0E4DC;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #4A3A3E;
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: -0.4px;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.comment-tabs {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.tab {
  font-size: 26rpx;
  color: #9B8A8C;
  font-weight: 600;
}

.tab.active {
  color: #D4607A;
  font-weight: 800;
}

.divider {
  color: #E4D5CB;
  font-size: 20rpx;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.comment-item {
  display: flex;
  gap: 20rpx;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E4D5CB;
  flex-shrink: 0;
}

.comment-main {
  flex: 1;
}

.comment-user-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.user-nickname {
  font-size: 26rpx;
  font-weight: 700;
  color: #4A3A3E;
}

.comment-time {
  font-size: 22rpx;
  color: #C2B4B4;
}

.comment-text {
  font-size: 28rpx;
  color: #4A3A3E;
  line-height: 1.6;
  margin-bottom: 15rpx;
}

.comment-img {
  width: 240rpx;
  border-radius: 16rpx;
  display: block;
}

.footer-spacing {
  height: 250rpx;
}

/* 粒子特效 */
.particle-system {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 300;
  overflow: hidden;
}

.particle {
  position: absolute;
  font-size: 48rpx;
  animation: gravity var(--duration, 1s) ease-out forwards;
  pointer-events: none;
}

@keyframes gravity {
  0% {
    transform: translate(0, 0) scale(0.5) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  40% {
    transform: translate(var(--tx, 0), var(--ty, -180rpx)) scale(1.2) rotate(calc(var(--rot) * 0.4));
    opacity: 1;
  }
  100% {
    transform: translate(calc(var(--tx, 0) * 2), 1500rpx) scale(1) rotate(var(--rot));
    opacity: 1;
  }
}

/* 5. 底部固定栏 (Cream Glass) */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  width: 100%;
  background: rgba(255, 253, 251, 0.86);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid #F0E4DC;
  z-index: 200;
}

/* 图片预览条 */
.image-preview-bar {
  padding: 20rpx 30rpx 0;
}

.preview-wrapper {
  position: relative;
  width: 100rpx;
  height: 100rpx;
}

.preview-thumb {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  border: 1rpx solid #F0E4DC;
}

.delete-btn {
  position: absolute;
  top: -15rpx;
  right: -15rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(74, 58, 62, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 输入行 */
.input-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  background: transparent;
}

.input-container {
  flex: 1;
  height: 80rpx;
  background: #F5EDE6;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
  border: 1rpx solid #F0E4DC;
}

.main-input {
  flex: 1;
  font-size: 28rpx;
  color: #4A3A3E;
}

.camera-btn {
  padding-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-btn .icon {
  font-size: 36rpx;
}

.send-btn-inline {
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #D4607A, #C2576E);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(212, 96, 122, 0.30);
  transition: all 0.2s ease;
}

.send-btn-inline:active {
  transform: scale(0.95);
}

.send-btn-inline .send-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFDFB;
  line-height: 1;
}

/* 右侧工具栏（评论 / 点赞 / 收藏 / 分享） */
.toolbar-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tool-pill {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #F5EDE6;
  border: 1rpx solid #F0E4DC;
  transition: all 0.2s ease;
}

.tool-pill .icon {
  font-size: 32rpx;
  line-height: 1;
}

.tool-pill .tcount {
  font-size: 24rpx;
  font-weight: 700;
  color: #7A6A6E;
}

.tool-pill.liked {
  background: #F6E9E4;
  border-color: rgba(212, 96, 122, 0.25);
}

.tool-pill.liked .tcount {
  color: #D4607A;
}

.tool-pill.collected {
  background: #F7EEDF;
  border-color: rgba(216, 154, 92, 0.25);
}

.tool-pill.collected .tcount {
  color: #D89A5C;
}

.tool-pill:active {
  transform: scale(0.94);
}

button.tool-pill.share-pill {
  margin: 0;
  padding: 0;
  border: none;
  background: #F5EDE6;
  line-height: 1;
  box-sizing: border-box;
}

button.tool-pill.share-pill::after {
  border: none;
}

/* 安全区域 */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
  background: transparent;
}

/* ============================================================
   v1.0.53 底部工具组改版：四个独立药丸 → 一条分段式工具条
   与左侧输入框同高对齐，分隔线代替各自边框
   ============================================================ */

.toolbar-actions {
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #F5EDE6;
  border: 1rpx solid #F0E4DC;
  border-radius: 999rpx;
  overflow: hidden;
  flex: none;
}

.tool-pill {
  height: 80rpx;
  padding: 0 22rpx;
  gap: 6rpx;
  background: transparent;
  border: none;
  border-radius: 0;
  transition: background 0.2s ease;
}

.tool-pill + .tool-pill,
button.tool-pill + button.tool-pill {
  border-left: 1rpx solid #EADFD6;
}

.tool-pill .icon {
  font-size: 30rpx;
}

.tool-pill .tcount {
  font-size: 22rpx;
  font-weight: 500;
  color: #9B8A8C;
}

.tool-pill.liked {
  background: rgba(212, 96, 122, 0.10);
}
.tool-pill.liked .icon,
.tool-pill.liked .tcount {
  color: #D4607A;
}

.tool-pill.collected {
  background: rgba(216, 154, 92, 0.12);
}
.tool-pill.collected .icon {
  color: #D89A5C;
}

button.tool-pill.share-pill {
  background: transparent;
  line-height: 1;
}
button.tool-pill.share-pill::after {
  border: none;
}
