<view class="container">
  <!-- 1. 顶部图纸预览：像素小方块（替代原珠子照片） -->
  <view class="hero-viewer">
    <!-- 像素方块模式 -->
    <block wx:if="{{hasPixel}}">
      <scroll-view class="canvas-scroll" scroll-x="{{true}}" scroll-y="{{true}}">
        <canvas type="2d" id="detailCanvas" class="detail-canvas"
                style="width:{{canvasW}}px;height:{{canvasH}}px;"
                bindtouchstart="onCanvasTouchStart"
                bindtouchmove="onCanvasTouchMove"
                bindtouchend="onCanvasTouchEnd"
                bindtouchcancel="onCanvasTouchEnd"></canvas>
      </scroll-view>
      <view class="viewer-bar viewer-bar-top">
        <view class="viewer-toggle {{showGrid ? 'on' : ''}}" bindtap="toggleGrid">网格</view>
        <view class="viewer-toggle {{showCode ? 'on' : ''}}" bindtap="toggleCode">色号</view>
      </view>
      <view class="viewer-bar viewer-bar-zoom">
        <view class="zoom-btn {{scale === 1 ? 'on' : ''}}" data-scale="1" bindtap="setScale">1×</view>
        <view class="zoom-btn {{scale === 2 ? 'on' : ''}}" data-scale="2" bindtap="setScale">2×</view>
        <view class="zoom-btn {{scale === 3 ? 'on' : ''}}" data-scale="3" bindtap="setScale">3×</view>
        <view class="zoom-btn {{scale === 4 ? 'on' : ''}}" data-scale="4" bindtap="setScale">4×</view>
      </view>
    </block>
    <!-- 无图纸数据时回退展示原图 -->
    <block wx:else>
      <image class="hero-image" src="{{imageUrl}}" mode="aspectFill" bindtap="previewImage"></image>
    </block>
  </view>

  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack" style="top: {{statusBarHeight}}px">
    <text class="back-icon">←</text>
  </view>

  <!-- 2. 内容卡片 -->
  <view class="content-card">
    <view class="card-header">
      <text class="title">{{title}}</text>
      <!-- 规格行：宽×高 粒 · 颗数 颗 · 色号 个色号 -->
      <text class="spec-line" wx:if="{{sizeText}}">{{sizeText}}</text>
      <view class="tags-container">
        <text class="tag" wx:for="{{tags}}" wx:key="*this">#{{item}}</text>
      </view>
    </view>

    <view class="primary-actions">
      <view class="primary-btn primary-remix" bindtap="onGoBeadMode">拼豆模式</view>
      <view class="primary-btn primary-copy" bindtap="onCopyMaterialList">复制清单</view>
      <view class="primary-btn primary-save" wx:if="{{hasPixel}}" bindtap="saveImage">保存图纸</view>
    </view>

    <!-- 用料清单：直接展示色块 + 色号 + hex + 颗数 -->
    <view class="material-card" wx:if="{{materialRows.length > 0}}">
      <view class="material-title">这版要用的珠子（{{materialRows.length}} 个色号）</view>
      <view class="material-row" wx:for="{{materialRows}}" wx:key="code">
        <view class="material-swatch" style="background: {{item.hex}}"></view>
        <view class="material-code">{{item.code}}</view>
        <view class="material-hex">{{item.hex}}</view>
        <view class="material-count">{{item.count}} 颗</view>
      </view>
    </view>

    <!-- 作者信息栏 -->
    <view class="author-info">
      <image class="avatar" src="{{author.avatar}}" mode="aspectFill" catchtap="goToAuthor"></image>
      <view class="author-meta">
        <text class="nickname" catchtap="goToAuthor">{{author.nickname}}</text>
        <view class="author-subrow">
          <text class="follower-text">粉丝 {{authorFollowerCount}}</text>
          <view
            class="follow-btn {{isFollowingAuthor ? 'following' : ''}} {{followLoading ? 'disabled' : ''}}"
            catchtap="onToggleFollowAuthor"
          >
            {{isFollowingAuthor ? '已关注' : '关注作者'}}
          </view>
        </view>
        <!-- 移除统计信息，保持纯净 -->
      </view>
    </view>

    <!-- 描述 -->
    <view class="description">
      <text>{{description}}</text>
    </view>

    <view class="section-container recommend-section" wx:if="{{recommendWorks.length > 0}}">
      <view class="recommend-head">
        <text class="section-title">同款/相似推荐</text>
      </view>
      <scroll-view scroll-x class="recommend-scroll" show-scrollbar="{{false}}">
        <view class="recommend-row">
          <view
            class="recommend-card"
            wx:for="{{recommendWorks}}"
            wx:key="_id"
            bindtap="goToRecommendWork"
            data-id="{{item._id}}"
          >
            <image class="recommend-img" src="{{item.imageUrl}}" mode="aspectFill"></image>
            <view class="recommend-meta">
              <text class="recommend-title">{{item.title}}</text>
              <text class="recommend-sub">{{item.author}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 4. 评论区 -->
    <view class="section-container comment-section" wx:if="{{showComment}}">
      <view class="comment-header">
        <text class="section-title">评论 ({{comments.length}})</text>
        <view class="comment-tabs">
          <view class="tab {{activeTab === 0 ? 'active' : ''}}" bindtap="onTabChange" data-index="{{0}}">最新</view>
          <view class="divider">|</view>
          <view class="tab {{activeTab === 1 ? 'active' : ''}}" bindtap="onTabChange" data-index="{{1}}">最热</view>
        </view>
      </view>

      <!-- 评论列表 -->
      <view class="comment-list">
        <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
          <image class="user-avatar" src="{{item.userInfo.avatar}}" mode="aspectFill"></image>
          <view class="comment-main">
            <view class="comment-user-info">
              <text class="user-nickname">{{item.userInfo.nickname}}</text>
              <text class="comment-time">{{item.createTime}}</text>
            </view>
            <view class="comment-text">{{item.content}}</view>
            <image 
              class="comment-img" 
              wx:if="{{item.image}}" 
              src="{{item.image}}" 
              mode="widthFix"
              bindtap="previewCommentImage"
              data-src="{{item.image}}"
            ></image>
          </view>
        </view>
      </view>
      
      <!-- 底部留白防止遮挡 -->
      <view class="footer-spacing"></view>
    </view>
  </view>

  <!-- 粒子特效容器 -->
  <view class="particle-system" pointer-events="none">
    <view 
      wx:for="{{particleList}}" 
      wx:key="id" 
      class="particle" 
      style="{{item.style}}"
    >{{item.emoji}}</view>
  </view>

  <!-- 5. 底部固定评论/操作栏 (Safe Area Adaption) -->
  <view class="bottom-action-bar">
    <!-- 图片预览区 (仅在有图时显示) -->
    <view class="image-preview-bar" wx:if="{{showComment && commentImage}}">
      <view class="preview-wrapper">
        <image class="preview-thumb" src="{{commentImage}}" mode="aspectFill"></image>
        <view class="delete-btn" bindtap="onDeleteImage">×</view>
      </view>
    </view>

    <!-- 输入栏 -->
    <view class="input-row" wx:if="{{showComment}}">
      <view class="input-container">
        <input 
          class="main-input" 
          placeholder="说点什么..." 
          value="{{commentContent}}" 
          bindinput="onInput"
          confirm-type="send"
          bindconfirm="onSubmitComment"
        />
        <view class="camera-btn" bindtap="onChooseImage">
          <view class="ico ico-camera"></view>
        </view>
        <!-- 发送按钮：仅在有内容时显示 -->
        <view class="send-btn-inline" wx:if="{{commentContent || commentImage}}" bindtap="onSubmitComment">
          <text class="send-text">发送</text>
        </view>
      </view>
      
      <!-- 右侧工具栏 -->
      <view class="toolbar-actions" style="{{showComment ? '' : 'margin: 0 auto;'}}">
        <view class="tool-pill comment-pill" wx:if="{{showComment}}" bindtap="focusComment">
          <view class="ico ico-bubble"></view>
          <text class="tcount">{{comments.length}}</text>
        </view>
        <view class="tool-pill {{isLiked ? 'liked' : ''}}" bindtap="onLike">
          <view class="ico ico-heart {{isLiked ? 'ico-heart--on' : ''}}"></view>
          <text class="tcount">{{stats.likes}}</text>
        </view>
        <view class="tool-pill {{isCollected ? 'collected' : ''}}" bindtap="onCollect">
          <view class="ico ico-star {{isCollected ? 'ico-star--on' : ''}}"></view>
        </view>
        <!-- 分享：用普通 view 渲染（与其它三段一致），透明 button 覆盖在上层只负责触发分享 -->
        <view class="tool-pill share-pill">
          <view class="ico ico-link"></view>
          <button class="share-hit" open-type="share"></button>
        </view>
      </view>
    </view>
    
    <!-- iPhone X+ 底部安全区 -->
    <view class="safe-area-bottom"></view>
  </view>
</view>
<privacy-popup />
