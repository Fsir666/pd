<view class="page-root">
  <!-- 背景 -->
  <view class="ambient-bg">
    <view class="orb orb-1"></view>
    <view class="orb orb-2"></view>
  </view>

  <view class="container">
    <!-- 功能介绍与上传引导 -->
    <view class="intro-section glass-card" wx:if="{{showIntro}}">
      <view class="icon-header">
        <text class="feature-icon">✂️</text>
      </view>
      <text class="title">智能抠图助手</text>
      <text class="subtitle">一键去除图片背景，生成透明或白底图</text>
      
      <view class="features-list">
        <view class="feature-item">
          <text class="item-icon">⚡</text>
          <text class="item-text">AI 自动识别主体</text>
        </view>
        <view class="feature-item">
          <text class="item-icon">🖼️</text>
          <text class="item-text">支持人像、商品、宠物</text>
        </view>
        <view class="feature-item">
          <text class="item-icon">⚪</text>
          <text class="item-text">自动生成白底/透明底图</text>
        </view>
      </view>

      <button class="btn-primary" bindtap="onChooseImage">上传图片(5豆豆)</button>
    </view>

    <!-- 处理状态 -->
    <view class="processing-section glass-card" wx:if="{{isProcessing}}">
      <view class="loading-spinner"></view>
      <text class="processing-text">正在抠图处理中...</text>
      <text class="processing-sub">本次将消耗 5 豆豆 · 一般 10～30 秒完成</text>
      <text class="processing-sub">请保持页面打开，处理完成会自动展示结果</text>
    </view>

    <!-- 结果展示 -->
    <view class="result-section" wx:if="{{!showIntro && !isProcessing && resultUrl}}">
      <view class="result-card glass-card">
        <view class="result-header">
          <text class="result-title">处理结果</text>
          <view class="btn-reupload" bindtap="onReUpload">重新上传</view>
        </view>
        
        <view class="image-compare">
           <!-- Placeholder for comparison or just result -->
           <image src="{{resultUrl}}" mode="aspectFit" class="result-image"></image>
        </view>

        <view class="action-buttons">
          <button class="btn-save" bindtap="onSaveImage">保存到相册</button>
        </view>
      </view>
    </view>
  </view>
</view>
<privacy-popup />
