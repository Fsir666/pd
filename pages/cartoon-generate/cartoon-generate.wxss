.page-root {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  background-color: #F2F4F8;
  overflow-x: hidden;
  box-sizing: border-box;
}

.ambient-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.6;
}

.orb-1 {
  width: 520rpx;
  height: 520rpx;
  background: #FF9F43;
  top: -120rpx;
  left: -120rpx;
}

.orb-2 {
  width: 420rpx;
  height: 420rpx;
  background: #FF6B6B;
  bottom: 18%;
  right: -80rpx;
}

.container {
  position: relative;
  z-index: 1;
  padding: 40rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.glass-card {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.04);
  border-radius: 40rpx;
  padding: 44rpx 36rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #666;
}

.cost-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.preview-box {
  margin-top: 26rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.04);
}

.preview-img {
  width: 100%;
  height: 420rpx;
  display: block;
}

.form-section {
  margin-top: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 14rpx;
  display: block;
}

.radio-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx 12rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(0, 0, 0, 0.05);
}

.radio-row {
  display: flex;
  gap: 20rpx;
}

.radio-item-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(0, 0, 0, 0.05);
}

.radio-text {
  font-size: 26rpx;
  color: #333;
}

.btn-primary {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #FF6B00, #FF9F43);
  color: #fff;
  border-radius: 999rpx;
  height: 92rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92%;
  max-width: 560rpx;
  margin-left: auto;
  margin-right: auto;
  font-weight: 800;
  font-size: 28rpx;
  letter-spacing: 0.6rpx;
  box-shadow: 0 14rpx 34rpx rgba(255, 107, 0, 0.20);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.result-card {
  padding-top: 34rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111;
}

.btn-link {
  font-size: 26rpx;
  color: #FF6B00;
}

.result-box {
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.04);
}

.result-img {
  width: 100%;
  height: 520rpx;
  display: block;
}

.actions {
  margin-top: 22rpx;
  display: flex;
  gap: 18rpx;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.06);
  color: #111;
  font-weight: 700;
  font-size: 30rpx;
}

.actions .btn-primary {
  flex: 1;
  margin-top: 0;
}

.generating-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.generating-card {
  width: 100%;
  max-width: 620rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.generating-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(255, 107, 0, 0.18);
  border-top-color: #FF6B00;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 26rpx;
}

.generating-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #111;
}

.generating-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
