.page {
  min-height: 100vh;
  background: #FBF7F2;
  padding: 32rpx 28rpx 0;
  box-sizing: border-box;
  position: relative;
}

.ambient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
}

.orb-1 {
  width: 420rpx;
  height: 420rpx;
  background: #F6E9E4;
  top: -160rpx;
  right: -120rpx;
}

.orb-2 {
  width: 360rpx;
  height: 360rpx;
  background: #E9F0E8;
  top: 120rpx;
  left: -140rpx;
}

.header {
  position: relative;
  z-index: 1;
  margin-bottom: 30rpx;
}

.header-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #4A3A3E;
  letter-spacing: 2rpx;
}

.header-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #9B8A8C;
}

.grid {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.card {
  width: calc((100% - 40rpx) / 3);
  background: #FFFDFB;
  border-radius: 26rpx;
  padding: 18rpx 12rpx 20rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(176, 138, 128, 0.10);
  border: 1rpx solid #F0E4DC;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.thumb-wrap {
  width: 100%;
  height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb {
  width: 150rpx;
  height: 150rpx;
}

.card-name {
  margin-top: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #4A3A3E;
}

.card-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #B7A9A9;
}

.footer-tip {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
  text-align: center;
  font-size: 23rpx;
  color: #C2B4B4;
}

.empty-state {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 60rpx 80rpx;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 28rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #6B5B5B;
  margin-bottom: 14rpx;
}

.empty-desc {
  font-size: 25rpx;
  color: #B7A9A9;
  line-height: 1.6;
}

.safe-bottom {
  height: 80rpx;
}
