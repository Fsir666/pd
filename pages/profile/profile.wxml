<view class="page-container">
  <!-- 顶部大标题背景 (可选，保持页面层次感) -->
  <view class="header-bg"></view>

  <view class="container">
    <!-- 头部用户信息区 (去卡片化，更轻盈) -->
    <view class="user-header-section">
      <view class="user-row" bindtap="{{!isLogged ? 'onLoginTap' : ''}}" hover-class="hover-scale">
        <view class="avatar-container" bindtap="{{isLogged ? 'onEditTap' : ''}}" hover-class="{{isLogged ? 'hover-scale' : ''}}">
          <image class="avatar" src="{{userInfo.avatarUrl || '/images/avatars/avatar_1.svg'}}" mode="aspectFill"></image>
          <view class="edit-badge glass-icon" wx:if="{{isLogged}}" catchtap="onEditTap">✎</view>
        </view>
        
        <view class="user-info-block">
          <block wx:if="{{isLogged}}">
            <text class="nickname">{{userInfo.nickName}}</text>
            <view class="id-tag" wx:if="{{userInfo.userId}}">ID: {{userInfo.userId}}</view>
            <view class="follow-entry" bindtap="goToFollowList" hover-class="hover-scale">
              <text class="follow-entry-text">关注 {{followingCount}} · 粉丝 {{followerCount}}</text>
            </view>
          </block>
          <block wx:else>
            <text class="nickname">点击登录</text>
            <text class="login-tip">登录同步数据，开启拼豆之旅</text>
          </block>
        </view>
        
        <view class="arrow-right" wx:if="{{!isLogged}}">
          <text class="icon-chevron"></text>
        </view>
      </view>

      <!-- 资产数据栏 (独立微型卡片 Widgets) -->
      <view class="stats-row" wx:if="{{isLogged}}">
        <view class="stat-widget" hover-class="hover-scale" bindtap="openCoins">
          <text class="stat-num">{{userInfo.coins}}</text>
          <text class="stat-label">豆币</text>
          <view class="stat-icon-bg coin-bg">💰</view>
        </view>
        <view class="stat-widget" hover-class="hover-scale">
          <text class="stat-num">{{userInfo.energy}}</text>
          <text class="stat-label">体力</text>
          <view class="stat-icon-bg energy-bg">⚡</view>
        </view>
      </view>
    </view>

    <!-- 每日签到卡片（留存钩子：一眼可见，不用进弹窗） -->
    <view class="checkin-card" wx:if="{{isLogged}}" bindtap="onCheckinTap" hover-class="checkin-card-active">
      <view class="checkin-left">
        <view class="checkin-title-row">
          <text class="checkin-title">每日签到</text>
          <text class="checkin-streak-badge" wx:if="{{walletStreak > 0}}">连签 {{walletStreak}} 天</text>
        </view>
        <text class="checkin-sub">{{checkedInToday ? '今天已签到，明天再来~' : '点击签到，领豆币 + 体力'}}</text>
      </view>
      <view class="checkin-btn {{checkedInToday ? 'done' : ''}}">
        <text>{{checkedInToday ? '已签到' : '签到'}}</text>
      </view>
    </view>

    <!-- 菜单列表 (Inset Grouped Style) -->
    <view class="menu-group">
      <view class="menu-item" bindtap="goToMyWorks" hover-class="hover-scale">
        <view class="item-left">
          <view class="icon-box color-blue">
            <text class="menu-icon">🎨</text>
          </view>
          <text class="item-title">我的作品</text>
        </view>
        <view class="item-right">
          <text class="icon-chevron"></text>
        </view>
      </view>
      
      <view class="menu-item" bindtap="goToMyCollections" hover-class="hover-scale">
        <view class="item-left">
          <view class="icon-box color-yellow">
            <text class="menu-icon">⭐️</text>
          </view>
          <text class="item-title">收藏图纸</text>
        </view>
        <view class="item-right">
          <text class="icon-chevron"></text>
        </view>
      </view>

      <view class="menu-item" bindtap="goToMyWarehouse" hover-class="hover-scale">
        <view class="item-left">
          <view class="icon-box color-purple">
            <text class="menu-icon">🏰</text>
          </view>
          <text class="item-title">我的仓库</text>
        </view>
        <view class="item-right">
          <text class="icon-chevron"></text>
        </view>
      </view>
      
      <view class="menu-item" bindtap="goToMyOrders" hover-class="hover-scale">
        <view class="item-left">
          <view class="icon-box color-orange">
            <text class="menu-icon">📦</text>
          </view>
          <text class="item-title">我的订单</text>
        </view>
        <view class="item-right">
          <text class="icon-chevron"></text>
        </view>
      </view>
    </view>

    <view class="menu-group" wx:if="{{isLogged}}">
      <view class="menu-item" bindtap="openDailyTasks" hover-class="hover-scale">
        <view class="item-left">
          <view class="icon-box color-green">
            <text class="menu-icon">✅</text>
          </view>
          <text class="item-title">每日任务</text>
        </view>
        <view class="item-right">
          <text class="icon-chevron"></text>
        </view>
      </view>
      <view class="menu-item" bindtap="openInvite" hover-class="hover-scale">
        <view class="item-left">
          <view class="icon-box color-purple">
            <text class="menu-icon">🎁</text>
          </view>
          <text class="item-title">邀请好友</text>
        </view>
        <view class="item-right">
          <text class="icon-chevron"></text>
        </view>
      </view>
    </view>

    <view class="menu-group" wx:if="{{isAdmin}}">
      <view class="menu-item" bindtap="goToAdminDrafts" hover-class="hover-scale">
        <view class="item-left">
          <view class="icon-box color-orange">
            <text class="menu-icon">🛠️</text>
          </view>
          <text class="item-title">图纸库管理</text>
          <view class="admin-badge">管理员</view>
        </view>
        <view class="item-right">
          <text class="icon-chevron"></text>
        </view>
      </view>
    </view>

    <view class="menu-group" wx:if="{{isLogged && !isAdmin}}">
      <view class="menu-item" bindtap="openAdminChannel" hover-class="hover-scale">
        <view class="item-left">
          <view class="icon-box color-gray">
            <text class="menu-icon">🔐</text>
          </view>
          <text class="item-title">管理员通道</text>
        </view>
        <view class="item-right">
          <text class="icon-chevron"></text>
        </view>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="goToContact" hover-class="hover-scale">
        <view class="item-left">
          <view class="icon-box color-green">
            <text class="menu-icon">💬</text>
          </view>
          <text class="item-title">联系客服</text>
        </view>
        <view class="item-right">
          <text class="icon-chevron"></text>
        </view>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="goToChangelog" hover-class="hover-scale">
        <view class="item-left">
          <view class="icon-box color-purple">
            <text class="menu-icon">🚀</text>
          </view>
          <text class="item-title">版本概览</text>
        </view>
        <view class="item-right">
          <text class="icon-chevron"></text>
        </view>
      </view>
    </view>

    <!-- 退出登录 (独立 Destructive Action) -->
    <view class="logout-section" wx:if="{{isLogged}}">
      <button class="logout-btn" bindtap="onLogoutTap" hover-class="hover-scale">退出登录</button>
    </view>
    
    <!-- Bottom Padding for TabBar -->
    <view style="height: 160rpx;"></view>
  </view>

  <!-- 用户信息授权/填写弹窗 -->
  <view class="auth-modal-mask" wx:if="{{showAuthModal}}">
    <view class="auth-modal glass-card">
      <view class="auth-title">完善个人信息</view>
      <view class="auth-form">
        <view class="form-item">
          <text class="form-label">头像（选填）</text>
          <view class="avatar-wrapper" bindtap="onRegisterAvatarTap">
            <image class="auth-avatar" src="{{registerForm.avatarUrl || '/images/avatars/avatar_1.svg'}}"></image>
          </view>
        </view>
        <view class="form-item">
          <text class="form-label">昵称</text>
          <input type="nickname" class="nickname-input" placeholder="请输入昵称" value="{{registerForm.nickName}}" bindinput="onNicknameInput" bindblur="onNicknameInput" />
        </view>
        <view class="form-item">
          <text class="form-label">手机号</text>
          <text class="nickname-input" wx:if="{{registerForm.phone}}">{{registerForm.phone}}</text>
          <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">授权登录</button>
        </view>
      </view>
      <button class="submit-btn" bindtap="onRegisterSubmit">保存并登录</button>
      <view class="close-btn" bindtap="onCloseAuthModal">暂不登录</view>
    </view>
  </view>

  <view class="auth-modal-mask" wx:if="{{showEditModal}}">
    <view class="auth-modal glass-card">
      <view class="auth-title">编辑个人信息</view>
      <view class="auth-form">
        <view class="form-item">
          <text class="form-label">头像</text>
          <view class="avatar-wrapper" bindtap="onEditAvatarTap">
            <image class="auth-avatar" src="{{editForm.avatarUrl || userInfo.avatarUrl || '/images/avatars/avatar_1.svg'}}"></image>
          </view>
        </view>
        <view class="form-item">
          <text class="form-label">昵称</text>
          <input type="nickname" class="nickname-input" placeholder="请输入昵称" value="{{editForm.nickName}}" bindinput="onEditNicknameInput" bindblur="onEditNicknameInput" />
        </view>
        <view class="form-item textarea">
          <text class="form-label">简介</text>
          <textarea class="bio-input" placeholder="写点个人简介（可选）" value="{{editForm.bio}}" maxlength="80" auto-height bindinput="onEditBioInput" />
        </view>
      </view>
      <button class="submit-btn" bindtap="onEditSave" loading="{{editSaving}}" disabled="{{editSaving}}">保存</button>
      <view class="close-btn" bindtap="onCloseEditModal">取消</view>
    </view>
  </view>

  <view class="auth-modal-mask" wx:if="{{showCoinsModal}}">
    <view class="auth-modal glass-card">
      <view class="auth-title">豆币</view>
      <view class="coin-balance">{{userInfo.coins}}</view>
      <view class="coin-sub">余额</view>
      <view class="coin-sub" wx:if="{{walletToday}}">{{walletToday}} · 连签 {{walletStreak}} 天</view>

      <view class="coin-actions">
        <button class="coin-action-btn {{checkedInToday ? 'done' : ''}}" bindtap="onCheckinTap">{{checkedInToday ? '已签到' : '签到'}}</button>
        <button class="coin-action-btn" bindtap="openDailyTasks">任务</button>
        <button class="coin-action-btn" bindtap="openInvite">邀请</button>
      </view>

      <view class="coin-help">
        <view class="coin-help-title">使用说明</view>
        <view class="coin-help-text">- 抠图：5 豆币/次</view>
        <view class="coin-help-text">- 转卡通：10 豆币/次</view>
        <view class="coin-help-text">- 获取方式：签到、每日任务、分享奖励、邀请奖励</view>
      </view>

      <view class="coin-ledger">
        <view class="coin-help-title">交易记录</view>
        <view class="coin-ledger-meta">已加载 {{coinLedger.length}} 条</view>
        <view class="coin-ledger-empty" wx:if="{{!coinLedger.length && !coinLedgerLoading}}">暂无记录</view>
        <view class="coin-ledger-row" wx:for="{{coinLedger}}" wx:key="idx">
          <view class="coin-ledger-left">
            <text class="coin-ledger-title">{{item.title}}</text>
            <text class="coin-ledger-time">{{item.time}}</text>
          </view>
          <view class="coin-ledger-right">
            <text class="coin-ledger-delta {{item.delta>0?'plus':'minus'}}">{{item.delta>0?'+':''}}{{item.delta}}</text>
            <text class="coin-ledger-balance" wx:if="{{item.balanceAfter!==null}}">余 {{item.balanceAfter}}</text>
          </view>
        </view>
        <button class="coin-more" wx:if="{{coinLedgerHasMore && !coinLedgerLoading}}" bindtap="loadMoreCoinLedger">加载更多</button>
        <view class="coin-loading" wx:if="{{coinLedgerLoading}}">加载中...</view>
      </view>

      <button class="submit-btn" bindtap="closeCoins">关闭</button>
    </view>
  </view>

  <view class="auth-modal-mask" wx:if="{{showDailyTasksModal}}">
    <view class="auth-modal glass-card">
      <view class="auth-title">每日任务</view>
      <view class="task-subtitle">{{dailyTaskDay}}</view>
      <view class="task-list">
        <view class="task-row" wx:for="{{dailyTasks}}" wx:key="id">
          <view class="task-left">
            <text class="task-title">{{item.title}}</text>
            <text class="task-progress">{{item.progress.cur}}/{{item.progress.need}}</text>
          </view>
          <view class="task-right">
            <view class="task-reward">+{{item.rewardCoins}}</view>
            <button class="task-btn" wx:if="{{item.canClaim}}" data-id="{{item.id}}" bindtap="onClaimDailyTask">领取</button>
            <view class="task-state" wx:elif="{{item.claimed}}">已领</view>
            <view class="task-state" wx:else>未完成</view>
          </view>
        </view>
      </view>
      <button class="submit-btn" bindtap="closeDailyTasks">关闭</button>
    </view>
  </view>

  <view class="auth-modal-mask" wx:if="{{showInviteModal}}">
    <view class="auth-modal glass-card">
      <view class="auth-title">邀请好友</view>
      <view class="invite-block">
        <text class="invite-label">我的邀请码</text>
        <view class="invite-row">
          <text class="invite-code">{{inviteCode}}</text>
          <button class="invite-copy" bindtap="copyInviteCode">复制</button>
        </view>
        <text class="invite-tip">分享任意作品即可自动带上邀请码</text>
        <text class="invite-reward">邀请奖励：你 +{{inviterReward}} 豆币 · 好友 +{{inviteeReward}} 豆币</text>
        <text class="invite-tip">已邀请 {{invitedCount}} 人</text>
        <text class="invite-tip" wx:if="{{invitedBy}}">已绑定邀请人</text>
      </view>

      <view class="invite-records">
        <view class="invite-records-title">邀请记录</view>
        <view class="invite-records-empty" wx:if="{{!inviteRecords.length && !inviteRecordsLoading}}">暂无邀请记录</view>
        <view class="invite-records-row" wx:for="{{inviteRecords}}" wx:key="idx">
          <image class="invite-records-avatar" src="{{item.avatarUrl || '/images/avatars/avatar_1.svg'}}" mode="aspectFill"></image>
          <view class="invite-records-info">
            <text class="invite-records-name">{{item.nickName}}</text>
            <text class="invite-records-time">{{item.registerTime}}</text>
          </view>
        </view>
        <button class="invite-more" wx:if="{{inviteRecordsHasMore && !inviteRecordsLoading}}" bindtap="loadMoreInviteRecords">加载更多</button>
        <view class="invite-loading" wx:if="{{inviteRecordsLoading}}">加载中...</view>
      </view>

      <view class="auth-form" wx:if="{{!invitedBy}}">
        <view class="form-item">
          <text class="form-label">邀请码</text>
          <input class="nickname-input" placeholder="填写好友邀请码" value="{{inviteInput}}" bindinput="onInviteInput" />
        </view>
      </view>
      <button class="submit-btn" wx:if="{{!invitedBy}}" bindtap="bindInvite">确认绑定</button>
      <button class="submit-btn" bindtap="closeInvite">关闭</button>
    </view>
  </view>
</view>
<privacy-popup />
