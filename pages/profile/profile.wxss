/* Modern iOS Style Profile Page - Refactored */

/* 1. Global Container & Background */
.page-container {
  min-height: 100vh;
  background-color: #FBF7F2; /* iOS System Grouped Background */
  position: relative;
  overflow-x: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

/* Ensure bottom padding for custom tab bar */
page {
  padding-bottom: calc(120rpx + 40rpx + env(safe-area-inset-bottom));
}

/* Optional Top Gradient for Depth */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 500rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.4) 0%, rgba(242,242,247,0) 100%);
  z-index: 0;
  pointer-events: none;
}

.container {
  position: relative;
  z-index: 1;
  padding: 32rpx;
  /* 适配刘海屏/动态岛，增加顶部安全距离 */
  padding-top: calc(env(safe-area-inset-top) + 40rpx);
  padding-bottom: calc(120rpx + 40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 2. User Header Section */
.user-header-section {
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.user-row {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
}

/* Avatar Styling */
.avatar-container {
  position: relative;
  margin-right: 32rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #FFFDFB;
  box-shadow: 0 10rpx 30rpx rgba(176, 138, 128, 0.16), 0 4rpx 10rpx rgba(176, 138, 128, 0.12); /* Double shadow */
}

.edit-badge {
  position: absolute;
  bottom: 6rpx;
  right: 6rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #D4607A;
  /* Glassmorphism */
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 12rpx rgba(176, 138, 128, 0.18);
}

/* User Info Text */
.user-info-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nickname {
  font-size: 48rpx;
  font-weight: 700;
  color: #4A3A3E;
  margin-bottom: 12rpx;
  letter-spacing: -1rpx;
}

.id-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #9B8A8C;
  background: #F0E4DC; /* Light Gray Capsule */
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  align-self: flex-start;
  font-weight: 500;
}

.follow-entry {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(176, 138, 128, 0.12);
}

.follow-entry-text {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(74, 58, 62, 0.78);
}

.login-tip {
  font-size: 28rpx;
  color: #9B8A8C;
}

/* 3. Stats Widgets (Micro Cards) */
.stats-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.stat-widget {
  flex: 1;
  background: #FFFDFB;
  border-radius: 32rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(176, 138, 128, 0.10);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  border: 1rpx solid rgba(176, 138, 128, 0.08);
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700; /* Bold DIN-like */
  color: #4A3A3E;
  margin-bottom: 8rpx;
  z-index: 2;
  font-family: -apple-system-headline, sans-serif;
}

.stat-label {
  font-size: 24rpx;
  color: #9B8A8C;
  font-weight: 500;
  z-index: 2;
}

.stat-icon-bg {
  position: absolute;
  bottom: -10rpx;
  right: -10rpx;
  font-size: 80rpx;
  opacity: 0.1;
  transform: rotate(-15deg);
  z-index: 1;
}

/* 4. Menu Group (Inset Grouped) */
/* 每日签到卡片 */
.checkin-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FDF0EC 0%, #FBE9E4 100%);
  border: 1rpx solid #EFD9D2;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 96, 122, 0.1);
}

.checkin-card-active {
  transform: scale(0.98);
  opacity: 0.92;
}

.checkin-left {
  flex: 1;
  min-width: 0;
}

.checkin-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.checkin-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #A8455C;
}

.checkin-streak-badge {
  font-size: 20rpx;
  font-weight: 600;
  color: #FFFDFB;
  background: linear-gradient(135deg, #D4607A, #E0909A);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.checkin-sub {
  font-size: 23rpx;
  color: #9B8A8C;
  line-height: 1.4;
}

.checkin-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  min-width: 130rpx;
  height: 66rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D4607A, #E0909A);
  color: #FFFDFB;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(212, 96, 122, 0.3);
}

.checkin-btn.done {
  background: #F6E9E4;
  color: #C2B4B4;
  box-shadow: none;
}

.menu-group {
  background: #FFFDFB;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(176, 138, 128, 0.08);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: #FFFDFB;
  position: relative;
  transition: background 0.2s;
}

/* Divider Line */
.menu-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 112rpx; /* Icon width + spacing */
  right: 0;
  height: 1rpx;
  background: #F0E4DC;
}

.item-left {
  display: flex;
  align-items: center;
}

/* Icons with Colored Backgrounds */
.icon-box {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.menu-icon {
  font-size: 34rpx;
}

.color-blue { background: #D4607A; }
.color-blue .menu-icon { filter: brightness(100); } /* White icon */

.color-yellow { background: #E0B45C; }
.color-yellow .menu-icon { filter: brightness(100); }

.color-orange { background: #D89A5C; }
.color-orange .menu-icon { filter: brightness(100); }

.color-green { background: #7A9E7E; }
.color-green .menu-icon { filter: brightness(100); }

.color-purple { background: #B49AC4; }
.color-purple .menu-icon { filter: brightness(100); }

/* Override for emoji icons if they are text, use white text color */
.icon-box text {
  color: #FFFDFB;
}

.item-title {
  font-size: 32rpx;
  color: #4A3A3E;
  font-weight: 500;
}

/* Chevron Right Arrow */
.icon-chevron::after {
  content: '';
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #C2B4B4;
  border-right: 4rpx solid #C2B4B4;
  transform: rotate(45deg);
  margin-right: 6rpx;
}

/* 5. Logout Button (Destructive) */
.logout-section {
  margin-top: 40rpx;
  margin-bottom: 60rpx;
}

.logout-btn {
  background: #FFFDFB;
  color: #C0485C; /* System Red */
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 24rpx;
  padding: 24rpx 0;
  width: 100%;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(176, 138, 128, 0.08);
  border: none;
}

.logout-btn::after {
  border: none;
}

/* 6. Micro-Interactions */
.hover-scale {
  transform: scale(0.96);
  opacity: 0.8;
  transition: all 0.15s cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* Auth Modal (Glass Style) */
.auth-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(74, 58, 62, 0.42);
  backdrop-filter: blur(5px);
  z-index: 999;
  display: flex;
  justify-content: center;
  align-items: center;
}

.auth-modal {
  width: 620rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(30px);
  border-radius: 40rpx;
  padding: 56rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(176, 138, 128, 0.20);
}

.auth-title {
  font-size: 38rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 48rpx;
  color: #4A3A3E;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(176, 138, 128, 0.16); /* Separator Color */
}

.form-label {
  width: 120rpx;
  font-size: 32rpx;
  color: #4A3A3E;
  font-weight: 500;
}

.avatar-wrapper {
  padding: 0;
  width: 120rpx !important;
  height: 120rpx !important;
  border-radius: 50%;
  margin: 0 !important;
  background: #FBF7F2;
  border: 1rpx solid #F0E4DC;
}

.auth-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.nickname-input {
  flex: 1;
  font-size: 32rpx;
  padding: 10rpx;
  color: #4A3A3E;
}

.form-item.textarea {
  align-items: flex-start;
}

.form-item.textarea .form-label {
  padding-top: 10rpx;
}

.bio-input {
  flex: 1;
  font-size: 30rpx;
  padding: 10rpx;
  color: #4A3A3E;
  min-height: 90rpx;
  line-height: 1.4;
}

.phone-btn {
  font-size: 28rpx;
  color: #D4607A;
  background: rgba(212, 96, 122, 0.1);
  padding: 14rpx 28rpx;
  border-radius: 16rpx;
  margin-left: auto;
  font-weight: 600;
}

.submit-btn {
  margin-top: 56rpx;
  background: #D4607A;
  color: white;
  border-radius: 28rpx;
  width: 100% !important;
  font-weight: 600;
  padding: 28rpx 0;
  font-size: 34rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 96, 122, 0.3);
}

.close-btn {
  margin-top: 32rpx;
  text-align: center;
  font-size: 30rpx;
  color: #9B8A8C;
}

.task-subtitle {
  text-align: center;
  font-size: 24rpx;
  color: #9B8A8C;
  margin-top: -32rpx;
  margin-bottom: 32rpx;
}

.task-list {
  max-height: 600rpx;
  overflow: scroll;
}

.task-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(176, 138, 128, 0.16);
}

.task-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.task-title {
  font-size: 30rpx;
  color: #4A3A3E;
  font-weight: 600;
}

.task-progress {
  font-size: 24rpx;
  color: #9B8A8C;
}

.task-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.task-reward {
  font-size: 26rpx;
  color: #D4607A;
  font-weight: 700;
}

.task-btn {
  font-size: 26rpx;
  color: #D4607A;
  background: rgba(212, 96, 122, 0.12);
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  font-weight: 700;
}

.task-btn::after {
  border: none;
}

.task-state {
  font-size: 26rpx;
  color: #9B8A8C;
  font-weight: 600;
}

.invite-block {
  margin-top: -14rpx;
  margin-bottom: 32rpx;
}

.invite-label {
  font-size: 26rpx;
  color: #9B8A8C;
  font-weight: 600;
}

.invite-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0 8rpx;
}

.invite-code {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #4A3A3E;
}

.invite-copy {
  font-size: 26rpx;
  color: #D4607A;
  background: rgba(212, 96, 122, 0.12);
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  font-weight: 700;
}

.invite-copy::after {
  border: none;
}

.invite-tip {
  display: block;
  font-size: 24rpx;
  color: #9B8A8C;
  margin-top: 10rpx;
}

.invite-reward {
  display: block;
  font-size: 24rpx;
  color: rgba(74, 58, 62, 0.72);
  margin-top: 12rpx;
  font-weight: 700;
}

.invite-records {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(176, 138, 128, 0.16);
  max-height: 420rpx;
  overflow: scroll;
}

.invite-records-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #4A3A3E;
  margin-bottom: 10rpx;
}

.invite-records-empty {
  font-size: 24rpx;
  color: #9B8A8C;
  padding: 12rpx 0;
}

.invite-records-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.invite-records-row:not(:last-child) {
  border-bottom: 1rpx solid rgba(176, 138, 128, 0.12);
}

.invite-records-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background: rgba(176, 138, 128, 0.10);
  flex: 0 0 auto;
}

.invite-records-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.invite-records-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #4A3A3E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invite-records-time {
  font-size: 24rpx;
  color: #9B8A8C;
}

.invite-more {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #D4607A;
  background: rgba(212, 96, 122, 0.12);
  padding: 14rpx 22rpx;
  border-radius: 16rpx;
  font-weight: 700;
}

.invite-more::after {
  border: none;
}

.invite-loading {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9B8A8C;
  text-align: center;
}

.coin-balance {
  text-align: center;
  font-size: 72rpx;
  font-weight: 900;
  color: #4A3A3E;
  margin-top: -10rpx;
}

.coin-sub {
  text-align: center;
  font-size: 24rpx;
  color: #9B8A8C;
  margin-top: 10rpx;
}

.coin-actions {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
}

.coin-action-btn {
  flex: 1;
  font-size: 26rpx;
  color: #D4607A;
  background: rgba(212, 96, 122, 0.12);
  padding: 16rpx 0;
  border-radius: 18rpx;
  font-weight: 700;
}

.coin-action-btn::after {
  border: none;
}

.coin-help {
  margin-top: 28rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(176, 138, 128, 0.16);
}

.coin-help-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #4A3A3E;
  margin-bottom: 10rpx;
}

.coin-help-text {
  font-size: 24rpx;
  color: #9B8A8C;
  line-height: 36rpx;
}

.coin-ledger {
  margin-top: 22rpx;
  max-height: 520rpx;
  overflow: scroll;
}

.coin-ledger-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(176, 138, 128, 0.12);
}

.coin-ledger-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.coin-ledger-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A3A3E;
}

.coin-ledger-time {
  font-size: 22rpx;
  color: #9B8A8C;
}

.coin-ledger-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.coin-ledger-delta {
  font-size: 30rpx;
  font-weight: 900;
}

.coin-ledger-delta.plus {
  color: #7A9E7E;
}

.coin-ledger-delta.minus {
  color: #C0485C;
}

.coin-ledger-balance {
  font-size: 22rpx;
  color: #9B8A8C;
}

.coin-ledger-empty {
  text-align: center;
  font-size: 24rpx;
  color: #9B8A8C;
  padding: 22rpx 0;
}

.coin-ledger-meta {
  font-size: 22rpx;
  color: #9B8A8C;
  margin-bottom: 6rpx;
}

.coin-more {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #D4607A;
  background: rgba(212, 96, 122, 0.10);
  border-radius: 18rpx;
  padding: 16rpx 0;
  font-weight: 700;
}

.coin-more::after {
  border: none;
}

.coin-loading {
  text-align: center;
  font-size: 24rpx;
  color: #9B8A8C;
  padding: 18rpx 0;
}

/* Custom TabBar Styles (Preserved) */
.custom-tabbar {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: saturate(180%) blur(50px);
  -webkit-backdrop-filter: saturate(180%) blur(50px);
  border-radius: 55rpx;
  border-top: 0.5px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 10rpx 40rpx rgba(176, 138, 128, 0.18);
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 9999;
  box-sizing: border-box;
  padding: 10rpx;
  overflow: hidden;
}

.tab-cursor {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  width: 25%;
  background: #FFFDFB;
  border-radius: 45rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08), 0 0 1rpx rgba(0,0,0,0.1);
  transition: left 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  z-index: 1;
  pointer-events: none;
}

.tab-cursor.no-transition {
  transition: none !important;
}

.tab-item {
  position: relative;
  z-index: 100;
  flex: 1;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #B7A9A9;
  font-weight: normal;
  transition: all 0.25s;
}

.tab-item.active {
  color: #000;
  font-weight: 800;
  font-size: 30rpx;
  transform: scale(1.05);
}
