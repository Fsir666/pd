<view class="page-root">
  <view class="ambient-bg">
    <view class="orb orb-1"></view>
    <view class="orb orb-2"></view>
    <view class="orb orb-3"></view>
  </view>

  <scroll-view scroll-y class="container">
    <view class="tools-header">
      <text class="page-title">工具箱</text>
      <text class="page-desc">Creativity & Utility</text>
    </view>

    <!-- Core Tools Section (Featured) -->
    <view class="section-title">✨ 核心创作</view>
    <view class="featured-grid">
      <view class="featured-card primary" bindtap="onToolTap" data-id="1">
        <view class="card-bg-icon">🖼️</view>
        <view class="card-content">
          <view class="card-icon pulse">🖼️</view>
          <view class="card-text">
            <text class="card-title">图片转像素</text>
            <text class="card-desc">生成拼豆图纸</text>
          </view>
        </view>
        <view class="card-action">Go</view>
      </view>

      <view class="featured-card secondary" bindtap="onToolTap" data-id="9">
        <view class="card-bg-icon">🪄</view>
        <view class="card-content">
          <view class="card-icon wiggle">🪄</view>
          <view class="card-text">
            <text class="card-title">照片转卡通</text>
            <text class="card-desc">一键卡通化</text>
          </view>
        </view>
        <view class="card-action">Go</view>
      </view>

    </view>

    <!-- Utility Tools Section (Grid) -->
    <view class="section-title">🛠️ 实用工具</view>
    <view class="utility-grid-modern">
      <block wx:for="{{allTools}}" wx:key="id">
        <view class="utility-item glass-morphism" bindtap="onToolTap" data-id="{{item.id}}">
          <view class="utility-icon-box" style="background-color: {{item.bg || '#F0F2F5'}}">
            <text class="utility-icon {{item.animClass}}">{{item.icon}}</text>
          </view>
          <text class="utility-title">{{item.title}}</text>
        </view>
      </block>
      <!-- Coming Soon -->
      <view class="utility-item glass-morphism coming-soon" bindtap="onToolTap" data-id="0">
        <view class="utility-icon-box">
          <text class="utility-icon">➕</text>
        </view>
        <text class="utility-title">更多...</text>
      </view>
    </view>
  </scroll-view>
</view>
