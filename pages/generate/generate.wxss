/* ============================================================
   悠米拼豆 · generate 页
   视觉体系：奶油手作 S1
   底色暖奶油 / 主色覆盆子粉 / 辅色鼠尾草绿 / 大圆角厚卡片
   ============================================================ */

/* ---------- 页面根 ---------- */
.page-root {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  background-color: var(--ym-bg, #FBF7F2);
  overflow-x: hidden;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Helvetica Neue", Arial, sans-serif;
}

/* ---------- 背景柔光 ---------- */
.ambient-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90rpx);
  opacity: 0.55;
}

.orb-1 {
  width: 620rpx;
  height: 620rpx;
  background: var(--ym-primary-wash, #F6E9E4);
  top: -220rpx;
  right: -200rpx;
}

.orb-2 {
  width: 520rpx;
  height: 520rpx;
  background: var(--ym-honey-wash, #F7EEDF);
  bottom: 12%;
  left: -120rpx;
}

/* ---------- 卡片基座 ---------- */
.glass-card {
  background: var(--ym-surface, #FFFDFB);
  border-radius: var(--ym-r-xl, 32rpx);
  box-shadow: var(--ym-shadow, 0 6rpx 20rpx rgba(176, 138, 128, 0.10));
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  transition: transform 0.28s cubic-bezier(0.25, 0.8, 0.25, 1),
    box-shadow 0.28s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.glass-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 3rpx 10rpx rgba(176, 138, 128, 0.10);
}

/* ---------- 上传区 ---------- */
.upload-container {
  display: flex;
  flex-direction: column;
  padding: 32rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}

.upload-card {
  min-height: 190rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 32rpx;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  background: var(--ym-primary-wash, #F6E9E4);
  border: 2rpx dashed var(--ym-line-strong, #E4D5CB);
}

.upload-card:active {
  transform: scale(0.99);
  background: #F3E3DC;
}

.upload-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  z-index: 1;
}

.upload-icon-box {
  width: 100rpx;
  height: 100rpx;
  background: var(--ym-primary, #D4607A);
  border-radius: var(--ym-r-lg, 26rpx);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 28rpx;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.upload-icon-inner {
  font-size: 44rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
}

.upload-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.upload-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}

.upload-title {
  font-size: 33rpx;
  font-weight: 500;
  color: var(--ym-text, #4A3A3E);
  flex: 1;
}

.upload-arrow {
  font-size: 38rpx;
  color: var(--ym-text-faint, #C2B4B4);
  margin-left: 12rpx;
  line-height: 1;
  transition: transform 0.3s;
}

.upload-card:active .upload-arrow {
  transform: translateX(4rpx);
}

.upload-desc {
  font-size: 25rpx;
  color: var(--ym-text-sub, #9B8A8C);
  line-height: 1.45;
}

.upload-preview {
  width: 132rpx;
  height: 132rpx;
  border-radius: var(--ym-r-md, 20rpx);
  margin-left: 24rpx;
  border: 4rpx solid #FFFFFF;
  flex-shrink: 0;
}

/* ---------- 功能介绍卡 ---------- */
.intro-card {
  padding: 0;
  overflow: hidden;
  background: var(--ym-surface, #FFFDFB);
}

.intro-content {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 32rpx 32rpx 20rpx;
}

.intro-icon {
  font-size: 60rpx;
  line-height: 1;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.intro-text {
  flex: 1;
}

.intro-title {
  font-size: 31rpx;
  font-weight: 500;
  color: var(--ym-text, #4A3A3E);
  margin-bottom: 10rpx;
  line-height: 1.35;
}

.intro-desc {
  font-size: 25rpx;
  color: var(--ym-text-sub, #9B8A8C);
  line-height: 1.65;
  margin: 0;
}

.intro-features {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  padding: 22rpx 24rpx;
  background: var(--ym-bg-sunk, #F5EDE6);
  margin: 0 24rpx 24rpx;
  border-radius: var(--ym-r-md, 20rpx);
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.feature-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
  line-height: 1;
}

.feature-text {
  font-size: 23rpx;
  color: var(--ym-text-sub, #9B8A8C);
  font-weight: 400;
}

.features-list {
  padding: 40rpx;
}

/* ---------- 编辑区 ---------- */
.editor-container {
  padding: 28rpx;
  position: relative;
  z-index: 1;
}

/* ---------- 预览卡 ---------- */
.preview-card {
  padding: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 600rpx;
  background: var(--ym-surface, #FFFDFB);
}

.canvas-container {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.process-canvas, .export-canvas {
  position: absolute;
  top: -9999px;
  left: -9999px;
  visibility: hidden;
}

.compare-overlay {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
  transition: opacity 0.2s ease-out;
  pointer-events: none;
  z-index: 10;
  border-radius: var(--ym-r-sm, 12rpx);
}

.compare-overlay.active {
  opacity: 1;
}

.display-canvas.hidden {
  opacity: 0;
}

.compare-hint {
  position: absolute;
  bottom: 18rpx;
  background: rgba(74, 58, 62, 0.72);
  color: #FFFFFF;
  padding: 8rpx 22rpx;
  border-radius: 30rpx;
  font-size: 23rpx;
  pointer-events: none;
}

/* ---------- 珠子账单 ---------- */
.bead-bill {
  background: var(--ym-mint-wash, #E9F0E8);
  border-radius: var(--ym-r-lg, 26rpx);
  padding: 22rpx 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bead-bill-label {
  font-size: 23rpx;
  color: var(--ym-mint-deep, #4C6B4E);
  margin-bottom: 6rpx;
  line-height: 1;
}

.bead-bill-main {
  font-size: 34rpx;
  font-weight: 500;
  color: #2F4A31;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.bead-bill-tip {
  font-size: 21rpx;
  color: var(--ym-mint-deep, #4C6B4E);
  margin-top: 6rpx;
  line-height: 1.4;
  opacity: 0.85;
}

.bead-bill-side {
  text-align: right;
  flex-shrink: 0;
  padding-left: 20rpx;
}

.bead-bill-side-num {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ym-mint-deep, #4C6B4E);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.bead-bill-side-unit {
  font-size: 21rpx;
  color: var(--ym-mint-deep, #4C6B4E);
  margin-top: 8rpx;
  line-height: 1;
}

/* ---------- 工具行 ---------- */
.tools-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.tool-btn {
  flex: 1;
  height: 148rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--ym-surface, #FFFDFB);
  margin-bottom: 0;
  transition: all 0.28s cubic-bezier(0.25, 0.8, 0.25, 1);
  border: 2rpx solid transparent;
  position: relative;
  overflow: hidden;
}

.tool-btn.active {
  background: var(--ym-primary-wash, #F6E9E4);
  border-color: var(--ym-primary, #D4607A);
  transform: translateY(-2rpx);
  box-shadow: var(--ym-shadow, 0 6rpx 20rpx rgba(176, 138, 128, 0.10));
}

.tool-icon {
  font-size: 44rpx;
  color: var(--ym-text-faint, #C2B4B4);
  margin-bottom: 10rpx;
  font-weight: 400;
  line-height: 1;
  transition: color 0.24s;
}

.tool-btn.active .tool-icon {
  color: var(--ym-primary, #D4607A);
}

.tool-label {
  font-size: 24rpx;
  color: var(--ym-text-sub, #9B8A8C);
  font-weight: 400;
  transition: color 0.24s;
}

.tool-btn.active .tool-label {
  color: var(--ym-primary-deep, #A8455C);
  font-weight: 500;
}

/* ---------- 设置卡通用 ---------- */
.settings-card {
  padding: 30rpx;
  background: var(--ym-surface, #FFFDFB);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.card-title {
  font-size: 31rpx;
  font-weight: 500;
  color: var(--ym-text, #4A3A3E);
}

.value-badge {
  background: var(--ym-primary-wash, #F6E9E4);
  color: var(--ym-primary-deep, #A8455C);
  font-size: 24rpx;
  font-weight: 400;
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  font-variant-numeric: tabular-nums;
}

.header-right-text {
  font-size: 24rpx;
  color: var(--ym-text-sub, #9B8A8C);
}

.brand-badge {
  background: var(--ym-mint-wash, #E9F0E8);
  color: var(--ym-mint-deep, #4C6B4E);
  font-size: 22rpx;
  font-weight: 400;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  margin-left: 12rpx;
}

/* ---------- 滑块 ---------- */
.slider-container {
  padding: 0 8rpx;
}

.size-hint {
  font-size: 23rpx;
  color: var(--ym-text-sub, #9B8A8C);
  text-align: center;
  margin-top: 14rpx;
  line-height: 1.5;
}

/* ---------- 分段控件 ---------- */
.ios-segmented-control {
  display: flex;
  background: var(--ym-bg-sunk, #F5EDE6);
  padding: 4rpx;
  border-radius: var(--ym-r-md, 20rpx);
}

.ios-segment {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--ym-text-sub, #9B8A8C);
  font-weight: 400;
  border-radius: var(--ym-r-sm, 12rpx);
  transition: all 0.24s ease;
}

.ios-segment.active {
  background: var(--ym-surface-pure, #FFFFFF);
  color: var(--ym-text, #4A3A3E);
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(176, 138, 128, 0.12);
}

/* ---------- 品牌横向滚动 chips ---------- */
.brand-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 0;
}

/* 横滑条内层：inline-flex 让宽度随内容撑开，scroll-view 才能算出可滚动宽度 */
.brand-scroll-inner,
.series-scroll-inner {
  display: inline-flex;
  padding-bottom: 6rpx;
}

.series-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 22rpx;
  border-top: 2rpx solid var(--ym-line, #F0E4DC);
  padding-top: 22rpx;
}

.ios-chip {
  display: inline-flex;
  padding: 15rpx 30rpx;
  background: var(--ym-bg-sunk, #F5EDE6);
  border-radius: 40rpx;
  margin-right: 16rpx;
  color: var(--ym-text-sub, #9B8A8C);
  font-size: 27rpx;
  font-weight: 400;
  transition: all 0.28s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
  overflow: visible;
  border: 2rpx solid transparent;
  white-space: nowrap;
  min-width: auto;
  flex-shrink: 0;
}

.ios-chip.small {
  padding: 11rpx 24rpx;
  font-size: 24rpx;
}

.ios-chip.active {
  background: var(--ym-primary, #D4607A);
  color: #FFFFFF;
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 20rpx rgba(212, 96, 122, 0.28);
  border-color: transparent;
}

.ios-chip:active {
  transform: scale(0.96);
}

.ios-chip.active:active {
  transform: translateY(-2rpx) scale(0.98);
}

/* ---------- 用色统计 ---------- */
.stats-tabs-container {
  display: flex;
  background: var(--ym-bg-sunk, #F5EDE6);
  border-radius: var(--ym-r-md, 20rpx);
  padding: 4rpx;
  margin-bottom: 22rpx;
  width: fit-content;
}

.stats-tab {
  padding: 10rpx 30rpx;
  font-size: 25rpx;
  color: var(--ym-text-sub, #9B8A8C);
  border-radius: var(--ym-r-sm, 12rpx);
  transition: all 0.24s;
}

.stats-tab.active {
  background: var(--ym-surface-pure, #FFFFFF);
  color: var(--ym-text, #4A3A3E);
  font-weight: 500;
  box-shadow: 0 2rpx 6rpx rgba(176, 138, 128, 0.10);
}

.stats-list-container {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 14rpx;
  border-bottom: 2rpx solid var(--ym-line, #F0E4DC);
}

.stats-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.stats-row-left {
  display: flex;
  align-items: center;
}

.stats-index {
  width: 38rpx;
  font-size: 23rpx;
  color: var(--ym-text-faint, #C2B4B4);
  font-variant-numeric: tabular-nums;
}

.stats-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid rgba(74, 58, 62, 0.06);
}

.stats-info {
  display: flex;
  flex-direction: column;
}

.stats-code-text {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ym-text, #4A3A3E);
}

.stats-hex-text {
  font-size: 21rpx;
  color: var(--ym-text-sub, #9B8A8C);
  text-transform: uppercase;
}

.stats-count-text {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ym-text, #4A3A3E);
  font-variant-numeric: tabular-nums;
}

/* ---------- 辅助粗线 ---------- */
.aux-grid-panel {
  padding: 24rpx 28rpx;
  margin-top: -8rpx;
  margin-bottom: 24rpx;
}

.aux-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.aux-label {
  font-size: 25rpx;
  color: var(--ym-text-sub, #9B8A8C);
}

.aux-segments {
  display: flex;
}

.aux-chip {
  padding: 8rpx 26rpx;
  font-size: 24rpx;
  background: var(--ym-bg-sunk, #F5EDE6);
  color: var(--ym-text-sub, #9B8A8C);
  border-radius: 30rpx;
  margin-left: 14rpx;
  transition: all 0.24s;
}

.aux-chip.active {
  background: var(--ym-mint, #7A9E7E);
  color: #FFFFFF;
}

/* ---------- 底部操作栏 ---------- */
.bottom-float-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: rgba(251, 247, 242, 0.96);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  padding: 22rpx 28rpx;
  padding-bottom: calc(22rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 26rpx rgba(176, 138, 128, 0.12);
  z-index: 100;
  box-sizing: border-box;
  border-top: 2rpx solid var(--ym-line, #F0E4DC);
  transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.bottom-float-bar.hidden {
  transform: translateY(100%);
}

.bottom-actions-row {
  display: flex;
  gap: 20rpx;
}

.ios-btn-primary {
  flex: 1;
  background: var(--ym-primary, #D4607A);
  color: #FFFFFF;
  border-radius: 52rpx;
  font-size: 31rpx;
  font-weight: 500;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 22rpx rgba(212, 96, 122, 0.30);
  transition: all 0.28s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
  overflow: hidden;
}

.ios-btn-primary:active {
  transform: scale(0.985);
  opacity: 0.92;
  box-shadow: 0 4rpx 14rpx rgba(212, 96, 122, 0.24);
}

.ios-btn-white {
  flex: 1;
  background: var(--ym-surface-pure, #FFFFFF);
  color: var(--ym-primary-deep, #A8455C);
  border: 2rpx solid var(--ym-line-strong, #E4D5CB);
  border-radius: 52rpx;
  font-size: 31rpx;
  font-weight: 500;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.28s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
  overflow: hidden;
}

.ios-btn-white:active {
  background: var(--ym-bg-sunk, #F5EDE6);
  transform: scale(0.985);
}

.full {
  width: 100%;
}
