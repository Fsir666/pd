.page-root {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  background-color: #F2F2F7;
  overflow-x: hidden;
}

.ambient-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.65;
}

.orb-1 {
  width: 560rpx;
  height: 560rpx;
  background: #E0C3FC;
  top: -200rpx;
  left: -140rpx;
}

.orb-2 {
  width: 520rpx;
  height: 520rpx;
  background: #D4F1F4;
  top: 260rpx;
  right: -180rpx;
}

.orb-3 {
  width: 460rpx;
  height: 460rpx;
  background: #FFD1FF;
  bottom: 6%;
  left: 18%;
}

.glass-card {
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.05);
  border-radius: 32rpx;
}

.container {
  position: relative;
  z-index: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.loading,
.empty {
  text-align: center;
  margin-top: 180rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(29, 29, 31, 0.55);
}

.profile-card {
  display: flex;
  gap: 18rpx;
  padding: 18rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 44rpx;
  background: rgba(17, 17, 20, 0.06);
  flex: 0 0 auto;
}

.meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.name-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.name-block {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.nick {
  font-size: 34rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.uid {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(29, 29, 31, 0.52);
}

.follow-btn {
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 106, 0, 1);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.follow-btn.following {
  background: rgba(17, 17, 20, 0.08);
  color: rgba(29, 29, 31, 0.78);
}

.bio {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(29, 29, 31, 0.62);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-row {
  display: flex;
  gap: 20rpx;
  margin-top: 4rpx;
}

.stat {
  flex: 0 0 auto;
  min-width: 120rpx;
  padding: 12rpx 16rpx;
  border-radius: 22rpx;
  background: rgba(17, 17, 20, 0.04);
}

.stat-num {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.9);
}

.stat-label {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(29, 29, 31, 0.55);
  margin-top: 4rpx;
}

.section-title {
  margin-top: 18rpx;
  margin-bottom: 12rpx;
  padding: 0 6rpx;
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.92);
}

.works-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.work-card {
  overflow: hidden;
}

.work-img {
  width: 100%;
  background: rgba(255, 255, 255, 0.45);
}

.work-title {
  padding: 14rpx 14rpx 0;
  font-size: 26rpx;
  font-weight: 900;
  color: rgba(29, 29, 31, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-meta {
  padding: 8rpx 14rpx 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.work-like {
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(29, 29, 31, 0.65);
}
