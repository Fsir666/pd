/* Modern iOS Style Community Page */
.page-container {
  min-height: 100vh;
  background-color: #FBF7F2; /* iOS System Grouped Background */
  position: relative;
  overflow: hidden;
}

.ambient-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.65;
}

.orb-1 {
  width: 560rpx;
  height: 560rpx;
  background: #F6E9E4;
  top: -200rpx;
  left: -140rpx;
  animation: float 10s infinite ease-in-out;
}

.orb-2 {
  width: 520rpx;
  height: 520rpx;
  background: #E9F0E8;
  top: 260rpx;
  right: -180rpx;
  animation: float 12s infinite ease-in-out reverse;
}

.orb-3 {
  width: 460rpx;
  height: 460rpx;
  background: #F7EEDF;
  bottom: 6%;
  left: 18%;
  animation: float 15s infinite ease-in-out 2s;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(18rpx, 28rpx); }
}

/* Header Background Gradient */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 400rpx;
  background: linear-gradient(180deg, #E4D5CB 0%, rgba(251,247,242,0) 100%);
  z-index: 0;
  pointer-events: none;
}

.content-container {
  padding: 0 24rpx;
  position: relative;
  z-index: 1;
  padding-top: calc(env(safe-area-inset-top) + 16rpx);
  box-sizing: border-box;
}

/* Page Header */
.page-header {
  padding: 18rpx 10rpx 18rpx;
}

.title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.header-search-btn {
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(74,58,62,0.88);
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255,255,255,0.7);
  box-shadow: 0 8rpx 24rpx rgba(176,138,128,0.10);
}

.header-search-btn:active {
  transform: scale(0.98);
}

.page-title {
  font-size: 68rpx;
  font-weight: 800;
  color: #000;
  display: block;
  letter-spacing: -1rpx;
}

.title-badge {
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #D4607A;
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255,255,255,0.7);
  box-shadow: 0 8rpx 24rpx rgba(176,138,128,0.10);
  flex-shrink: 0;
}

.page-subtitle {
  font-size: 28rpx;
  color: #9B8A8C;
  font-weight: 500;
  margin-top: 8rpx;
  display: block;
}

.chip-scroll {
  width: 100%;
  margin: 0 0 14rpx;
}

.chip-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 6rpx;
}

.chip {
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(74,58,62,0.62);
  background: rgba(255,255,255,0.48);
  border: 1rpx solid rgba(255,255,255,0.7);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  white-space: nowrap;
}

.chip.active {
  color: #FFFDFB;
  background: linear-gradient(135deg, #D4607A 0%, #C2576E 100%);
  border-color: rgba(212,96,122,0.35);
  box-shadow: 0 10rpx 28rpx rgba(212,96,122,0.28);
}

.user-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 18rpx;
  margin: 0 0 16rpx;
}

.user-search-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(74,58,62,0.90);
}

.user-search-clear {
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(176,138,128,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(74,58,62,0.74);
}

.user-search-results {
  padding: 18rpx;
  margin: 0 0 18rpx;
}

.user-search-title {
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(74,58,62,0.90);
  margin-bottom: 10rpx;
}

.user-search-loading,
.user-search-empty {
  padding: 18rpx 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(74,58,62,0.56);
}

.user-row-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 6rpx;
}

.user-row-item + .user-row-item {
  border-top: 1rpx solid rgba(176,138,128,0.10);
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(176,138,128,0.10);
  flex: 0 0 auto;
}

.user-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-row-name {
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(74,58,62,0.90);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-row-bio {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(74,58,62,0.52);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.follow-btn {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(212,96,122,1);
  color: #FFFDFB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  flex: 0 0 auto;
}

.follow-btn.following {
  background: rgba(74,58,62,0.08);
  color: rgba(74,58,62,0.78);
}

.search-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.18);
  z-index: 999;
  padding: calc(env(safe-area-inset-top) + 18rpx) 18rpx 18rpx;
  box-sizing: border-box;
}

.search-panel {
  width: 100%;
  max-height: calc(100vh - env(safe-area-inset-top) - 36rpx);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid rgba(176,138,128,0.12);
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(74,58,62,0.90);
}

.search-clear,
.search-close {
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(176,138,128,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(74,58,62,0.74);
}

.search-results {
  padding: 10rpx 16rpx 16rpx;
  overflow-y: auto;
  flex: 1;
  box-sizing: border-box;
}

.search-loading,
.search-empty {
  padding: 26rpx 6rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(74,58,62,0.56);
}

.search-section {
  padding: 12rpx 0;
}

.search-section + .search-section {
  border-top: 1rpx solid rgba(176,138,128,0.12);
}

.search-section-title {
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(74,58,62,0.90);
  padding: 6rpx 6rpx 10rpx;
}

.work-row-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 6rpx;
}

.work-row-item + .work-row-item {
  border-top: 1rpx solid rgba(176,138,128,0.10);
}

.work-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(176,138,128,0.10);
  flex: 0 0 auto;
}

.work-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.work-row-title {
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(74,58,62,0.90);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-row-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.work-row-author,
.work-row-like {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(74,58,62,0.56);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 统一信息流：图纸 / 作品 混排卡片 */
.feed-pattern .card-img-square {
  width: 100%;
  height: 320rpx;
  display: block;
}

.feed-badge {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  height: 36rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(212,96,122,0.92);
  color: #FFFDFB;
  font-size: 20rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(212,96,122,0.30);
}

.feed-tag-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #A8455C;
  background: rgba(212,96,122,0.10);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.bead-count {
  font-size: 22rpx;
  color: #B7A9A9;
  font-weight: 600;
}

/* 图纸卡作者行（头像 + 昵称 + 点赞数） */
.feed-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F0E4DC;
}

.feed-author-avatar {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background-size: cover;
  background-position: center;
  flex-shrink: 0;
}

.feed-author-avatar-fb {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #D4607A, #E0909A);
  color: #FFFDFB;
  font-size: 18rpx;
  font-weight: 600;
}

.feed-author-name {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  color: #9B8A8C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-like {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #D4607A;
  font-weight: 600;
}

.feed-more {
  background: rgba(255,255,255,0.62);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.7);
  box-shadow: 0 10rpx 34rpx rgba(176,138,128,0.12);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.feed-more-inner {
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.feed-more-icon {
  font-size: 52rpx;
}

.feed-more-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #A8455C;
}

.feed-more-arrow {
  font-size: 34rpx;
  color: #A8455C;
  margin-top: -8rpx;
}

/* 以下为历史样式，已随「图纸库」独立板块下线而停用（保留以免误删关联） */


/* Waterfall Layout */
.waterfall-container {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.waterfall-column {
  width: 48%; /* Two columns with spacing */
  display: flex;
  flex-direction: column;
}

/* Glass Card Style */
.card-item {
  background: rgba(255,255,255,0.62);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 34rpx rgba(176,138,128,0.12);
  border: 1rpx solid rgba(255,255,255,0.7);
  transition: transform 0.2s;
}

.card-item:active {
  transform: scale(0.98);
}

.card-media {
  position: relative;
}

.card-img {
  width: 100%;
  display: block;
  background-color: #F0E4DC;
}

.card-media-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.12) 100%);
  pointer-events: none;
}

.card-info {
  padding: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3A3E;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: #7A6A6E;
}

.author-info {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background-color: #F0E4DC;
}

.avatar-placeholder {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #E4D5CB;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20rpx;
  color: #FFFDFB;
  margin-right: 10rpx;
  font-weight: bold;
}

.author-name {
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.likes-info {
  display: flex;
  align-items: center;
}

.like-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

/* Empty State */
.empty-state {
  padding: 16rpx 0 0;
}

.empty-card {
  background: rgba(255,255,255,0.62);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.75);
  box-shadow: 0 14rpx 44rpx rgba(176,138,128,0.16);
  padding: 28rpx 26rpx;
}

.empty-hero {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: rgba(255,255,255,0.7);
  border: 1rpx solid rgba(255,255,255,0.8);
  box-shadow: 0 10rpx 28rpx rgba(176,138,128,0.12);
  flex-shrink: 0;
}

.empty-texts {
  flex: 1;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #4A3A3E;
  letter-spacing: -0.4px;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(74,58,62,0.6);
}

.empty-actions {
  margin-top: 22rpx;
  display: flex;
  gap: 16rpx;
}

.empty-reset {
  margin-top: 18rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 600;
  color: #A8455C;
  padding: 12rpx 0;
}

.primary-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #FFFDFB;
  background: linear-gradient(135deg, #D4607A, #E0909A);
  box-shadow: 0 14rpx 34rpx rgba(212,96,122,0.28);
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn::after {
  border: none;
}

.ghost-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: rgba(74,58,62,0.78);
  background: rgba(255,255,255,0.56);
  border: 1rpx solid rgba(255,255,255,0.82);
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ghost-btn::after {
  border: none;
}

/* Ensure bottom padding for custom tab bar */
page {
  padding-bottom: calc(120rpx + 40rpx + env(safe-area-inset-bottom));
}

.page-container {
  padding-bottom: calc(120rpx + 40rpx + env(safe-area-inset-bottom));
}

/* Custom Refresher */
.custom-refresher {
  width: 100vw;
  height: 200rpx;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding-bottom: 20rpx;
}

.refresh-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.refresh-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
  transition: transform 0.1s;
}

.refresh-icon.rotating {
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.refresh-text {
  font-size: 24rpx;
  color: #B7A9A9;
}

/* iOS 26 悬浮导航栏 (Custom Floating TabBar) - Apple Glass Style */
.custom-tabbar {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  height: 110rpx;
  background: rgba(255,255,255,0.65); /* Ultra low opacity white */
  backdrop-filter: saturate(180%) blur(50px); /* The "Apple Glass" Magic */
  -webkit-backdrop-filter: saturate(180%) blur(50px);
  border-radius: 55rpx;
  border-top: 0.5px solid rgba(255,255,255,0.5);
  box-shadow: 0 10rpx 40rpx rgba(176,138,128,0.18);
  display: flex;
  justify-content: space-between; /* Distribute items */
  align-items: center;
  z-index: 9999;
  box-sizing: border-box;
  padding: 10rpx; /* Padding for cursor containment */
  overflow: hidden; /* Clip cursor */
}

.tab-cursor {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  width: 25%; /* 4 tabs -> 25% each */
  background: #FFFDFB;
  border-radius: 45rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08), 0 0 1rpx rgba(0,0,0,0.1);
  transition: left 0.25s cubic-bezier(0.2, 0.8, 0.2, 1); /* Smooth spring-like */
  z-index: 1;
  pointer-events: none; /* Let clicks pass through */
}

.tab-cursor.no-transition {
  transition: none !important;
}

.tab-item {
  position: relative;
  z-index: 100; /* Above cursor */
  flex: 1;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #B7A9A9;
  font-weight: normal;
  transition: all 0.25s;
}

.tab-item.active {
  color: #000;
  font-weight: 800; /* Bold */
  font-size: 30rpx;
  transform: scale(1.05);
}
