/* pages/my-collections/my-collections.wxss — 奶油手作 S1 */

.page-root {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  background: var(--ym-bg, #FBF7F2);
  overflow-x: hidden;
}

/* 奶油暖调氛围 */
.ambient-bg {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.5;
}

.orb-1 {
  width: 460rpx; height: 460rpx;
  background: #F6D7DE;
  top: -120rpx; left: -100rpx;
}

.orb-2 {
  width: 380rpx; height: 380rpx;
  background: #E4EBDC;
  bottom: 8%; right: -90rpx;
}

.orb-3 {
  width: 320rpx; height: 320rpx;
  background: #F7E6CE;
  top: 45%; left: 18%;
}

.container {
  position: relative;
  z-index: 1;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.loading {
  text-align: center;
  margin-top: 200rpx;
  color: var(--ym-text-3, #B9A79C);
  font-size: 28rpx;
}

/* 统计条 */
.stat-bar {
  display: flex;
  align-items: center;
  background: var(--ym-surface, #FFFDFB);
  border: 1rpx solid var(--ym-line, #F0E4DC);
  border-radius: var(--ym-r-lg, 26rpx);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(74, 58, 62, 0.06);
}

.stat-main {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stat-num {
  font-size: 50rpx;
  font-weight: 700;
  color: var(--ym-primary, #D4607A);
  line-height: 1;
}

.stat-label {
  font-size: 24rpx;
  color: var(--ym-text-3, #B9A79C);
}

.stat-divider {
  width: 1rpx;
  height: 46rpx;
  background: var(--ym-line, #F0E4DC);
  margin: 0 28rpx;
}

.stat-side { flex: 1; }

.stat-side-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ym-accent, #D89A5C);
}

.stat-side-num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ym-text-1, #4A3A34);
}

.stat-side-label {
  font-size: 22rpx;
  color: var(--ym-text-3, #B9A79C);
}

/* 两列网格 */
.collection-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.card {
  background: var(--ym-surface, #FFFDFB);
  border: 1rpx solid var(--ym-line, #F0E4DC);
  border-radius: var(--ym-r-lg, 26rpx);
  overflow: hidden;
  box-shadow: 0 6rpx 22rpx rgba(74, 58, 62, 0.06);
  transition: transform 0.15s;
}

.card:active { transform: scale(0.975); }

.card-img-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  background: var(--ym-bg-sunk, #F5EFE8);
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-size {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(74, 58, 62, 0.55);
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.5;
}

.card-info {
  padding: 16rpx 18rpx 18rpx;
}

.card-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ym-text-1, #4A3A34);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.meta-text {
  font-size: 19rpx;
  color: var(--ym-primary, #D4607A);
  background: #F9E8EC;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
}

.meta-text.alt {
  color: var(--ym-secondary, #7A9E7E);
  background: #EAF0E8;
}

.btn-share-sm {
  margin-left: auto;
  height: 44rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #D4607A;
  background: #F9E8EC;
  border-radius: 999rpx;
  line-height: 1;
  flex-shrink: 0;
}

.btn-share-sm::after { border: none; }

.btn-share-sm:active { opacity: 0.85; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
}

.empty-img {
  width: 220rpx;
  height: 220rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}

.empty-text {
  font-size: 32rpx;
  color: var(--ym-text-1, #4A3A34);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-tips {
  font-size: 25rpx;
  color: var(--ym-text-3, #B9A79C);
  margin-bottom: 48rpx;
}

.go-home-btn {
  background: linear-gradient(135deg, #D4607A, #E0909A);
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 20rpx 72rpx;
  border-radius: 100rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 26rpx rgba(212, 96, 122, 0.28);
}

.go-home-btn:active { opacity: 0.9; }