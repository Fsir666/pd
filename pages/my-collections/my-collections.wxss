/* pages/my-collections/my-collections.wxss — 奶油手作 S1 */

.page-root {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  background: var(--ym-bg, #FBF7F2);
  overflow-x: hidden;
}

/* 奶油暖调氛围 */
.ambient-bg {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.5;
}

.orb-1 {
  width: 460rpx; height: 460rpx;
  background: #F6D7DE;
  top: -120rpx; left: -100rpx;
}

.orb-2 {
  width: 380rpx; height: 380rpx;
  background: #E4EBDC;
  bottom: 8%; right: -90rpx;
}

.orb-3 {
  width: 320rpx; height: 320rpx;
  background: #F7E6CE;
  top: 45%; left: 18%;
}

.container {
  position: relative;
  z-index: 1;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.loading {
  text-align: center;
  margin-top: 200rpx;
  color: var(--ym-text-3, #B9A79C);
  font-size: 28rpx;
}

.collection-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  display: flex;
  flex-direction: row;
  padding: 18rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(160, 130, 115, 0.10);
  box-sizing: border-box;
  transition: transform 0.15s;
}

.card:active { transform: scale(0.985); }

.card-img {
  width: 176rpx;
  height: 176rpx;
  border-radius: 20rpx;
  background: #F5EFE8;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ym-text-1, #4A3A34);
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-author {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.author-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--ym-primary, #D4607A);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.card-author text {
  font-size: 24rpx;
  color: var(--ym-text-3, #B9A79C);
}

.card-heat {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--ym-accent, #D89A5C);
  font-weight: 500;
}

.heat-icon { margin-right: 6rpx; font-size: 22rpx; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 220rpx;
  height: 220rpx;
  margin-bottom: 24rpx;
  opacity: 0.85;
}

.empty-text {
  font-size: 32rpx;
  color: var(--ym-text-1, #4A3A34);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-tips {
  font-size: 26rpx;
  color: var(--ym-text-3, #B9A79C);
  margin-bottom: 48rpx;
}

.go-home-btn {
  background: var(--ym-primary, #D4607A);
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 20rpx 72rpx;
  border-radius: 100rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(212, 96, 122, 0.28);
}

.go-home-btn:active { opacity: 0.9; }
