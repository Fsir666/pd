<view class="page-root">
  <!-- 氛围背景 -->
  <view class="ambient-bg">
    <view class="orb orb-1"></view>
    <view class="orb orb-2"></view>
    <view class="orb orb-3"></view>
  </view>

  <view class="container">
    <!-- 统计条 -->
    <view class="stat-bar" wx:if="{{!loading && totalCount > 0}}">
      <view class="stat-main">
        <view class="stat-num">{{totalCount}}</view>
        <view class="stat-label">张图纸</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-side">
        <view class="stat-side-item">
          <text class="stat-dot"></text>
          <text class="stat-side-num">{{totalBeads}}</text>
          <text class="stat-side-label">颗珠子</text>
        </view>
      </view>
    </view>

    <block wx:if="{{loading}}">
      <view class="loading">加载中...</view>
    </block>

    <block wx:elif="{{collections.length > 0}}">
      <view class="collection-grid">
        <view class="card" wx:for="{{collections}}" wx:key="_id" bindtap="goToDetail"
              data-id="{{item._id}}" data-key="{{item.key}}" data-title="{{item.title}}" data-img="{{item.imageUrl}}">
          <view class="card-img-wrap">
            <image class="card-img" src="{{item.thumb || item.imageUrl}}" mode="aspectFill"></image>
            <view class="card-size" wx:if="{{item.sizeText}}">{{item.sizeText}}</view>
          </view>
          <view class="card-info">
            <view class="card-title">{{item.title}}</view>
            <view class="card-meta">
              <text class="meta-text" wx:if="{{item.beadCount}}">{{item.beadCount}} 颗</text>
              <text class="meta-text alt" wx:if="{{item.colorCount}}">{{item.colorCount}} 色</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="empty-state">
        <image class="empty-img" src="/images/empty-box.png" mode="aspectFit"></image>
        <text class="empty-text">还没收藏</text>
        <view class="empty-tips">去首页转转吧，看到喜欢的图纸点个收藏</view>
        <button class="go-home-btn" bindtap="goToHome">去首页</button>
      </view>
    </block>
  </view>
</view>

<!-- 全局隐私授权弹窗 -->
<privacy-popup />
