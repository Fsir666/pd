/* ============================================================
   悠米拼豆 · 广场 square
   视觉体系：奶油手作 S1
   ============================================================ */

.page-root {
  min-height: 100vh;
  background: var(--ym-bg, #FBF7F2);
  position: relative;
}

.paper-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--ym-bg, #FBF7F2);
  z-index: -1;
}

.scroll {
  height: 100vh;
}

.content {
  padding: 24rpx;
}

/* ---------- 通用区块 ---------- */
.section {
  margin-bottom: 28rpx;
  background: var(--ym-surface, #FFFDFB);
  border-radius: var(--ym-r-xl, 32rpx);
  padding: 28rpx;
  box-shadow: var(--ym-shadow, 0 6rpx 20rpx rgba(176, 138, 128, 0.10));
  border: 2rpx solid rgba(255, 255, 255, 0.7);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.section-icon {
  font-size: 34rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 500;
  color: var(--ym-text, #4A3A3E);
}

/* ---------- 轮播 ---------- */
.banner-swiper {
  width: 100%;
  height: 300rpx;
  border-radius: var(--ym-r-lg, 26rpx);
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  position: relative;
}

/* 低饱和暖色渐变，替换原来的高饱和撞色 */
.banner-item-1 {
  background: linear-gradient(135deg, #D4607A, #E0909A);
}

.banner-item-2 {
  background: linear-gradient(135deg, #7A9E7E, #94BCAA);
}

.banner-item-3 {
  background: linear-gradient(135deg, #96C4A8, #E8C79A);
}

.banner-item-4 {
  background: linear-gradient(135deg, #C9A8BC, #E8D5D0);
}

.banner-item-5 {
  background: linear-gradient(135deg, #A896C4, #C9AEC0);
}

.banner-content {
  text-align: center;
  padding: 0 40rpx;
}

.banner-title {
  font-size: 35rpx;
  font-weight: 500;
  margin-bottom: 14rpx;
  display: block;
}

.banner-desc {
  font-size: 27rpx;
  margin-bottom: 30rpx;
  line-height: 1.45;
  display: block;
  opacity: 0.92;
}

.banner-btn {
  display: inline-block;
  padding: 14rpx 44rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 44rpx;
  font-size: 27rpx;
  font-weight: 400;
  transition: all 0.2s ease;
}

.banner-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.32);
}

/* ---------- 公告栏 ---------- */
.notice-card {
  background: var(--ym-bg-sunk, #F5EDE6);
  border-radius: var(--ym-r-md, 20rpx);
  overflow: hidden;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid rgba(176, 138, 128, 0.08);
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  background: var(--ym-primary, #D4607A);
  color: #fff;
  font-size: 22rpx;
  font-weight: 400;
  border-radius: var(--ym-r-sm, 12rpx);
  margin-right: 16rpx;
}

.notice-text {
  font-size: 27rpx;
  color: var(--ym-text, #4A3A3E);
  line-height: 1.55;
  flex: 1;
}

/* ---------- 新手教程 ---------- */
.tutorial-grid {
  display: flex;
  gap: 16rpx;
}

.tutorial-card {
  flex: 1;
  background: var(--ym-bg-sunk, #F5EDE6);
  border-radius: var(--ym-r-md, 20rpx);
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.tutorial-card:active {
  transform: scale(0.98);
  background: #EFE4DA;
}

.tutorial-icon {
  font-size: 46rpx;
  margin-bottom: 12rpx;
}

.tutorial-title {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--ym-text, #4A3A3E);
  margin-bottom: 8rpx;
}

.tutorial-desc {
  font-size: 22rpx;
  color: var(--ym-text-sub, #9B8A8C);
  line-height: 1.35;
}

/* ---------- 功能介绍 ---------- */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: var(--ym-bg-sunk, #F5EDE6);
  border-radius: var(--ym-r-md, 20rpx);
  transition: all 0.2s ease;
}

.feature-item:active {
  background: #EFE4DA;
}

.feature-icon {
  font-size: 38rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.feature-content {
  flex: 1;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--ym-text, #4A3A3E);
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: var(--ym-text-sub, #9B8A8C);
  line-height: 1.45;
}

/* ---------- 拼豆礼物 ---------- */
.coming-soon-tag {
  margin-left: auto;
  padding: 6rpx 18rpx;
  background: var(--ym-honey, #D89A5C);
  color: #fff;
  font-size: 22rpx;
  font-weight: 400;
  border-radius: 30rpx;
}

.gift-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--ym-honey-wash, #F7EEDF);
  border-radius: var(--ym-r-md, 20rpx);
  border: 2rpx solid rgba(216, 154, 92, 0.28);
  transition: all 0.2s ease;
}

.gift-card:active {
  transform: scale(0.98);
}

.gift-content {
  flex: 1;
}

.gift-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #B97A34;
  margin-bottom: 12rpx;
}

.gift-desc {
  font-size: 26rpx;
  color: var(--ym-text-sub, #9B8A8C);
  line-height: 1.55;
  margin-bottom: 16rpx;
}

.gift-features {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.gift-feature {
  font-size: 24rpx;
  color: #B97A34;
  font-weight: 400;
}

.gift-arrow {
  font-size: 40rpx;
  color: #B97A34;
  margin-left: 16rpx;
}

/* ---------- 即将上线弹窗 ---------- */
.comingsoon-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease, background 0.3s ease;
}

.comingsoon-mask.show {
  opacity: 1;
  pointer-events: auto;
  background: rgba(74, 58, 62, 0.42);
}

.comingsoon-card {
  width: 90%;
  max-width: 640rpx;
  background: var(--ym-surface-pure, #FFFFFF);
  border-radius: var(--ym-r-xl, 32rpx);
  padding: 48rpx 40rpx;
  text-align: center;
  transform: scale(0.9);
  transition: transform 0.3s ease;
}

.comingsoon-mask.show .comingsoon-card {
  transform: scale(1);
}

.comingsoon-title {
  font-size: 35rpx;
  font-weight: 500;
  color: var(--ym-text, #4A3A3E);
  margin-bottom: 24rpx;
}

.comingsoon-desc {
  font-size: 27rpx;
  color: var(--ym-text-sub, #9B8A8C);
  line-height: 1.65;
  margin-bottom: 40rpx;
  white-space: pre-line;
}

.comingsoon-btn {
  display: inline-block;
  padding: 20rpx 64rpx;
  background: var(--ym-primary, #D4607A);
  color: #fff;
  font-size: 30rpx;
  font-weight: 400;
  border-radius: 52rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 96, 122, 0.28);
}
