<view class="page-root">
  <!-- 氛围背景 -->
  <view class="ambient-bg">
    <view class="orb orb-1"></view>
    <view class="orb orb-2"></view>
    <view class="orb orb-3"></view>
  </view>

  <view class="container">
    <block wx:if="{{loading}}">
      <view class="loading">加载中...</view>
    </block>

    <block wx:elif="{{works.length > 0}}">
      <view class="work-list">
        <view class="card" wx:for="{{works}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}" data-title="{{item.title}}" data-img="{{item.imageUrl}}">
          <image class="card-img" src="{{item.imageUrl}}" mode="aspectFill"></image>
          <view class="card-info">
            <view class="card-title">{{item.title}}</view>
            <view class="card-author">
               <image class="author-avatar" src="{{item.userInfo.avatarUrl || userInfo.avatarUrl || '/images/avatars/avatar_1.svg'}}" mode="aspectFill"></image>
               <text>{{item.author}}</text>
            </view>
            <view class="card-heat">
              <text class="heat-icon">🔥</text>
              <text>{{item.heat || 0}}</text>
            </view>
          </view>
          
          <!-- 公开状态开关 -->
          <view class="card-action" catchtap="preventBubble">
            <switch checked="{{item.isPublic}}" bindchange="onPublicToggle" data-id="{{item._id}}" data-index="{{index}}" color="#D4607A" style="transform: scale(0.7);"/>
            <text class="action-text">{{item.isPublic ? '已公开' : '私密'}}</text>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="empty-state">
        <image class="empty-img" src="/images/empty-box.png" mode="aspectFit"></image>
        <text class="empty-text">还没作品</text>
        <view class="empty-tips">快去发布你的第一个作品吧</view>
        <button class="go-create-btn" bindtap="goToCreate">去创作</button>
      </view>
    </block>
  </view>
</view>
