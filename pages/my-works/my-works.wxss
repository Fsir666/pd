/* pages/my-works/my-works.wxss —— 奶油手作 S1 */

.page-root {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  background-color: var(--ym-bg, #FBF7F2);
  overflow-x: hidden;
}

/* Ambient Diffused Background */
.ambient-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.55;
}

.orb-1 {
  width: 560rpx;
  height: 560rpx;
  background: #F6E9E4; /* 覆盆子粉淡光 */
  top: -160rpx;
  left: -120rpx;
  animation: float 10s infinite ease-in-out;
}

.orb-2 {
  width: 480rpx;
  height: 480rpx;
  background: #F7EEDF; /* 蜂蜜淡光 */
  bottom: 12%;
  right: -110rpx;
  animation: float 12s infinite ease-in-out reverse;
}

.orb-3 {
  width: 400rpx;
  height: 400rpx;
  background: #E9F0E8; /* 鼠尾草淡光 */
  top: 42%;
  left: 18%;
  animation: float 15s infinite ease-in-out 2s;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(20rpx, 30rpx); }
}

.container {
  position: relative;
  z-index: 1;
  padding: 30rpx;
  box-sizing: border-box;
}

.loading {
  text-align: center;
  margin-top: 200rpx;
  color: var(--ym-text-sub, #9B8A8C);
  font-size: 28rpx;
}

/* 作品卡片 */
.work-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--ym-surface, #FFFDFB);
  border: 1rpx solid var(--ym-line, #F0E4DC);
  border-radius: var(--ym-r-lg, 26rpx);
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(74, 58, 62, 0.06);
  transition: transform 0.2s;
}

.card:active {
  transform: scale(0.98);
}

.card-img {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
  margin: 18rpx 0 18rpx 18rpx;
  border-radius: var(--ym-r-md, 20rpx);
  background: var(--ym-bg-sunk, #F5EDE6);
}

.card-info {
  flex: 1;
  min-width: 0;
  padding: 22rpx 16rpx 22rpx 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ym-text, #4A3A3E);
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-author {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.author-avatar {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--ym-bg-sunk, #F5EDE6);
  margin-right: 10rpx;
  flex-shrink: 0;
}

.card-author text {
  font-size: 24rpx;
  color: var(--ym-text-sub, #9B8A8C);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-heat {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: var(--ym-primary, #D4607A);
  font-weight: 600;
}

.heat-icon {
  margin-right: 6rpx;
  font-size: 22rpx;
}

/* 公开状态开关 */
.card-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  padding: 0 22rpx;
  border-left: 1rpx solid var(--ym-line, #F0E4DC);
  flex-shrink: 0;
}

.action-text {
  font-size: 20rpx;
  color: var(--ym-text-sub, #9B8A8C);
  margin-top: 6rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 220rpx;
  height: 220rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 34rpx;
  color: var(--ym-text, #4A3A3E);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty-tips {
  font-size: 27rpx;
  color: var(--ym-text-sub, #9B8A8C);
  margin-bottom: 56rpx;
}

.go-create-btn {
  background: linear-gradient(135deg, #D4607A, #E0909A);
  color: #FFFDFB;
  font-size: 30rpx;
  padding: 22rpx 84rpx;
  border-radius: 999rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 26rpx rgba(212, 96, 122, 0.28);
  transition: opacity 0.2s;
}

.go-create-btn:active {
  opacity: 0.9;
}
