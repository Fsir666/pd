.intro-container {
  min-height: 100vh;
  background-color: var(--ym-bg, #FBF7F2);
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
}

/* 顶部 Header */
.intro-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
}

.icon-bg {
  width: 160rpx;
  height: 160rpx;
  background: var(--ym-surface, #FFFDFB);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 40rpx rgba(212, 96, 122, 0.12);
  margin-bottom: 30rpx;
}

.header-icon {
  font-size: 80rpx;
}

.app-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--ym-text, #4A3A3E);
  margin-bottom: 10rpx;
}

.app-subtitle {
  font-size: 28rpx;
  color: var(--ym-text-sub, #9B8A8C);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* 功能列表 */
.feature-list {
  flex: 1;
  padding: 0 40rpx;
}

.glass-card {
  background: var(--ym-surface, #FFFDFB);
  border: 1px solid var(--ym-line, #F0E4DC);
  box-shadow: 0 10rpx 40rpx rgba(74, 58, 62, 0.06);
  border-radius: var(--ym-r-xl, 32rpx);
}

.feature-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.feature-icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--ym-r-md, 20rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.feature-icon {
  font-size: 48rpx;
}

.feature-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feature-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ym-text, #4A3A3E);
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 26rpx;
  color: var(--ym-text-sub, #9B8A8C);
  line-height: 1.4;
}

/* 底部按钮 */
.bottom-action {
  padding: 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.enter-btn {
  background: linear-gradient(135deg, #D4607A, #E07A8E);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  padding: 0;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(212, 96, 122, 0.3);
  transition: all 0.3s;
}

.enter-btn:active {
  transform: scale(0.98);
  box-shadow: 0 5rpx 15rpx rgba(212, 96, 122, 0.2);
}