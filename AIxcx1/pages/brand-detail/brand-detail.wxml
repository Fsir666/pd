<view class="container">
  <!-- 顶部筛选区域 -->
  <view class="filter-wrapper">
    <scroll-view class="series-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="series-list">
        <block wx:for="{{subSeriesList}}" wx:key="id">
          <view 
            class="series-item {{currentSeriesId === item.id ? 'active' : ''}}" 
            bindtap="onSwitchSeries" 
            data-id="{{item.id}}">
            {{item.name}}
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <!-- 颜色列表区域 -->
  <scroll-view class="content-scroll" scroll-y enable-flex>
    <view class="scroll-inner">
      <block wx:for="{{groupedColors}}" wx:key="name">
        <view class="color-group">
          <!-- 系列标题 -->
          <view class="group-header" bindtap="toggleGroup" data-index="{{index}}">
            <view class="header-left">
              <view class="group-indicator"></view>
              <text class="group-title">{{item.name}} 系列</text>
            </view>
            <view class="header-right">
              <text class="group-count">{{item.list.length}} 种颜色</text>
              <view class="arrow-icon {{item.expanded ? 'expanded' : ''}}"></view>
            </view>
          </view>

          <!-- 颜色网格容器 (用于动画) -->
          <view class="collapsible-wrapper {{item.expanded ? 'expanded' : ''}}">
            <view class="color-grid">
              <block wx:for="{{item.list}}" wx:for-item="color" wx:key="code">
                <view class="color-card">
                  <view class="color-preview" style="background-color: {{color.hex}};"></view>
                  <view class="color-info">
                    <view class="info-row">
                      <text class="color-code">{{color.code}}</text>
                      <view class="stock-badge" wx:if="{{color.count > 0}}">{{color.count}}</view>
                    </view>
                    <text class="color-hex">{{color.hex}}</text>
                  </view>
                </view>
              </block>
            </view>
          </view>
        </view>
      </block>
      
      <!-- 底部留白 -->
      <view class="footer-spacer"></view>
    </view>
  </scroll-view>
</view>