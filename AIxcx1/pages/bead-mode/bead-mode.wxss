}

.brush-settings-label {
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 12rpx;
  display: block;
}

/* 画笔大小滑动条 */
.brush-size-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.brush-size-value {
  font-size: 28rpx;
