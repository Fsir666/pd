.palette-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  flex-shrink: 0;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(10rpx);
  border-radius: 48rpx 48rpx 0 0;
}

.palette-search-mini {
  flex: 1;
  display: flex;
  align-items: center;
  height: 56rpx;
  background: #f2f2f7;
  border-radius: 28rpx;
  padding: 0 20rpx;
  transition: all 0.3s ease;
}

.palette-search-mini:active {
  background: #e5e5ea;
  transform: scale(0.98);
}

.palette-search-active {
  flex: 1;
  display: flex;
  align-items: center;
  height: 56rpx;
  background: #f2f2f7;
  border-radius: 28rpx;
  padding: 0 20rpx;
  transition: all 0.3s ease;
}

.search-icon-mini {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.search-placeholder-mini {
  font-size: 24rpx;
  color: #8e8e93;
}

.search-input-mini {
  flex: 1;
  font-size: 24rpx;
  color: #1c1c1e;
}

.search-clear-mini {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #c7c7cc;
  border-radius: 18rpx;
  font-size: 20rpx;
  color: #ffffff;
  margin-left: 12rpx;
  transition: all 0.3s ease;
}

.search-clear-mini:active {
  background: #a1a1a6;
  transform: scale(0.95);
}

.palette-toggle-btn {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  background: linear-gradient(135deg, #007aff 0%, #0056b3 100%);
  border-radius: 28rpx;
  flex-shrink: 0;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
}

.palette-toggle-btn:active {
  opacity: 0.9;
  transform: scale(0.96);
  box-shadow: 0 2rpx 6rpx rgba(0, 122, 255, 0.3);
}

.toggle-icon {
  font-size: 20rpx;
  color: #ffffff;
}

.toggle-text {
  font-size: 22rpx;
  color: #ffffff;
  margin-left: 4rpx;
  font-weight: 500;
}

.palette-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2f2f7;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #8e8e93;
  flex-shrink: 0;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.palette-close:active {
  background: #e5e5ea;
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}

.palette-body {
  flex: 1;
  display: flex;
  overflow: hidden;
  padding: 0 12rpx 12rpx;
  gap: 10rpx;
}

.search-body {
  flex-direction: column;
}

.palette-column {
  display: flex;
  flex-direction: column;
  background: #f8f8fa;
  border-radius: 16rpx;
  overflow: hidden;
  transition: width 0.3s ease;
}

.brand-series-column {
  flex-shrink: 0;
  overflow: hidden;
}

.brand-series-column.expanded {
  width: 220rpx;
}

.brand-series-column.collapsed {
  width: 0;
  padding: 0;
  opacity: 0;
}

.color-column {
  flex: 1;
  min-width: 0;
}

.color-column.narrow {
  flex: 1;
}

.color-column.wide {
  flex: 1;
}

.column-header {
  font-size: 22rpx;
  font-weight: 600;
  color: #8e8e93;
  padding: 10rpx 12rpx 8rpx;
  background: #f8f8fa;
  flex-shrink: 0;
}

.column-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 0 8rpx 8rpx;
}

.column-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.empty-text {
  font-size: 22rpx;
  color: #8e8e93;
}

.brand-group {
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #f0f0f5;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.brand-group.expanded {
  border-color: #007aff;
  background: #f8faff;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.1);
}

.brand-header {
  padding: 20rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  transition: all 0.3s ease;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.brand-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #007aff, #5ac8fa);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
}

.brand-group.expanded .brand-header::before {
  transform: scaleX(1);
}

.brand-header:active {
  background: #f8f8fa;
  transform: scale(0.98);
}

.brand-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.brand-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1c1e;
  line-height: 1.2;
}

.brand-count {
  font-size: 20rpx;
  color: #8e8e93;
  font-weight: 400;
  background: #f2f2f7;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  align-self: flex-start;
}

.brand-arrow {
  font-size: 22rpx;
  color: #c7c7cc;
  transition: transform 0.3s ease, color 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: #f2f2f7;
  margin-left: 12rpx;
}

.brand-group.expanded .brand-arrow {
  transform: rotate(90deg);
  color: #007aff;
  background: rgba(0, 122, 255, 0.1);
}

.series-list {
  border-top: 1rpx solid #f0f0f5;
  padding: 16rpx;
  background: #fafafa;
  animation: slideDown 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.series-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
  border: 1rpx solid #f0f0f5;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

.series-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 100%;
  background: transparent;
  transition: background 0.3s ease;
}

.series-card.selected {
  background: #ffffff;
  border-color: #007aff;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.1);
}

.series-card.selected::before {
  background: #007aff;
}

.series-card:active {
  transform: scale(0.98);
  background: #f8f8fa;
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.1);
}

.series-card:last-child {
  margin-bottom: 0;
}

.series-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.series-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1c1c1e;
  flex: 1;
  margin-right: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.series-count {
  font-size: 20rpx;
  color: #8e8e93;
  font-weight: 400;
  background: #f2f2f7;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.recent-section {
  margin-bottom: 8rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  background: #f8f8fa;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.section-header:active {
  background: #e5e5ea;
  transform: scale(0.98);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
}

.section-count {
  font-size: 20rpx;
  color: #8e8e93;
  margin-left: 12rpx;
  background: #e5e5ea;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.section-toggle {
  font-size: 22rpx;
  color: #007aff;
  margin-left: auto;
  padding: 6rpx 16rpx;
  background: rgba(0, 122, 255, 0.1);
  border-radius: 16rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.section-toggle:active {
  background: rgba(0, 122, 255, 0.2);
  transform: scale(0.96);
}

.section-divider {
  height: 1rpx;
  background: #e5e5ea;
  margin: 10rpx 0;
}

.color-section {
  margin-bottom: 10rpx;
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 12rpx;
  background: #f8f8fa;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.color-grid.grid-7 .color-item {
  width: calc(14.28% - 12rpx);
}

.color-grid.grid-10 .color-item {
  width: calc(10% - 12rpx);
}

.color-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 8rpx;
  border-radius: 12rpx;
  transition: transform 0.2s ease;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  cursor: pointer;
}

.color-item:active {
  background: rgba(0, 122, 255, 0.1);
  transform: scale(0.95);
}

.color-circle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  border: 4rpx solid #ffffff;
  margin-bottom: 8rpx;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.color-item:active .color-circle {
  transform: scale(1.1);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.2);
}

.color-code {
  font-size: 20rpx;
  color: #666;
  font-weight: 600;
  font-family: 'SF Mono', 'Menlo', monospace;
  text-align: center;
  transition: all 0.3s ease;
}

.color-item:active .color-code {
  color: #007aff;
  transform: translateY(-2rpx);
}

.search-results {
  flex: 1;
  overflow-y: auto;
}

.search-result-count {
  font-size: 22rpx;
  color: #8e8e93;
  padding: 10rpx 8rpx;
}

.search-result-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 8rpx;
  transition: all 0.2s ease;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

.search-result-card:active {
  background: #f2f2f7;
  transform: scale(0.98);
}

.result-color {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
  border: 2rpx solid #ffffff;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.result-info {
  flex: 1;
  min-width: 0;
}

.result-code {
  font-size: 26rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 2rpx;
}

.result-detail {
  font-size: 20rpx;
  color: #8e8e93;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-action {
  font-size: 22rpx;
  color: #007aff;
  flex-shrink: 0;
  margin-left: 10rpx;
}

.search-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.search-empty-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.search-empty-text {
  font-size: 26rpx;
  color: #1c1c1e;
  margin-bottom: 6rpx;
}

.search-empty-tip {
  font-size: 22rpx;
  color: #8e8e93;
}

