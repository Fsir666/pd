.settings-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 2500;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: maskFadeIn 0.25s ease;
}

.settings-panel {
  width: 85%;
  max-width: 600rpx;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  animation: popIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
}

.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.settings-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.settings-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2f2f7;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #8e8e93;
}

.settings-close:active {
  background: #e5e5ea;
}

.settings-body {
  flex: 1;
  padding: 20rpx 0;
  background: #f2f2f7;
}

/* iOS 风格设置布局 */
.ios-section {
  margin-bottom: 24rpx;
}

.ios-section-header {
  font-size: 24rpx;
  font-weight: 600;
  color: #8e8e93;
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
  padding: 0 32rpx 12rpx;
}

.ios-group {
  background: #ffffff;
  margin: 0 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.ios-cell {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  min-height: 88rpx;
  border-bottom: 1rpx solid #f2f2f7;
  transition: background 0.15s ease;
}

.ios-cell:last-child {
  border-bottom: none;
}

.ios-cell:active {
  background: #f9f9f9;
}

.ios-cell-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.ios-icon-text {
  font-size: 28rpx;
  color: #ffffff;
}

.ios-cell-content {
  flex: 1;
  min-width: 0;
}

.ios-cell-title {
  font-size: 32rpx;
  color: #1c1c1e;
  font-weight: 400;
}

.ios-cell-accessory {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.ios-cell-value {
  font-size: 30rpx;
  color: #8e8e93;
  font-weight: 400;
}

.ios-chevron {
  font-size: 32rpx;
  color: #c7c7cc;
  margin-left: 4rpx;
}

.ios-color-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
}

/* iOS Toggle Switch */
.ios-toggle {
  width: 102rpx;
  height: 62rpx;
  background: #e5e5ea;
  border-radius: 31rpx;
  position: relative;
  transition: background 0.25s ease;
  cursor: pointer;
}

.ios-toggle.on {
  background: #34c759;
}

.ios-toggle-knob {
  width: 54rpx;
  height: 54rpx;
  background: #ffffff;
  border-radius: 27rpx;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.15), 0 1rpx 1rpx rgba(0, 0, 0, 0.16);
  transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.ios-toggle.on .ios-toggle-knob {
  transform: translateX(40rpx);
}

.ios-footer {
