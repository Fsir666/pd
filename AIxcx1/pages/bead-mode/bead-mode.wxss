.container {
  position: relative;
  width: 100%;
  height: 100vh;
  background-color: #f2f2f7;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
  overflow: hidden;
}

.header-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.98);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 12rpx;
  z-index: 1000;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
}

.header-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.back-button {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: rgba(0, 122, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.back-button:active {
  background-color: rgba(0, 122, 255, 0.2);
  transform: scale(0.96);
}

.back-icon {
  font-size: 32rpx;
  color: #007aff;
  font-weight: 600;
}

.coord-display {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding: 6rpx 12rpx;
  background: linear-gradient(135deg, rgba(0, 122, 255, 0.08) 0%, rgba(0, 86, 211, 0.05) 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 122, 255, 0.12);
  backdrop-filter: blur(8rpx);
}

.coord-label {
  font-size: 20rpx;
  color: #007aff;
  margin-right: 6rpx;
  font-weight: 600;
  opacity: 0.8;
}

.coord-value {
  font-size: 22rpx;
  color: #007aff;
  font-weight: 700;
  font-family: 'SF Mono', 'SFMono-Regular', 'Menlo', monospace;
  letter-spacing: 0.5rpx;
}

.header-center {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.header-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
}

.header-placeholder {
  width: 56rpx;
  height: 56rpx;
}

.x-axis {
  position: fixed;
  right: 0;
  height: 48px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(250, 250, 252, 0.95) 100%);
  backdrop-filter: blur(10px);
  z-index: 900;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  overflow: visible;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.x-axis-label {
  position: absolute;
  top: 50%;
  transform: translateX(-50%) translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  pointer-events: auto;
  cursor: pointer;
  padding: 8rpx;
  border-radius: 4rpx;
  transition: background-color 0.15s ease;
}

.x-axis-tick {
  width: 2rpx;
  height: 8rpx;
  background: #a1a1a6;
  margin-bottom: 4rpx;
}

.x-axis-tick.major {
  height: 20rpx;
  width: 2rpx;
  background: #636366;
}

.x-axis-tick.minor {
  height: 14rpx;
  width: 2rpx;
  background: #8e8e93;
}

.x-axis-tick.micro {
  height: 8rpx;
  width: 1rpx;
  background: #c7c7cc;
}

.axis-text {
  font-size: 20rpx;
  color: #1c1c1e;
  font-weight: 500;
  font-family: 'SF Mono', 'SFMono-Regular', 'Menlo', monospace;
  margin-top: 4rpx;
}

.axis-text.major {
  font-size: 24rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.axis-text.minor {
  font-size: 20rpx;
  font-weight: 600;
  color: #636366;
}

.axis-text.micro {
  font-size: 16rpx;
  font-weight: 400;
  color: #8e8e93;
}

.axis-text.highlighted {
  color: #007aff;
  font-weight: 700;
}

.x-axis-label, .y-axis-label {
  cursor: pointer;
  padding: 8rpx;
  border-radius: 4rpx;
  transition: background-color 0.15s ease;
}

.x-axis-label:active, .y-axis-label:active {
  background-color: rgba(0, 122, 255, 0.1);
}

/* 高亮样式选择器 */
.style-options {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx;
}

.style-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  background: #f2f2f7;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.style-option.selected {
  background: #e8f2ff;
  border-color: #007aff;
}

.style-preview {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
}

.style-preview-fill {
  background: rgba(0, 122, 255, 0.3);
  border: 2rpx solid transparent;
}

.style-preview-border {
  background: transparent;
  border: 4rpx solid #007aff;
}

.style-preview-both {
  background: rgba(0, 122, 255, 0.2);
  border: 4rpx solid #007aff;
}

.style-label {
  font-size: 28rpx;
  color: #1c1c1e;
  font-weight: 600;
}

/* iOS 滑块样式 */
.ios-slider {
  width: 200rpx;
}

.y-axis {
  position: fixed;
  left: 0;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.98) 0%, rgba(250, 250, 252, 0.95) 100%);
  backdrop-filter: blur(10px);
  z-index: 900;
  border-right: 1rpx solid rgba(0, 0, 0, 0.06);
  overflow: visible;
  box-shadow: 2rpx 0 8rpx rgba(0, 0, 0, 0.04);
}

.y-axis-label {
  position: absolute;
  left: 50%;
  transform: translateX(-50%) translateY(-50%);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  white-space: nowrap;
  pointer-events: auto;
  cursor: pointer;
  padding: 8rpx;
  border-radius: 4rpx;
  transition: background-color 0.15s ease;
}

.y-axis-tick {
  height: 2rpx;
  width: 8rpx;
  background: #a1a1a6;
  margin-right: 4rpx;
}

.y-axis-tick.major {
  width: 20rpx;
  height: 2rpx;
  background: #636366;
}

.y-axis-tick.minor {
  width: 14rpx;
  height: 2rpx;
  background: #8e8e93;
}

.y-axis-tick.micro {
  width: 8rpx;
  height: 1rpx;
  background: #c7c7cc;
}

.canvas-container {
  position: fixed;
  z-index: 0;
  background: #fafbfc;
}

.ui-overlay {
  position: relative;
  z-index: 999;
  pointer-events: none;
}

.toolbar-container {
  position: fixed;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1000;
  pointer-events: auto;
}

.water-drop-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  filter: drop-shadow(0 12rpx 40rpx rgba(0, 0, 0, 0.2));
}

.toggle-btn-top {
  width: 80rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-bottom: none;
  position: relative;
  z-index: 2;
  cursor: pointer;
  transition: transform 0.15s ease;
}

.toggle-btn-top:active {
  transform: scale(0.95);
}

.toggle-btn-top::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 20rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.25) 100%);
  border-radius: 0 0 14rpx 14rpx;
  box-shadow: inset 0 -1rpx 1rpx rgba(255, 255, 255, 0.2);
}

.toggle-arrow {
  font-size: 28rpx;
  color: #007aff;
  font-weight: 600;
  display: inline-block;
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.toggle-arrow.expanded {
  transform: rotate(180deg);
}

.toolbar-panel {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 36rpx;
  padding: 0 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  margin-top: 12rpx;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  width: 540rpx;
  transition: max-height 0.3s ease-out, opacity 0.2s ease-out;
}

.toolbar-panel.expanded {
  max-height: 400rpx;
  opacity: 1;
  padding: 20rpx 24rpx;
}

.toolbar-scroll {
  width: 100%;
  max-height: 400rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.toolbar-tools {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx;
}

.toolbar-tool {
  width: 100rpx;
  min-height: 100rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  padding: 12rpx 8rpx;
  opacity: 0;
  transition: opacity 0.15s ease;
}

.toolbar-panel.expanded .toolbar-tool {
  opacity: 1;
}

.toolbar-panel.expanded .toolbar-tool:nth-child(1) { transition-delay: 0.02s; }
.toolbar-panel.expanded .toolbar-tool:nth-child(2) { transition-delay: 0.04s; }
.toolbar-panel.expanded .toolbar-tool:nth-child(3) { transition-delay: 0.06s; }
.toolbar-panel.expanded .toolbar-tool:nth-child(4) { transition-delay: 0.08s; }
.toolbar-panel.expanded .toolbar-tool:nth-child(5) { transition-delay: 0.1s; }
.toolbar-panel.expanded .toolbar-tool:nth-child(6) { transition-delay: 0.12s; }
.toolbar-panel.expanded .toolbar-tool:nth-child(7) { transition-delay: 0.14s; }
.toolbar-panel.expanded .toolbar-tool:nth-child(8) { transition-delay: 0.16s; }

.tool-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.toolbar-tool:active {
  transform: scale(0.92);
}

.toolbar-tool.drop-target {
  background: rgba(0, 122, 255, 0.3);
  transform: scale(1.1);
  box-shadow: 0 0 0 3rpx rgba(0, 122, 255, 0.4);
}

.toolbar-tool.dragging {
  opacity: 0.3;
}

.toolbar-tool.active {
  background: rgba(0, 122, 255, 0.15);
  box-shadow: 0 0 0 2rpx rgba(0, 122, 255, 0.4);
  transform: scale(1.05);
}

.toolbar-tool.active .tool-icon {
  color: #007aff;
}

.toolbar-tool.active .tool-label {
  color: #007aff;
}

.toolbar-tool-color {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.tool-icon {
  width: 48rpx;
  height: 48rpx;
  color: #333;
}

.tool-label {
  font-size: 22rpx;
  color: #666;
  line-height: 1;
  margin-top: 4rpx;
}

.toolbar-tool.active .tool-label {
  color: #fff;
}

.toolbar-capsule {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 60rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  gap: 12rpx;
}

.quick-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s ease;
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  cursor: pointer;
}

.quick-btn:active {
  transform: scale(0.92);
}

.quick-btn.drop-target {
  background: linear-gradient(145deg, rgba(0, 122, 255, 0.7) 0%, rgba(0, 86, 211, 0.65) 50%, rgba(0, 75, 184, 0.6) 100%);
  transform: scale(1.18);
  box-shadow: 
    0 0 0 4rpx rgba(0, 122, 255, 0.4),
    0 8rpx 28rpx rgba(0, 122, 255, 0.4),
    inset 0 1rpx 1rpx rgba(255, 255, 255, 0.4);
  animation: pulse 0.6s ease infinite;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.quick-btn.drop-target::before {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.4) 0%, transparent 100%);
}

.quick-btn.dragging {
  opacity: 0.2;
  border: 2rpx dashed rgba(0, 122, 255, 0.5);
  background: transparent;
}

.quick-btn.active {
  background: rgba(0, 122, 255, 0.2);
  box-shadow: 0 0 0 2rpx rgba(0, 122, 255, 0.4);
  transform: scale(1.05);
}

.quick-btn-icon {
  width: 40rpx;
  height: 40rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.quick-btn-color {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  border: 3rpx solid rgba(255, 255, 255, 0.8);
}

.quick-btn-color-indicator {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.tooltip-wrapper {
  position: absolute;
  top: -60rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}

.tooltip-wrapper.tooltip-left {
  left: 10rpx;
}

.tooltip-wrapper.tooltip-center {
  left: 50%;
  transform: translateX(-50%);
}

.tooltip-wrapper.tooltip-right {
  right: 10rpx;
}

.tooltip {
  background: rgba(0, 0, 0, 0.75);
  color: #ffffff;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.tooltip-wrapper .tooltip.show {
  opacity: 1;
}

.tooltip-wrapper.tooltip-left .tooltip::after,
.tooltip-wrapper.tooltip-right .tooltip::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid rgba(0, 0, 0, 0.75);
}

.tooltip-wrapper.tooltip-left .tooltip::after {
  left: 24rpx;
}

.tooltip-wrapper.tooltip-right .tooltip::after {
  right: 24rpx;
}

.dragging-indicator {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 9999;
}

.dragging-tool {
  position: fixed;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8f8fa 50%, #f0f0f2 100%);
  box-shadow: 
    0 20rpx 60rpx rgba(0, 0, 0, 0.35),
    0 8rpx 24rpx rgba(0, 0, 0, 0.2),
    0 0 0 4rpx rgba(0, 122, 255, 0.4),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: scale(1.35);
  animation: floatBounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  backdrop-filter: blur(10rpx);
}

.dragging-tool::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.7) 0%, transparent 100%);
  border-radius: 48rpx 48rpx 0 0;
  pointer-events: none;
}

@keyframes floatBounce {
  0% { transform: scale(1); }
  50% { transform: scale(1.4); }
  100% { transform: scale(1.3); }
}

.dragging-icon {
  font-size: 52rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.15));
}

.color-palette-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: maskFadeIn 0.25s ease;
}

@keyframes maskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.color-palette {
  width: 92%;
  max-width: 1200rpx;
  height: 72vh;
  background: linear-gradient(135deg, #f8f8fa 0%, #ffffff 100%);
  border-radius: 48rpx;
  display: flex;
  flex-direction: column;
  animation: popIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 24rpx 96rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

@keyframes popIn {
  from {
    transform: scale(0.9);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

/* ==================== SVG图标样式 - 统一填充彩色风格 ==================== */

/* 图标基础样式 */
.icon-brush,
.icon-eraser,
.icon-palette,
.icon-magic,
.icon-export,
.icon-undo,
.icon-redo,
.icon-zoom-in,
.icon-zoom-out,
.icon-origin,
.icon-settings {
  display: inline-block;
  width: 48rpx;
  height: 48rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* ==================== SVG图标样式 - 统一淡色系风格 ==================== */

/* 图标基础样式 */
.icon-brush,
.icon-eraser,
.icon-palette,
.icon-magic,
.icon-undo,
.icon-redo,
.icon-zoom-in,
.icon-zoom-out,
.icon-origin,
.icon-settings {
  display: inline-block;
  width: 48rpx;
  height: 48rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* 1. 画笔 - 精致画笔造型 */
