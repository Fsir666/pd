/* ==================== 画笔预览区样式 ==================== */

.brush-preview-container {
  position: fixed;
  bottom: 20rpx;
  left: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  z-index: 1200;
}

.brush-preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.brush-preview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.brush-preview-item {
  width: 100rpx;
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 12rpx;
  transition: all 0.2s ease;
}

.brush-preview-item:active {
  transform: scale(0.95);
  background: #e8e8e8;
}

.brush-preview-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.brush-preview-label {
  font-size: 20rpx;
  color: #666;
}

/* ==================== 滑动条样式 ==================== */

.grid-size-slider-section {
  padding: 16rpx 0;
}

.slider-row {
  margin-bottom: 32rpx;
}

.slider-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.slider-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.slider-value {
  font-size: 28rpx;
  color: #007aff;
  font-weight: 600;
  min-width: 80rpx;
  text-align: right;
}

.grid-slider {
  width: 100%;
  margin: 0;
}

.slider-scale {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 0 10rpx;
}

.scale-mark {
  font-size: 20rpx;
  color: #999;
}

/* 尺寸预览 */
.grid-size-display {
  display: flex;
  justify-content: center;
  margin: 32rpx 0;
}

.size-preview-box {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  min-height: 80rpx;
  max-width: 200rpx;
  max-height: 150rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.size-preview-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 快捷预设 */
.preset-sizes {
  margin-top: 24rpx;
}

.preset-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.preset-buttons {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.preset-btn {
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.2s ease;
}

.preset-btn.active {
  background: #007aff;
  color: #fff;
  border-color: #007aff;
}

.preset-btn:active {
  transform: scale(0.95);
}

/* 循环间隔设置 */
.cycle-interval-setting {
  padding: 16rpx 0;
}

.cycle-interval-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.cycle-interval-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.cycle-interval-value {
  font-size: 28rpx;
  color: #007aff;
  font-weight: 600;
}

.cycle-interval-slider {
  margin-bottom: 16rpx;
}

.cycle-preset-buttons {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.cycle-interval-tips {
  padding: 16rpx;
  background: #f0f7ff;
  border-radius: 12rpx;
}

.cycle-tip {
  font-size: 24rpx;
  color: #007aff;
}

