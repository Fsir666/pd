  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx;
}

.placeholder-icon {
  font-size: 80rpx;
  opacity: 0.6;
}

.placeholder-text {
  font-size: 28rpx;
  color: #8e8e93;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
  text-align: center;
}

.image-info {
  margin-top: 16rpx;
  text-align: center;
  padding: 16rpx 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.info-text {
  font-size: 24rpx;
  color: #8e8e93;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
}

.brand-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  border: 1rpx solid #e5e5ea;
  transition: all 0.2s ease;
  box-sizing: border-box;
  width: 100%;
  min-height: 80rpx;
}

.brand-picker:active {
  background: #f2f2f7;
}

.brand-name {
  font-size: 28rpx;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
}

.picker-arrow {
  font-size: 32rpx;
  color: #c7c7cc;
  font-weight: 300;
}

.size-slider-container {
  padding: 24rpx 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  border: 1rpx solid #e5e5ea;
  box-sizing: border-box;
  width: 100%;
  min-height: 100rpx;
}

.size-label {
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 16rpx;
  display: block;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
}

.size-slider {
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.size-slider-container {
  overflow: visible !important;
}

.preview-size {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  background: linear-gradient(135deg, rgba(0, 122, 255, 0.1) 0%, rgba(0, 122, 255, 0.05) 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 122, 255, 0.2);
  margin-top: 16rpx;
}

.size-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #007aff;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
}

.process-progress {
  width: 100%;
  margin-top: 20rpx;
  height: 10rpx;
}

.import-footer {
  display: flex;
  padding: 24rpx 36rpx 32rpx;
  gap: 20rpx;
  border-top: 1rpx solid #e5e5ea;
  background: #f8f8f8;
}

.import-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.import-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.2);
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.import-btn:active::before {
  transform: translateY(0);
}

.cancel-btn {
  background: #f2f2f7;
  color: #8e8e93;
  border: 1rpx solid #e5e5ea;
}

.cancel-btn:active {
  background: #e5e5ea;
}

.confirm-btn {
  background: linear-gradient(135deg, #007aff 0%, #0056b3 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
}

.confirm-btn:active {
  background: linear-gradient(135deg, #0056b3 0%, #004085 100%);
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.2);
}

.confirm-btn.disabled {
  background: #c7c7cc;
  box-shadow: none;
  cursor: not-allowed;
}

.confirm-btn.disabled:active {
  transform: none;
  background: #c7c7cc;
}

/* 工具栏图标 - 图片 */
.icon-image {
  width: 44rpx;
  height: 44rpx;
  display: inline-block;
  position: relative;
}

.icon-image::before {
  content: '🖼️';
  font-size: 36rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 选区操作菜单 */
.selection-menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4rpx);
}

.selection-menu {
  position: fixed;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
  min-width: 200rpx;
  animation: menuFadeIn 0.2s ease-out;
}

@keyframes menuFadeIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.selection-menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  transition: background 0.2s ease;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.selection-menu-item:last-child {
  border-bottom: none;
}

.selection-menu-item:active {
  background: rgba(0, 122, 255, 0.1);
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #1c1c1e;
  font-weight: 500;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
}

@media (prefers-color-scheme: dark) {
  .selection-menu {
    background: rgba(44, 44, 46, 0.98);
  }
  
  .selection-menu-item {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
  
  .selection-menu-item:active {
    background: rgba(0, 122, 255, 0.2);
  }
  
  .menu-text {
    color: #f2f2f7;
  }
}

/* 导出弹窗样式 */
.export-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}

.export-modal {
  width: 90%;
  max-width: 680rpx;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: exportModalFadeIn 0.3s ease-out;
}

@keyframes exportModalFadeIn {
  from {
    opacity: 0;
    transform: scale(0.95) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.export-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
}

.export-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
}

.export-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8e8e93;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
}

.export-close:active {
  background: rgba(0, 0, 0, 0.1);
}

.export-content {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
}

.export-preview-section {
  margin-bottom: 32rpx;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.preview-zoom-controls {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.zoom-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2f2f7;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: #007AFF;
  font-weight: 500;
}

.zoom-btn:active {
  background: #e5e5ea;
}

.zoom-btn.reset-btn {
  width: auto;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.zoom-scale {
  font-size: 24rpx;
  color: #8e8e93;
  min-width: 80rpx;
  text-align: center;
}

.preview-container {
  width: 100%;
  height: 500rpx;
  background: #f2f2f7;
  border-radius: 16rpx;
  overflow: hidden;
}

.preview-scroll-content {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  padding: 20rpx;
}

.preview-image {
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.preview-placeholder {
  color: #8e8e93;
  font-size: 28rpx;
}

.export-tools-section {
  background: #f2f2f7;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.tool-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 32rpx;
  border-radius: 12rpx;
  background: #ffffff;
  transition: all 0.2s ease;
}

.tool-item.active {
  background: #007AFF;
}

.tool-item.active .tool-icon,
.tool-item.active .tool-label {
  color: #ffffff;
}

.tool-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
  color: #1c1c1e;
}

.tool-label {
  font-size: 24rpx;
  color: #8e8e93;
}

.font-size-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.font-size-label {
  font-size: 26rpx;
  color: #8e8e93;
}

.font-size-options {
  display: flex;
  gap: 12rpx;
}

.font-size-chip {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #ffffff;
  color: #8e8e93;
  transition: all 0.2s ease;
}

.font-size-chip.active {
  background: #007AFF;
  color: #ffffff;
}

.aux-grid-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.aux-label {
  font-size: 26rpx;
  color: #8e8e93;
}

.aux-options {
  display: flex;
  gap: 12rpx;
}

.aux-chip {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #ffffff;
  color: #8e8e93;
  transition: all 0.2s ease;
}

.aux-chip.active {
  background: #007AFF;
  color: #ffffff;
}

.export-stats-section {
  background: #f2f2f7;
  border-radius: 16rpx;
  padding: 24rpx;
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.stats-total {
  font-size: 24rpx;
  color: #8e8e93;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stats-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 16rpx;
  border-radius: 12rpx;
  min-width: calc(50% - 8rpx);
}

.stats-color-block {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
}

.stats-info {
  flex: 1;
}

.stats-count {
  font-size: 24rpx;
  color: #1c1c1e;
  font-weight: 500;
}

.stats-brand {
  font-size: 20rpx;
  color: #007AFF;
  margin-top: 4rpx;
}

.stats-hex {
  font-size: 18rpx;
  color: #8e8e93;
  margin-top: 2rpx;
  font-family: 'SF Mono', 'Monaco', monospace;
}

.export-footer {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  background: #ffffff;
}

.export-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.cancel-btn {
  background: #f2f2f7;
  color: #8e8e93;
}

.cancel-btn:active {
  background: #e5e5ea;
}

.confirm-btn {
  background: #007AFF;
  color: #ffffff;
}

.confirm-btn:active {
  background: #0051D5;
}

.confirm-btn.disabled {
  background: #c7c7cc;
  color: #ffffff;
}

/* 发布弹窗样式 */
.publish-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease, background 0.3s ease;
}

.publish-modal.show {
  opacity: 1;
  pointer-events: auto;
  background: rgba(0, 0, 0, 0.5);
}

.publish-content {
  width: 90%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  transform: scale(0.9);
  transition: transform 0.3s ease;
}

.publish-modal.show .publish-content {
  transform: scale(1);
}

.publish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
}

.publish-header .publish-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.publish-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #8e8e93;
}

.publish-preview {
  width: 100%;
  height: 300rpx;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.publish-preview-img {
  width: 100%;
  height: 100%;
}

.publish-preview-placeholder {
  color: #8e8e93;
  font-size: 28rpx;
}

.publish-form {
  padding: 24rpx 32rpx;
}

.publish-field {
  margin-bottom: 24rpx;
}

.publish-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 12rpx;
}

.publish-label .required {
  color: #ff3b30;
}

.publish-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f2f2f7;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1c1c1e;
  box-sizing: border-box;
}

.publish-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  background: #f2f2f7;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1c1c1e;
  box-sizing: border-box;
}

.publish-switch-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.publish-switch-field .publish-label {
  margin-bottom: 0;
}

.publish-actions {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}

.publish-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

@media (prefers-color-scheme: dark) {
  .export-modal {
    background: #2c2c2e;
  }
  
  .export-header {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
  
  .export-title {
    color: #f2f2f7;
  }
  
  .export-close {
    background: rgba(255, 255, 255, 0.1);
    color: #8e8e93;
  }
  
  .preview-container {
    background: #3a3a3c;
  }
  
  .export-tools-section,
  .export-stats-section {
    background: #3a3a3c;
  }
  
  .tool-item {
    background: #2c2c2e;
  }
  
  .tool-icon {
    color: #f2f2f7;
  }
  
  .tool-label {
    color: #8e8e93;
  }
  
  .aux-grid-section {
    border-top-color: rgba(255, 255, 255, 0.1);
  }
  
  .aux-chip {
    background: #2c2c2e;
    color: #8e8e93;
  }
  
  .stats-item {
    background: #2c2c2e;
  }
  
  .stats-count {
    color: #f2f2f7;
  }
  
  .export-footer {
    border-top-color: rgba(255, 255, 255, 0.1);
    background: #2c2c2e;
  }
  
  .cancel-btn {
    background: #3a3a3c;
    color: #8e8e93;
  }
}
