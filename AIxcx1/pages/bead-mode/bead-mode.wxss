}

/* 画笔形状选项 */
.brush-shape-options {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.brush-shape-option {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.brush-shape-option.active {
  background: rgba(0, 122, 255, 0.15);
  border-color: #007aff;
}

.brush-shape-option:active {
  transform: scale(0.92);
}

.brush-shape-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #f2f2f7;
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
  min-width: 100rpx;
}

.brush-shape-option.active {
  background: rgba(0, 122, 255, 0.15);
  border-color: #007aff;
}

.brush-shape-option:active {
  transform: scale(0.96);
}

.brush-shape-preview {
  background-color: #007aff;
}

.brush-shape-preview.shape-square {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
}

.brush-shape-preview.shape-cross {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.brush-shape-preview.shape-cross::before,
.brush-shape-preview.shape-cross::after {
  content: '';
  position: absolute;
  background-color: #007aff;
}

.brush-shape-preview.shape-cross::before {
  width: 40rpx;
  height: 8rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.brush-shape-preview.shape-cross::after {
  width: 8rpx;
  height: 40rpx;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

.brush-shape-label {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

.brush-shape-option.active .brush-shape-label {
  color: #007aff;
