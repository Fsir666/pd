.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx;
  box-sizing: border-box;
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  text-align: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 18rpx 0;
  font-weight: 700;
  color: #8E8E93;
  border: 1rpx solid rgba(0,0,0,0.05);
}
.tab.active {
  color: #1C1C1E;
  border-color: #FF6B00;
}

.list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-top: 1rpx solid rgba(0,0,0,0.05);
}
.row:first-child { border-top: none; }

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: rgba(17,17,20,0.06);
}

.main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.name {
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(29,29,31,0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sub {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(29,29,31,0.6);
}
.bio {
  font-size: 24rpx;
  color: rgba(29,29,31,0.52);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chevron {
  font-size: 48rpx;
  color: rgba(29,29,31,0.38);
}

.empty {
  padding: 60rpx;
  text-align: center;
  color: rgba(29,29,31,0.6);
}
.loading, .more {
  padding: 30rpx;
  text-align: center;
  color: rgba(29,29,31,0.6);
}
