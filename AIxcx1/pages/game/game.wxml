<view class="page-root">
  <view class="paper-bg"></view>
  <view class="topbar glass-card">
    <view class="topbar-left">
      <text class="topbar-title">拼豆板</text>
      <view class="topbar-chip">{{gridSize}}×{{gridSize}}</view>
    </view>
    <view class="topbar-actions">
      <button class="topbar-btn ghost" bindtap="onChooseImage">上传</button>
      <button class="topbar-btn" bindtap="onOpenSettings">设置</button>
    </view>
  </view>

  <view class="board-shell glass-card">
    <view class="board-wrap" style="width:{{boardSize + (showRuler ? rulerSize : 0)}}px;height:{{boardSize + (showRuler ? rulerSize : 0)}}px;">
      <view class="ruler-corner" style="width:{{showRuler ? rulerSize : 0}}px;height:{{showRuler ? rulerSize : 0}}px;opacity:{{showRuler ? 1 : 0}};">0</view>
      <canvas
        type="2d"
        id="xRulerCanvas"
        class="ruler-x"
        style="left:{{showRuler ? rulerSize : 0}}px;top:0;width:{{boardSize}}px;height:{{showRuler ? rulerSize : 0}}px;opacity:{{showRuler ? 1 : 0}};"
      ></canvas>
      <canvas
        type="2d"
        id="yRulerCanvas"
        class="ruler-y"
        style="left:0;top:{{showRuler ? rulerSize : 0}}px;width:{{showRuler ? rulerSize : 0}}px;height:{{boardSize}}px;opacity:{{showRuler ? 1 : 0}};"
      ></canvas>
      <view
        id="viewport"
        class="viewport"
        style="left:{{showRuler ? rulerSize : 0}}px;top:{{showRuler ? rulerSize : 0}}px;width:{{boardSize}}px;height:{{boardSize}}px;"
        bindtouchstart="onTouchStart"
        catchtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        bindtouchcancel="onTouchEnd"
      >
        <view class="board-zoom" style="transform: translate3d({{viewX}}px,{{viewY}}px,0) scale({{viewScale}});">
          <canvas
            type="2d"
            id="boardCanvas"
            class="board-canvas"
            style="width:{{boardSize}}px;height:{{boardSize}}px;"
          ></canvas>
        </view>
      </view>
    </view>
  </view>

  <view class="stats-shell glass-card">
    <view class="stats-header">
      <view class="stats-title-wrap">
        <text class="stats-title">用色清单</text>
        <text class="stats-sub">{{selectedBrand}}</text>
      </view>
      <text class="stats-summary">{{statsTotalColors}}色 / {{statsTotalBeads}}颗</text>
    </view>

    <view class="sort-tabs">
      <view class="sort-chip {{statsSort==='count'?'active':''}}" bindtap="onStatsSortTap" data-sort="count">按数量</view>
      <view class="sort-chip {{statsSort==='code'?'active':''}}" bindtap="onStatsSortTap" data-sort="code">按色号</view>
    </view>

    <scroll-view scroll-y class="stats-list" show-scrollbar="{{false}}">
      <view class="stats-grid">
        <view class="stats-card" wx:for="{{statsList}}" wx:key="key">
          <view class="stats-swatch" style="background-color: {{item.hex}}"></view>
          <view class="stats-main">
            <text class="stats-code">{{item.code}}</text>
            <text class="stats-hex">{{item.hex}}</text>
          </view>
          <view class="stats-pill">{{item.count}}颗</view>
        </view>
      </view>
      <view class="stats-empty" wx:if="{{!statsList.length}}">上传图片后生成用色清单</view>
      <view class="stats-bottom-pad"></view>
    </scroll-view>
  </view>

  <view class="fab-bar glass-card">
    <view class="fab-left">
      <text class="fab-title">{{canEnterBeadMode ? '开始拼豆' : '还差一步'}}</text>
      <text class="fab-desc">{{canEnterBeadMode ? '横屏模式更顺手，支持放大与拖动' : '先上传图片生成拼豆板，再开始拼豆'}}</text>
    </view>
    <button class="fab-btn" bindtap="onEnterBeadMode" disabled="{{!canEnterBeadMode}}">
      {{canEnterBeadMode ? '进入拼豆模式' : '先上传图片'}}
    </button>
  </view>

  <view class="settings-mask" wx:if="{{showSettings}}" bindtap="onCloseSettings">
    <view class="settings-sheet" catchtap="true">
      <view class="sheet-header">
        <text class="sheet-title">网格数量</text>
        <text class="sheet-value">{{pendingGridSize}}×{{pendingGridSize}}</text>
      </view>

      <slider
        class="grid-slider"
        min="16"
        max="128"
        step="1"
        value="{{pendingGridSize}}"
        activeColor="#FF6A00"
        bindchanging="onGridChanging"
        bindchange="onGridChange"
      />

      <view class="grid-quick">
        <view class="quick-btn {{pendingGridSize===16?'active':''}}" bindtap="onPickGrid" data-size="16">16</view>
        <view class="quick-btn {{pendingGridSize===32?'active':''}}" bindtap="onPickGrid" data-size="32">32</view>
        <view class="quick-btn {{pendingGridSize===64?'active':''}}" bindtap="onPickGrid" data-size="64">64</view>
        <view class="quick-btn {{pendingGridSize===96?'active':''}}" bindtap="onPickGrid" data-size="96">96</view>
        <view class="quick-btn {{pendingGridSize===128?'active':''}}" bindtap="onPickGrid" data-size="128">128</view>
      </view>

      <view class="sheet-section">
        <view class="section-header">
          <text class="section-title">风格</text>
        </view>
        <view class="segmented-control">
          <view class="segment-item {{presetKey === 'auto' ? 'active' : ''}}" bindtap="onPresetTap" data-preset="auto">推荐</view>
          <view class="segment-item {{presetKey === 'clear' ? 'active' : ''}}" bindtap="onPresetTap" data-preset="clear">清晰</view>
          <view class="segment-item {{presetKey === 'real' ? 'active' : ''}}" bindtap="onPresetTap" data-preset="real">真实</view>
          <view class="segment-item {{presetKey === 'pixel' ? 'active' : ''}}" bindtap="onPresetTap" data-preset="pixel">像素图</view>
        </view>
      </view>

      <view>
        <view class="sheet-section">
          <view class="section-header">
            <text class="section-title">取样模式</text>
          </view>
          <view class="segmented-control">
            <view class="segment-item {{sampleMode === 'auto' ? 'active' : ''}}" bindtap="onSetSampleMode" data-mode="auto">自动</view>
            <view class="segment-item {{sampleMode === 'photo' ? 'active' : ''}}" bindtap="onSetSampleMode" data-mode="photo">照片</view>
            <view class="segment-item {{sampleMode === 'pixel' ? 'active' : ''}}" bindtap="onSetSampleMode" data-mode="pixel">像素图</view>
          </view>
        </view>

        <view class="sheet-section">
          <view class="section-header">
            <text class="section-title">颗粒感</text>
            <text class="section-value">{{ditherValue}}%</text>
          </view>
          <slider min="0" max="80" step="5" value="{{ditherValue}}" activeColor="#FF6A00" bindchange="onDitherChange" bindchanging="onDitherChanging"/>
        </view>

        <view class="sheet-section">
          <view class="section-header">
            <text class="section-title">更清晰</text>
            <text class="section-value">{{detailValue}}%</text>
          </view>
          <slider min="0" max="60" step="5" value="{{detailValue}}" activeColor="#FF6A00" bindchange="onDetailChange" bindchanging="onDetailChanging"/>
        </view>

        <view class="sheet-section" wx:if="{{showGrid}}">
          <view class="section-header">
            <text class="section-title">辅助网格</text>
          </view>
          <view class="segmented-control">
            <view class="segment-item {{auxGridIndex === 0 ? 'active' : ''}}" bindtap="onSetAuxGrid" data-index="0">关闭</view>
            <view class="segment-item {{auxGridIndex === 1 ? 'active' : ''}}" bindtap="onSetAuxGrid" data-index="1">5格</view>
            <view class="segment-item {{auxGridIndex === 2 ? 'active' : ''}}" bindtap="onSetAuxGrid" data-index="2">10格</view>
          </view>
        </view>
      </view>

      <view class="sheet-toggles">
        <view class="toggle-row">
          <text class="toggle-label">显示网格线</text>
          <switch checked="{{showGrid}}" color="#FF6A00" bindchange="onToggleGrid" />
        </view>
        <view class="toggle-row">
          <text class="toggle-label">标尺</text>
          <switch checked="{{showRuler}}" color="#FF6A00" bindchange="onToggleRuler" />
        </view>
        <view class="toggle-row">
          <text class="toggle-label">显示格内色号</text>
          <switch checked="{{showCellCodes}}" color="#FF6A00" bindchange="onToggleCellCodes" />
        </view>
      </view>

      <view class="sheet-section">
        <view class="section-header">
          <text class="section-title">品牌色号</text>
          <text class="section-value">{{selectedBrand}}</text>
        </view>
        <scroll-view scroll-x class="sheet-brand-tabs" show-scrollbar="{{false}}">
          <view class="brand-tabs-inner">
            <view class="brand-chip {{selectedBrand === item.key ? 'active' : ''}}" wx:for="{{brandOptions}}" wx:key="key" bindtap="onBrandTap" data-brand="{{item.key}}">
              <text>{{item.label}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="sheet-actions">
        <button class="sheet-btn secondary" bindtap="onCloseSettings">取消</button>
        <button class="sheet-btn primary" bindtap="onApplyGrid">应用</button>
      </view>
    </view>
  </view>

  <canvas type="2d" id="pixelCanvas" class="pixel-canvas" style="width:{{gridSize}}px;height:{{gridSize}}px;"></canvas>
</view>
