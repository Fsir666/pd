.container {
  background-color: #f8f8f8;
  min-height: 100vh;
}

/* 1. 顶部大图与视差 */
.hero-image {
  width: 100%;
  height: 65vh;
  display: block;
  will-change: transform;
}

.back-btn {
  position: fixed;
  left: 30rpx;
  width: 70rpx;
  height: 70rpx;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(10px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.back-icon {
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
}

/* 2. 内容卡片 */
.content-card {
  position: relative;
  margin-top: -60rpx;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx;
  min-height: 40vh;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 24rpx;
  color: #999;
  background: #f0f0f0;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  margin-right: 15rpx;
}

.primary-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 26rpx;
}

.primary-btn {
  flex: 1;
  height: 86rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}

.primary-remix {
  background: linear-gradient(135deg, #ff8c42, #ff6b00);
  color: #fff;
  box-shadow: 0 10rpx 26rpx rgba(255, 107, 0, 0.22);
}

.primary-copy {
  background: rgba(17, 17, 20, 0.06);
  color: rgba(29, 29, 31, 0.86);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.primary-btn:active {
  transform: scale(0.98);
  opacity: 0.95;
}

/* 作者信息 */
.author-info {
  display: flex;
  align-items: flex-start; /* 改为顶部对齐，适应多行内容 */
  padding: 20rpx 0;
  margin-bottom: 30rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #eee;
  flex-shrink: 0;
}

.author-meta {
  flex: 1;
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
}

.author-subrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.follower-text {
  font-size: 24rpx;
  color: rgba(29, 29, 31, 0.58);
  font-weight: 600;
}

.follow-btn {
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  background: rgba(17, 17, 20, 0.06);
  color: rgba(29, 29, 31, 0.78);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.follow-btn.following {
  background: rgba(255, 107, 0, 0.10);
  color: #ff6b00;
  border-color: rgba(255, 107, 0, 0.18);
}

.follow-btn.disabled {
  opacity: 0.6;
}

.follow-btn:active {
  transform: scale(0.96);
}

/* 作者栏操作按钮 */
.author-actions {
  display: flex;
  gap: 20rpx;
}

.action-pill {
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
  transition: all 0.2s;
}

.action-pill:active {
  transform: scale(0.95);
  background: #ebebeb;
}

.action-pill.active {
  background: #fff0f0; /* 激活态浅红背景 */
}

.collect-pill.active {
  background: #fff8e1; /* 收藏激活态浅黄背景 */
}

.action-pill .icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.action-pill .count, 
.action-pill .label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.like-pill.active .count {
  color: #ff4d4f;
}

.collect-pill.active .label {
  color: #ffc107;
}

.description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 40rpx;
  text-align: justify;
}

.recommend-section {
  padding-top: 30rpx;
}

.recommend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.recommend-scroll {
  width: 100%;
  white-space: nowrap;
}

.recommend-row {
  display: inline-flex;
  gap: 20rpx;
  padding-bottom: 10rpx;
}

.recommend-card {
  display: inline-block;
  width: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.recommend-img {
  width: 280rpx;
  height: 280rpx;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  display: block;
}

.recommend-meta {
  padding: 16rpx 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recommend-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1c1e;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.3;
  white-space: normal;
}

.recommend-sub {
  font-size: 24rpx;
  color: #8e8e93;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 4. 评论区 */
.section-container {
  margin-bottom: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f2f2f2;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.comment-tabs {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.tab {
  font-size: 26rpx;
  color: #999;
}

.tab.active {
  color: #333;
  font-weight: 600;
}

.divider {
  color: #eee;
  font-size: 20rpx;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.comment-item {
  display: flex;
  gap: 20rpx;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eee;
}

.comment-main {
  flex: 1;
}

.comment-user-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.user-nickname {
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
}

.comment-time {
  font-size: 22rpx;
  color: #ccc;
}

.comment-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.5;
  margin-bottom: 15rpx;
}

.comment-img {
  width: 240rpx;
  border-radius: 12rpx;
  display: block;
}

.footer-spacing {
  height: 250rpx;
}

/* 粒子特效 */
.particle-system {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 300;
  overflow: hidden;
}

.particle {
  position: absolute;
  font-size: 48rpx;
  /* 使用 CSS 变量控制持续时间，默认 1s */
  animation: gravity var(--duration, 1s) ease-out forwards;
  pointer-events: none;
}

@keyframes gravity {
  0% {
    /* 初始状态：原点，透明度0，无旋转 */
    transform: translate(0, 0) scale(0.5) rotate(0deg);
    opacity: 0;
  }
  10% {
    /* 快速出现，开始起跳 */
    opacity: 1;
  }
  40% {
    /* 到达最高点：X轴偏移，Y轴高度由变量控制，旋转完成约 40% */
    transform: translate(var(--tx, 0), var(--ty, -180rpx)) scale(1.2) rotate(calc(var(--rot) * 0.4));
    opacity: 1;
  }
  100% {
    /* 落地：大幅度下落，完全旋转 */
    transform: translate(calc(var(--tx, 0) * 2), 1500rpx) scale(1) rotate(var(--rot));
    opacity: 1; /* 保持不透明，直到掉出屏幕 */
  }
}

/* 5. 底部固定栏 (Glass Style) */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  width: 100%;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  z-index: 200;
}

/* 图片预览条 */
.image-preview-bar {
  padding: 20rpx 30rpx 0;
}

.preview-wrapper {
  position: relative;
  width: 100rpx;
  height: 100rpx;
}

.preview-thumb {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
}

.delete-btn {
  position: absolute;
  top: -15rpx;
  right: -15rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 输入行 */
.input-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  background: #fff;
}

.input-container {
  flex: 1;
  height: 80rpx;
  background: #f5f5f7;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
}

.main-input {
  flex: 1;
  font-size: 28rpx;
  color: #1c1c1e;
}

.camera-btn {
  padding-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-btn .icon {
  font-size: 36rpx;
}

.send-btn-inline {
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #007AFF, #0055D5);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
  transition: all 0.2s ease;
}

.send-btn-inline:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.3);
}

.send-btn-inline .send-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1;
}

/* 右侧工具栏 */
.toolbar-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f7;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.action-btn .icon {
  font-size: 32rpx;
  line-height: 1;
}

.action-btn.liked {
  background: rgba(255, 59, 48, 0.1);
}

.action-btn.collected {
  background: rgba(255, 204, 0, 0.15);
}

.action-btn:active {
  transform: scale(0.92);
  background: #e8e8ed;
}

button.action-btn.share-action {
  margin: 0;
  padding: 0;
  border: none;
  background: #f5f5f7;
  line-height: 1;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-sizing: border-box;
}

button.action-btn.share-action::after {
  border: none;
}

button.action-btn.share-action:active {
  transform: scale(0.92);
  background: #e8e8ed;
}

button.action-btn.share-action:active {
  transform: scale(0.92);
  background: #e8e8ed;
}

/* 安全区域 */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
  background: transparent;
}
