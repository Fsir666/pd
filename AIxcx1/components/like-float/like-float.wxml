<view class="like-float-root">
  <view wx:if="{{showParticles}}" id="particleLayer" class="particle-layer" pointer-events="none">
    <view wx:for="{{particleList}}" wx:key="id" class="particle" style="{{item.style}}">{{item.emoji}}</view>
  </view>
  <view id="likeButton" class="like-btn" bindtap="onTapLike">
    <view class="like-main">
      <text class="like-icon">👍</text>
      <text class="like-text">点赞</text>
    </view>
    <view class="like-count-badge {{bump ? 'bump' : ''}}">{{countText}}</view>
  </view>
</view>
