{
  "pages": [
    "pages/index/index",
    "pages/mall/mall",
    "pages/square/square",
    "pages/profile/profile",
    "pages/detail/detail",
    "pages/patterns/patterns",
    "pages/pattern-detail/pattern-detail",
    "pages/search/search",
    "pages/template-detail/template-detail",
    "pages/my-collections/my-collections",
    "pages/my-works/my-works"
  ],
  "subPackages": [
    {
      "root": "packageTool",
      "name": "tool",
      "pages": [
        "pages/generate/generate",
        "pages/matting/matting",
        "pages/cartoon/cartoon",
        "pages/cartoon-generate/cartoon-generate",
        "pages/all-tools/all-tools",
        "pages/color-chart/color-chart",
        "pages/color-list/color-list",
        "pages/brand-detail/brand-detail"
      ]
    },
    {
      "root": "packageGame",
      "name": "game",
      "pages": [
        "pages/game/game",
        "pages/bead-mode/bead-mode"
      ]
    },
    {
      "root": "packageWarehouse",
      "name": "warehouse",
      "pages": [
        "pages/warehouse/warehouse",
        "pages/warehouse/manage/manage"
      ]
    },
    {
      "root": "packageMisc",
      "name": "misc",
      "pages": [
        "pages/changelog/changelog",
        "pages/follow-list/follow-list",
        "pages/user-profile/user-profile",
        "pages/developer/developer",
        "pages/developer/add-template/add-template",
        "pages/my-orders/my-orders",
        "pages/contact/contact",
        "pages/beginner-guide/beginner-guide"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["tool", "game"]
    },
    "pages/mall/mall": {
      "network": "all",
      "packages": ["tool"]
    },
    "pages/square/square": {
      "network": "all",
      "packages": ["game"]
    },
    "pages/profile/profile": {
      "network": "all",
      "packages": ["misc", "warehouse"]
    }
  },
  "usingComponents": {
    "like-float": "/components/like-float/like-float"
  },
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTitleText": "拼豆",
    "navigationBarTextStyle": "black"
  },
  "tabBar": {
    "custom": true,
    "color": "#999999",
    "selectedColor": "#FF6B00",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "images/tab_home.png",
        "selectedIconPath": "images/tab_home_active.png"
      },
      {
        "pagePath": "pages/mall/mall",
        "text": "发现",
        "iconPath": "images/tab_mall.png",
        "selectedIconPath": "images/tab_mall_active.png"
      },
      {
        "pagePath": "pages/square/square",
        "text": "广场",
        "iconPath": "images/tab_game.png",
        "selectedIconPath": "images/tab_game_active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "images/tab_me.png",
        "selectedIconPath": "images/tab_me_active.png"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "permission": {
    "scope.writePhotosAlbum": {
      "desc": "用于保存导出的图纸图片到相册"
    }
  },
  "networkTimeout": {
    "request": 120000,
    "connectSocket": 60000,
    "uploadFile": 60000,
    "downloadFile": 60000
  },
  "__usePrivacyCheck__": true
}
